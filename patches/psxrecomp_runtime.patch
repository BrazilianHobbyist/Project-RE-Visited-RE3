+/* ---- 3D Actor Vertical Centroid Tracking (Pan & Scan) ---- */
+static uint64_t s_actor_prim_count = 0;
+static int64_t  s_actor_y_sum = 0;
+static int32_t  s_actor_y_min = 9999;
+static int32_t  s_actor_y_max = -9999;
+static int      s_gameplay_latch = 0;
+static int      s_last_valid_centroid = 120;
+static int      s_msg_box_countdown = 0;
+static uint8_t  s_gpu_last_room = 0xFF;
