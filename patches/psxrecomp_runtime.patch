+static const char* re3_get_item_name(uint8_t id) {
+    switch (id) {
+        case 0x01: return "Combat Knife";
+        case 0x02: return "Merc's Handgun (Eagle)";
+        case 0x03: return "Handgun (M92F)";
+        case 0x04: return "Shotgun (M3S)";
+        case 0x05: return "Magnum (M629C)";
+        case 0x06: return "Grenade Launcher (Normal)";
+        case 0x07: return "Grenade Launcher (Flame)";
+        case 0x08: return "Grenade Launcher (Acid)";
+        case 0x09: return "Grenade Launcher (Freeze)";
+        case 0x0A: return "Rocket Launcher";
+        case 0x0B: return "Gatling Gun";
+        case 0x0C: return "Mine Thrower";
+        case 0x0D: return "Custom Handgun";
+        case 0x0E: return "Assault Rifle (Manual)";
+        case 0x0F: return "Assault Rifle (Auto)";
+        case 0x15: return "Handgun Bullets";
+        case 0x16: return "Magnum Bullets";
+        case 0x17: return "Shotgun Shells";
+        case 0x18: return "Grenade Rounds (Normal)";
+        case 0x19: return "Flame Rounds";
+        case 0x1A: return "Acid Rounds";
+        case 0x1B: return "Freeze Rounds";
+        case 0x1F: return "Mine Thrower Bullets";
+        case 0x22: return "Assault Rifle Bullets";
+        case 0x24: return "Enhanced Handgun Bullets";
+        case 0x25: return "Enhanced Shotgun Shells";
+        case 0x80: return "Boutique Key";
+        case 0x81: return "Ink Ribbon";
+        default: return "Item";
+    }
+}
+
+static inline bool re3_is_weapon(uint8_t id) {
+    return (id >= 0x01 && id <= 0x0F);
+}
+
+static inline bool re3_is_ammo(uint8_t id) {
+    return (id >= 0x15 && id <= 0x1B) || id == 0x1F || id == 0x22 || id == 0x23 || id == 0x24 || id == 0x25;
+}
