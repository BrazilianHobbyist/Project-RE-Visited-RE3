+ * which comes out as distorted noise. Discard SPU output from door start
+ * (stage 0, 0x80015498) until shortly after the stage-2 fade-in (0x80016190).
+ * The SPU keeps running; only host output is dropped, then faded back in. */
+static int s_re3_door_mute_frames = 0;
+/* Fast loading at the same verified boundary: while the skipped door loads
+ * the next room, the whole machine runs unpaced (host turbo). Guest timing
+ * is untouched -- CD deadlines, VBlanks and IRQs all advance in guest cycles
+ * -- only wall-clock pacing is dropped (docs/LOAD_TIME_ZERO.md, Lever A),
+ * and the door mute above already sinks the accelerated audio. Stops at the
+ * stage-2 fade-in, so the new room fades in at normal speed. */
+static int s_re3_door_turbo_frames = 0;
+/* Measured per door (re3_door_timeline, 2026-10-20): after the skipped
+ * stage 2 the game still reads the door model (DOOR*.DO1, one CD burst),
+ * idles 0.1-1.7 s with the screen black, then reads the new room
+ * (R*.ARD/.BIN/.BSS, one burst); control returns when that burst ends.
+ * So the load boundary is: door start -> end of the second data burst. */
+static int s_re3_door_bursts = 0;
+/* Door transition wall time (stage-0 entry to stage-2 fade-in), reported in
+ * psx_last_run_report.json as "re3_doors". */
+static uint64_t s_re3_door_t0 = 0;
+extern "C" uint32_t g_re3_door_count = 0;
+extern "C" double   g_re3_door_ms_total = 0.0, g_re3_door_ms_max = 0.0;
+static void re3_door_probe_begin(void);
+static void re3_door_probe_end(void);
+extern "C" void re3_door_audio_begin(void) {
+    re3_door_probe_begin();
+    s_re3_door_t0 = SDL_GetPerformanceCounter();
+    if (g_fast_doors) {
+        s_re3_door_mute_frames = 600;   /* safety cap ~10 s */
+        s_re3_door_turbo_frames = 600;
+        /* s_re3_door_bursts is reset in re3_door_probe_begin (above). */
+    }
+}
+extern "C" void re3_door_audio_end(void) {
+    re3_door_probe_end();
+    if (s_re3_door_t0) {
+        const double ms = (double)(SDL_GetPerformanceCounter() - s_re3_door_t0) * 1000.0 /
+                          (double)SDL_GetPerformanceFrequency();
+        s_re3_door_t0 = 0;
+        g_re3_door_count++;
+        g_re3_door_ms_total += ms;
+        if (ms > g_re3_door_ms_max) g_re3_door_ms_max = ms;
+    }
+}
+static int re3_door_turbo_active(void) {
+    if (s_re3_door_turbo_frames <= 0) return 0;
+    s_re3_door_turbo_frames--;
+    return 1;
+}
+
+/* Door load probe: where does the CD load of a room change fall relative to
+ * the door hooks? Per door: CD-load wall time before stage 0 (the burst still
+ * running or just ended within 2 s), and after the stage-2 fade-in until the
+ * drive has been idle for 20 frames. Reported as "re3_door_loads". */
+static double   s_rdp_burst_start = 0.0, s_rdp_last_load = 0.0;
+static int      s_rdp_post = 0, s_rdp_idle = 0, s_rdp_was_load = 0;
+static double   s_rdp_end_t = 0.0;
+extern "C" uint32_t g_re3_dl_count = 0;
+extern "C" double   g_re3_dl_pre_ms = 0.0, g_re3_dl_post_ms = 0.0, g_re3_dl_post_max = 0.0;
+static double rdp_now_ms(void) {
+    return (double)SDL_GetPerformanceCounter() * 1000.0 / (double)SDL_GetPerformanceFrequency();
+}
+/* Door timeline: ring of the last events (CD data bursts with their SetLoc
+ * LBA, door hooks), absolute wall ms plus player mode/routine bytes, dumped
+ * as "re3_door_timeline" so the room-load position can be read per file. */
+struct Re3TlEvent { double t; char kind; int lba; uint8_t mode, routine; };
+static Re3TlEvent s_tl[256];
+static uint32_t   s_tl_n = 0;
+static int        s_tl_lba = -1;
+static void re3_tl_push(char kind, int lba) {
+    Re3TlEvent& e = s_tl[s_tl_n++ % 256];
+    e.t = rdp_now_ms(); e.kind = kind; e.lba = lba;
+    e.mode = g_psx_ram ? g_psx_ram[0x000CCBC8] : 0;
+    e.routine = g_psx_ram ? g_psx_ram[0x000CCBC9] : 0;
+}
+extern "C" void re3_door_timeline_json(char* out, int cap) {
+    int pos = 0;
+    const uint32_t n = s_tl_n < 256 ? s_tl_n : 256;
+    const uint32_t first = s_tl_n - n;
+    pos += snprintf(out + pos, cap - pos, "[");
+    for (uint32_t i = 0; i < n && pos < cap - 64; ++i) {
+        const Re3TlEvent& e = s_tl[(first + i) % 256];
+        pos += snprintf(out + pos, cap - pos, "%s[%.0f,\"%c\",%d,%u,%u]",
+                        i ? "," : "", e.t, e.kind, e.lba, e.mode, e.routine);
+    }
+    snprintf(out + pos, cap - pos, "]");
+}
+static void re3_door_probe_begin(void) {
+    re3_tl_push('D', -1);
+    /* A load still running at the door merges with the door-model read:
+     * it is the first burst already. */
+    s_re3_door_bursts = s_rdp_was_load ? 1 : 0;
+    const double now = rdp_now_ms();
+    if (s_rdp_last_load > 0.0 && now - s_rdp_last_load < 2000.0)
+        g_re3_dl_pre_ms += now - s_rdp_burst_start;
+}
+static void re3_door_probe_end(void) {
+    re3_tl_push('F', -1);
+    s_rdp_end_t = rdp_now_ms();
+    s_rdp_post = 1;
+    s_rdp_idle = 0;
+}
+static void re3_door_probe_frame(int cd_load) {
+    const double now = rdp_now_ms();
+    if (cd_load) {
+        const int lba = cdrom_get_setloc_lba();
+        if (!s_rdp_was_load) { re3_tl_push('S', lba); s_tl_lba = lba; }
+        else if (lba != s_tl_lba) { re3_tl_push('L', lba); s_tl_lba = lba; }
+    } else if (s_rdp_was_load) {
+        re3_tl_push('E', s_tl_lba);
+    }
+    /* Door turbo end. Bursts are counted on the bridged load signal: the
+     * door-model read pauses for more than 6 frames inside one file, so a
+     * physical-gap count split it and ended turbo ~0.1 s in (playtest
+     * 2026-10-20, 9 of 9 doors). Once the room burst (the second) has begun,
+     * the end is the physical read stopping for 8 frames, not the bridge's
+     * 30 frames, which would leave the first ~0.5 s of the room unpaced. */
+    static int s_phys_idle = 0, s_phys_in_burst = 0;
+    if (s_re3_door_turbo_frames > 0 && cd_load && !s_rdp_was_load &&
+        ++s_re3_door_bursts == 2) {
+        s_phys_in_burst = 0;
+    }
+    if (cdrom_data_read_active()) { s_phys_in_burst = 1; s_phys_idle = 0; }
+    else if (s_phys_in_burst && ++s_phys_idle >= 8) {
+        s_phys_in_burst = 0;
+        if (s_re3_door_turbo_frames > 0 && s_re3_door_bursts >= 2) {
+            s_re3_door_turbo_frames = 0;
+            if (s_re3_door_mute_frames > 0) s_re3_door_mute_frames = 12;
+            re3_tl_push('T', -1);
+        }
+    }
+    if (cd_load) {
+        if (!s_rdp_was_load) s_rdp_burst_start = now;
+        s_rdp_last_load = now;
+        s_rdp_idle = 0;
+    } else {
+        s_rdp_idle++;
+    }
+    s_rdp_was_load = cd_load;
+    if (s_rdp_post && s_rdp_idle >= 20) {
+        const double post = s_rdp_last_load > s_rdp_end_t ? s_rdp_last_load - s_rdp_end_t : 0.0;
+        g_re3_dl_post_ms += post;
+        if (post > g_re3_dl_post_max) g_re3_dl_post_max = post;
+        g_re3_dl_count++;
+        s_rdp_post = 0;
+    }
+}
+static int re3_door_audio_muted(void) {
+    if (s_re3_door_mute_frames <= 0) return 0;
+    s_re3_door_mute_frames--;
+    return 1;
+}
+
+static void re3_maintain_qol_per_frame(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+
+    // Door Skipping: bypass 3D door animation & camera sequence (Stage 1: 0x80015754)
+    // and jump directly to Stage 2 (0x80016150: finalize room transition and restore gameplay).
+    // Also null out Stage 2 (table[2]) so the transition loop terminates without running Stage 2 twice.
+    uint32_t* p_door_stage1 = (uint32_t*)(ram + 0x000979F4);
+    uint32_t* p_door_stage2 = (uint32_t*)(ram + 0x000979F8);
+    if (g_fast_doors) {
+        *p_door_stage1 = 0x80016150u;
+        *p_door_stage2 = 0x00000000u;
+    } else {
+        if (*p_door_stage1 == 0x80016150u) {
+            *p_door_stage1 = 0x80015754u;
+        }
+        if (*p_door_stage2 == 0x00000000u) {
+            *p_door_stage2 = 0x80016150u;
+        }
+    }
+
+    // Capcom native Secret Mode / Clear Mode flag (0x800D1F32):
+    // Bitmask 0xFFE0 populates item box with special weapons (Rocket Launcher, Gatling, M4A1, etc.),
+    // infinite ink ribbons, and unlocks the Boutique & all costumes.
+    if (g_all_weapons_box || g_unlock_boutique || g_unlock_mercenaries) {
+        *(uint16_t*)(ram + 0x000D1F32) |= 0xFFE0;
+    }
+
+    if (g_unlock_epilogues) {
+        ram[0x000D1F3E] = 8; // All 8 epilogues unlocked in gallery
+    }
+
+    // Active gameplay cheats (when player entity is active: inventory size 8 or 10)
+    uint8_t max_slots = ram[0x000D225E];
+    if (max_slots == 8 || max_slots == 10) {
+        // Infinite Health (God Mode)
+        if (g_infinite_health) {
+            uint16_t* p_hp = (uint16_t*)(ram + 0x000CCC90);
+            if (*p_hp > 0 && *p_hp < 200) {
+                *p_hp = 200;
+            }
+            ram[0x000CCC97] = 0x04; // Status condition Fine & poison cleared
+        }
+
+        // Infinite Ammo
+        if (g_infinite_ammo) {
+            RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+            for (int i = 0; i < max_slots; ++i) {
+                uint8_t wid = slots[i].id;
+                if (re3_is_weapon(wid) && wid != 0x01) { // firearm weapons
+                    uint8_t cap = 0;
+                    if (wid == 0x02 || wid == 0x03 || wid == 0x0D) cap = 15; // Handguns
+                    else if (wid == 0x04) cap = 7;                            // Shotgun M3S
+                    else if (wid == 0x05) cap = 6;                            // Magnum
+                    else if (wid >= 0x06 && wid <= 0x09) cap = 6;            // Grenade Launchers
+                    else if (wid == 0x0A || wid == 0x0B) cap = 255;          // Heavy weapons
+                    else if (wid == 0x0C) cap = 6;                            // Mine Thrower
+                    else if (wid == 0x0E || wid == 0x0F) cap = 100;          // Assault Rifle
+                    if (cap > 0 && slots[i].count < cap) {
+                        slots[i].count = cap;
+                    }
+                } else if (re3_is_ammo(wid)) {
+                    if (slots[i].count < 250) {
+                        slots[i].count = 250;
+                    }
+                }
+            }
+        }
+
+        // Infinite Ink Ribbons
+        if (g_infinite_ink_ribbons) {
+            RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+            for (int i = 0; i < max_slots; ++i) {
+                if (slots[i].id == 0x81 && slots[i].count < 99) { // 0x81 = Ink Ribbon
+                    slots[i].count = 99;
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------------
+    // Cutscene/FMV skip: maps Esc/Tab to the game's own Select skip
+    // ------------------------------------------------------------------------
+    if (g_skip_cutscenes) {
+        uint16_t pad_btn = pad_buttons_for(g_players[0], 1, true);
+        const Uint8* keys = SDL_GetKeyboardState(NULL);
+
+        bool esc_down    = keys && (keys[SDL_SCANCODE_ESCAPE] != 0);
+        bool tab_down    = keys && (keys[SDL_SCANCODE_TAB] != 0);
+
+        bool pad_select_down = ((pad_btn & PAD_SELECT) == 0);
+        bool pad_start_down  = ((pad_btn & PAD_START) == 0);
+
+        // An authentic PS1 FMV uses 24-bit color depth (GP1(08h) display_depth=1) and active MDEC.
+        // 2D backgrounds and 3D scenes during gameplay run in 15-bit mode (display_depth=0),
+        // preventing false FMV positives during room transitions or camera angle switches.
+        bool is_fmv = (gpu_display_is_depth24() != 0) && (mdec_recently_active(8) != 0);
+
+        if (is_fmv) {
+            // Only Start, Select, Esc or Tab skip movie playback.
+            // Never include action buttons (A/Cross, B/Circle) to prevent gameplay disruption.
+            bool fmv_skip_requested = pad_start_down || pad_select_down || esc_down || tab_down;
+            if (fmv_skip_requested) {
+                s_re3_fmv_skip_frames = 20;
+            }
+        } else {
+            s_re3_fmv_skip_frames = 0; // Immediate disarm outside FMVs
+            // In-Game Real-Time Cutscenes:
+            // RE3 native engine skips cutscenes and radio sequences when PAD_SELECT is pressed.
+            // Escape and Tab on keyboard are mapped to trigger cutscene skip as well.
+            // Never trigger on PAD_START: Start is standard pause/inventory during gameplay.
+            bool cutscene_skip_requested = pad_select_down || esc_down || tab_down;
+
+            // Only the game's own Select skip is used. Forcing the XA voice
+            // stream to end from the CD side left the game waiting forever on
+            // the drive after its skip fade (black screen).
+            if (cutscene_skip_requested) {
+                s_re3_cutscene_skip_frames = 15;
+            }
+        }
+
+        if (s_re3_fmv_skip_frames > 0) {
+            s_re3_fmv_skip_frames--;
+            uint16_t cur = sio_get_pad_buttons_slot(0);
+            sio_set_pad_state_slot(0, cur & ~(PAD_START | PAD_SELECT));
+        }
+        if (s_re3_cutscene_skip_frames > 0) {
+            s_re3_cutscene_skip_frames--;
+            uint16_t cur = sio_get_pad_buttons_slot(0);
+            sio_set_pad_state_slot(0, cur & ~PAD_SELECT);
+        }
+    }
+}
+
+/* DirectInput joystick detection. Off by default: on some PCs a HID device
+ * makes SDL's DirectInput enumeration (SDL_DINPUT_JoystickDetect -> hid.dll)
+ * block SDL_Init for ~9 s. XInput, RawInput and HIDAPI still cover Xbox,
+ * PlayStation, Switch and most generic pads. settings.toml:
+ * directinput_joysticks = true re-enables it for old DirectInput-only pads.
+ * The SDL_JOYSTICK_DIRECTINPUT environment variable still overrides. */
+static bool g_directinput_joysticks = false;
+static void re3_apply_directinput_hint(void) {
+#ifdef SDL_HINT_JOYSTICK_DIRECTINPUT
+    SDL_SetHint(SDL_HINT_JOYSTICK_DIRECTINPUT, g_directinput_joysticks ? "1" : "0");
+#endif
+}
