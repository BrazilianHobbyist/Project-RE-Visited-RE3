+static void load_re3_qol_settings(const std::filesystem::path& path) {
+    std::ifstream f(path);
+    if (!f.is_open()) return;
+    std::string line;
+    while (std::getline(f, line)) {
+        size_t first = line.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos || line[first] == '#') continue;
+        size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        std::string key = line.substr(0, eq);
+        std::string val = line.substr(eq + 1);
+        auto trim = [](std::string& s) {
+            size_t p1 = s.find_first_not_of(" \t\r\n\"");
+            size_t p2 = s.find_last_not_of(" \t\r\n\"");
+            if (p1 == std::string::npos) s.clear();
+            else s = s.substr(p1, p2 - p1 + 1);
+        };
+        trim(key);
+        trim(val);
+        if (key == "fast_doors" || key == "door_skip") g_fast_doors = (val == "true" || val == "1" || val == "instant") ? 1 : 0;
+        else if (key == "modern_controls") g_modern_controls = (val == "true" || val == "1");
+        else if (key == "directinput_joysticks") g_directinput_joysticks = (val == "true" || val == "1");
+        else if (key == "modern_turn_speed") {
+            int v = std::atoi(val.c_str());
+            if (v >= 16 && v <= 2048) g_modern_turn_speed = v;
+        }
+        else if (key == "rumble_intensity" || key == "vibration_intensity" || key == "vibration_strength") {
+            float r = (float)std::atof(val.c_str());
+            if (r >= 0.0f && r <= 5.0f) g_rumble_intensity = r;
+        }
+        else if (key == "infinite_health") g_infinite_health = (val == "true" || val == "1");
+        else if (key == "infinite_ammo") g_infinite_ammo = (val == "true" || val == "1");
+        else if (key == "infinite_ink_ribbons") g_infinite_ink_ribbons = (val == "true" || val == "1");
+        else if (key == "all_weapons_box") g_all_weapons_box = (val == "true" || val == "1");
+        else if (key == "unlock_mercenaries") g_unlock_mercenaries = (val == "true" || val == "1");
+        else if (key == "unlock_boutique") g_unlock_boutique = (val == "true" || val == "1");
+        else if (key == "unlock_epilogues") g_unlock_epilogues = (val == "true" || val == "1");
+        else if (key == "spu_hq") g_audio_spu_hq = (val == "true" || val == "1");
+        else if (key == "auto_skip_fmv") g_auto_skip_fmv = (val == "true" || val == "1") ? 1 : 0;
+        else if (key == "skip_cutscenes" || key == "cutscene_skip") g_skip_cutscenes = (val == "true" || val == "1");
+        else if (key == "frequency") {
+            int freq = std::atoi(val.c_str());
+            if (freq >= 22050 && freq <= 96000) g_audio_freq = freq;
+        }
+        else if (key == "aspect_stretch") {
+            int stretch = (val == "true" || val == "1") ? 1 : 0;
+            gl_renderer_set_aspect_stretch(stretch);
+        }
+    }
+
+    if (g_infinite_health || g_infinite_ammo || g_infinite_ink_ribbons ||
+        g_all_weapons_box || g_unlock_mercenaries || g_unlock_boutique || g_unlock_epilogues) {
+        std::fprintf(stdout, "psxrecomp: [Cheats] Modifiers active from settings.toml (Health:%d, Ammo:%d, Ribbons:%d, Weapons:%d, Mercs:%d, Boutique:%d, Epilogues:%d)\n",
+                     g_infinite_health ? 1 : 0, g_infinite_ammo ? 1 : 0, g_infinite_ink_ribbons ? 1 : 0,
+                     g_all_weapons_box ? 1 : 0, g_unlock_mercenaries ? 1 : 0, g_unlock_boutique ? 1 : 0, g_unlock_epilogues ? 1 : 0);
+    }
+}
