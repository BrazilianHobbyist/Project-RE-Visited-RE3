         PGXPStats st;
diff --git a/runtime/tests/test_texture_plane_depth.c b/runtime/tests/test_texture_plane_depth.c
new file mode 100644
index 00000000..4a437f02
--- /dev/null
+++ b/runtime/tests/test_texture_plane_depth.c
@@ -0,0 +1,96 @@
+/* A floor quad clipped against the near plane gets one corner built by CPU
+ * math, with no recorded Z. Its triangle must still be drawn perspective-
+ * correct, with that corner's depth taken from the plane of the other three
+ * (1/Z is affine in screen space on a plane); otherwise it draws affine beside
+ * perspective-correct neighbours and the texture breaks along their edge.
+ * Execute the GPU texture preparation path and check the recovered depth and
+ * every case that must stay affine. */
+#define main gpu_fixture_main
+#include "test_gpu_textured_dot_nw_shift_exec.c"
+#undef main
+#include <math.h>
+
+static const int idx[4] = { 1, 4, 7, 10 };
+
+/* Quad corners on screen; the plane is 1/Z = 0.001 + 0.00001 * y. */
+static const int32_t qx[4] = { 100, 200, 100, 200 };
+static const int32_t qy[4] = { 100, 100, 200, 200 };
+static uint16_t plane_z(int32_t y) { return (uint16_t)(1.0 / (0.001 + 0.00001 * y) + 0.5); }
+
+static void setup_quad(int missing_mask) {
+    reset_gpu_state_for_test();
+    memset(fixture_projections, 0, sizeof fixture_projections);
+    memset(&fixture_perspective_triangle, 0, sizeof fixture_perspective_triangle);
+    s_texture_correction_enabled = 1;
+    gp0_cmd_source_addr = 0x10004u;
+    for (int i = 0; i < 4; i++) {
+        uint32_t word = pack_vertex((int16_t)qx[i], (int16_t)qy[i]);
+        gp0_cmd_buf[idx[i]] = word;
+        fixture_projections[i].addr = gp0_cmd_source_addr + (uint32_t)idx[i] * 4u;
+        fixture_projections[i].word = word;
+        fixture_projections[i].x16 = qx[i] * 65536;
+        fixture_projections[i].y16 = qy[i] * 65536;
+        fixture_projections[i].z = (missing_mask >> i) & 1 ? 0 : plane_z(qy[i]);
+        fixture_projections[i].valid = 1;
+    }
+}
+
+/* q ratios handed to the rasterizer for triangle (7,4,10): corner order
+ * idx[2], idx[1], idx[3]. */
+static void expect_plane_ratios(void) {
+    const double q[3] = { 1.0 / plane_z(qy[2]), 1.0 / plane_z(qy[1]),
+                          1.0 / plane_z(qy[3]) };
+    double qmax = q[0];
+    for (int i = 1; i < 3; i++) if (q[i] > qmax) qmax = q[i];
+    for (int i = 0; i < 3; i++)
+        assert(fabs(fixture_perspective_triangle.q[i] - q[i] / qmax) < 0.002);
+}
+
+int main(void) {
+    /* All four corners projected: plain perspective. */
+    setup_quad(0);
+    prepare_texture_triangle_q(7, 4, 10, 1);
+    assert(fixture_perspective_triangle.enabled);
+    expect_plane_ratios();
+
+    /* The clipped corner (10) has no Z: recovered from corners 1, 4, 7. */
+    setup_quad(1 << 3);
+    uint64_t no_depth_before = s_texcorr.no_depth;
+    prepare_texture_triangle_q(7, 4, 10, 1);
+    assert(fixture_perspective_triangle.enabled);
+    assert(s_texcorr.no_depth == no_depth_before);
+    expect_plane_ratios();
+
+    /* The other half does not use corner 10: unaffected either way. */
+    prepare_texture_triangle_q(1, 4, 7, 10);
+    assert(fixture_perspective_triangle.enabled);
+
+    /* Two corners without Z leave only two points: no plane, stays affine. */
+    setup_quad((1 << 3) | (1 << 2));
+    prepare_texture_triangle_q(7, 4, 10, 1);
+    assert(!fixture_perspective_triangle.enabled);
+
+    /* A plain triangle has no fourth corner to recover from. */
+    setup_quad(1 << 3);
+    prepare_texture_triangle(7, 4, 10);
+    assert(!fixture_perspective_triangle.enabled);
+
+    /* Collinear known corners do not define a plane. */
+    setup_quad(1 << 3);
+    for (int i = 0; i < 3; i++) {
+        uint32_t word = pack_vertex((int16_t)(100 + 50 * i), (int16_t)(100 + 50 * i));
+        gp0_cmd_buf[idx[i]] = word;
+        fixture_projections[i].word = word;
+    }
+    prepare_texture_triangle_q(7, 4, 10, 1);
+    assert(!fixture_perspective_triangle.enabled);
+
+    /* A corner whose plane depth would lie behind the camera is rejected. */
+    setup_quad(1 << 3);
+    gp0_cmd_buf[idx[3]] = pack_vertex(200, -1000);
+    prepare_texture_triangle_q(7, 4, 10, 1);
+    assert(!fixture_perspective_triangle.enabled);
+
+    puts("texture_plane_depth_test: ok");
+    return 0;
+}
