+
+static int is_3d_actor_polygon(const int32_t *vx, const int32_t *vy, int n) {
+    if (n < 3 || n > 4) return 0;
+    int32_t min_x = vx[0], max_x = vx[0];
+    int32_t min_y = vy[0], max_y = vy[0];
+    for (int i = 1; i < n; i++) {
+        if (vx[i] < min_x) min_x = vx[i];
+        if (vx[i] > max_x) max_x = vx[i];
+        if (vy[i] < min_y) min_y = vy[i];
+        if (vy[i] > max_y) max_y = vy[i];
+    }
+    int32_t pw = max_x - min_x;
+    int32_t ph = max_y - min_y;
+    /* Reject full-frame or background-sized primitives and tiny noise */
+    if (pw > 220 || ph > 180) return 0;
+    if (pw < 2 && ph < 2) return 0;
+    return 1;
+}
+
+static void note_3d_actor_polygon(const int32_t *vx, const int32_t *vy, int n) {
+    if (!is_3d_actor_polygon(vx, vy, n)) return;
+
+    for (int i = 0; i < n; i++) {
+        int32_t ly = vy[i];
+        if (ly >= 240) ly -= 240;
+        if (ly >= -20 && ly <= 260) {
+            int32_t clamped = ly < 0 ? 0 : (ly > 239 ? 239 : ly);
+            s_actor_prim_count++;
+            s_actor_y_sum += clamped;
+            if (clamped < s_actor_y_min) s_actor_y_min = clamped;
+            if (clamped > s_actor_y_max) s_actor_y_max = clamped;
+        }
+    }
+}
+
+int gpu_get_actor_vertical_centroid(void) {
+    if (s_actor_prim_count >= 4) {
+        s_last_valid_centroid = (int)(s_actor_y_sum / s_actor_prim_count);
+        return s_last_valid_centroid;
+    }
+    return s_last_valid_centroid;
+}
+
+uint64_t gpu_get_actor_prim_count(void) {
+    return s_actor_prim_count;
+}
+
+int gpu_is_in_3d_gameplay(void) {
+    return 1;
+}
+
+int gpu_is_message_box_active(void) {
+    return (s_msg_box_countdown > 0) ? 1 : 0;
+}
+
+void gpu_reset_actor_vertical_tracking(void) {
+    if (s_actor_prim_count < 20 && s_gameplay_latch > 0) {
+        s_gameplay_latch--;
+    }
+    if (s_msg_box_countdown > 0) {
+        s_msg_box_countdown--;
+    }
+    s_actor_prim_count = 0;
+    s_actor_y_sum = 0;
+    s_actor_y_min = 9999;
+    s_actor_y_max = -9999;
+}
