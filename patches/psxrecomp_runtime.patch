+    static const char H[] = "0123456789abcdef";
+    uint64_t oldest = (s_history_count > FRAME_HISTORY_CAP)
+                    ? s_history_count - FRAME_HISTORY_CAP : 0;
+    int rows = 0;
+    for (uint64_t f = (uint64_t)f0; f <= (uint64_t)f1 && f < s_history_count; f++) {
