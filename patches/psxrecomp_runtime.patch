diff --git a/runtime/tests/test_pgxp.cpp b/runtime/tests/test_pgxp.cpp
index 6128e68f..120878b2 100644
--- a/runtime/tests/test_pgxp.cpp
+++ b/runtime/tests/test_pgxp.cpp
@@ -991,6 +991,83 @@ int main(void) {
         pgxp_set_tolerance(-1.0f);
     }
 
+    /* --- packed shift (Muppet Monster Adventure 0x80019034 / 0x80019150):
+     *   mfc2 s1,SXY0; sll v1,s1,4; ori v1,v1,1; ori v1,v1,2; sw v1,0(t2)
+     *   ... lw fp,0(t4); sra fp,fp,4; sw fp,8(packet)
+     * The vertex table holds (SXY << 4) | clip flags. Exact bit movement, so
+     * it must survive in both tiers, depth included. (The test reads SXY2,
+     * where pgxp_gte_push_sxy lands; the game reads SXY0 after RTPT.) --- */
+    {
+        const uint32_t P4 = PACKED << 4;
+        const uint32_t TBL = 0x800B9204u;
+        int32_t x, y; uint16_t z;
+        pgxp_gte_push_sxy(X16, Y16, SZ3, PACKED);
+        psx_pgxp_cop2(nullptr, MFC2(17, 14), PACKED, 0);
+        psx_pgxp_alu(nullptr, SLL(17, 3, 4), P4, PACKED, 4u);
+        psx_pgxp_alu(nullptr, ORI(3, 3, 1), P4 | 1u, P4, 1u);
+        psx_pgxp_alu(nullptr, ORI(3, 3, 2), P4 | 3u, P4 | 1u, 2u);
+        psx_pgxp_store(nullptr, SW(10, 3), TBL, P4 | 3u);
+        /* parked: the table word itself is not a vertex */
+        CHECK(lookup(TBL, P4 | 3u, 0, 0, nullptr, nullptr, nullptr) ==
+              PGXP_SRC_NATIVE);
+        psx_pgxp_load(nullptr, LW(12, 30), TBL, P4 | 3u);
+        psx_pgxp_alu(nullptr, SRA(30, 30, 4), PACKED, P4 | 3u, 4u);
+        psx_pgxp_store(nullptr, SW(12, 30), ADDR_B, PACKED);
+        CHECK(lookup(ADDR_B, PACKED, 160, 80, &x, &y, &z) == PGXP_SRC_DATAFLOW);
+        CHECK(x == X16 && y == Y16 && z == SZ3);
+
+        /* negative Y round-trips through the arithmetic shift */
+        const uint32_t NEG = (0xFFF6u << 16) | 160u;           /* y = -10 */
+        pgxp_gte_push_sxy(X16, (int32_t)(-10 * 65536) + 0x4000, SZ3, NEG);
+        psx_pgxp_cop2(nullptr, MFC2(17, 14), NEG, 0);
+        psx_pgxp_alu(nullptr, SLL(17, 3, 4), NEG << 4, NEG, 4u);
+        psx_pgxp_alu(nullptr, SRA(3, 30, 4), NEG, NEG << 4, 4u);
+        psx_pgxp_store(nullptr, SW(12, 30), ADDR_B, NEG);
+        CHECK(lookup(ADDR_B, NEG, 160, -10, &x, &y, nullptr) == PGXP_SRC_DATAFLOW);
+        CHECK(y == (int32_t)(-10 * 65536) + 0x4000);
+
+        /* a write above the flag bits, a different shift back, or a logical
+         * shift of a negative word: the vertex is gone */
+        pgxp_gte_push_sxy(X16, Y16, SZ3, PACKED);
+        psx_pgxp_cop2(nullptr, MFC2(17, 14), PACKED, 0);
+        psx_pgxp_alu(nullptr, SLL(17, 3, 4), P4, PACKED, 4u);
+        psx_pgxp_alu(nullptr, ORI(3, 4, 0x10), P4 | 0x10u, P4, 0x10u);
+        psx_pgxp_alu(nullptr, SRA(4, 30, 4), PACKED | 1u, P4 | 0x10u, 4u);
+        psx_pgxp_store(nullptr, SW(12, 30), ADDR_B, PACKED | 1u);
+        CHECK(lookup(ADDR_B, PACKED | 1u, 161, 80, nullptr, nullptr, nullptr) ==
+              PGXP_SRC_NATIVE);
+        psx_pgxp_alu(nullptr, SRA(3, 30, 3), P4 >> 3, P4, 3u);
+        psx_pgxp_store(nullptr, SW(12, 30), ADDR_B, P4 >> 3);
+        CHECK(lookup(ADDR_B, P4 >> 3, 0, 0, nullptr, nullptr, nullptr) ==
+              PGXP_SRC_NATIVE);
+
+        /* a Y the shift overflows never parks */
+        const uint32_t BIG = (0x0900u << 16) | 160u;
+        pgxp_gte_push_sxy(X16, 0x0900 << 16, SZ3, BIG);
+        psx_pgxp_cop2(nullptr, MFC2(17, 14), BIG, 0);
+        psx_pgxp_alu(nullptr, SLL(17, 3, 4), BIG << 4, BIG, 4u);
+        psx_pgxp_alu(nullptr, SRA(3, 30, 4), (uint32_t)((int32_t)(BIG << 4) >> 4),
+                     BIG << 4, 4u);
+        psx_pgxp_store(nullptr, SW(12, 30), ADDR_B,
+                       (uint32_t)((int32_t)(BIG << 4) >> 4));
+        CHECK(lookup(ADDR_B, (uint32_t)((int32_t)(BIG << 4) >> 4), 160, 0,
+                     nullptr, nullptr, nullptr) == PGXP_SRC_NATIVE);
+
+        /* SH into a parked word forgets it */
+        pgxp_gte_push_sxy(X16, Y16, SZ3, PACKED);
+        psx_pgxp_cop2(nullptr, MFC2(17, 14), PACKED, 0);
+        psx_pgxp_alu(nullptr, SLL(17, 3, 4), P4, PACKED, 4u);
+        psx_pgxp_store(nullptr, SW(10, 3), TBL, P4);
+        psx_pgxp_store(nullptr, SH(10, 0), TBL, 0u);
+        psx_pgxp_load(nullptr, LW(12, 30), TBL, P4 & 0xFFFF0000u);
+        psx_pgxp_alu(nullptr, SRA(30, 30, 4), (uint32_t)((int32_t)(P4 & 0xFFFF0000u) >> 4),
+                     P4 & 0xFFFF0000u, 4u);
+        psx_pgxp_store(nullptr, SW(12, 30), ADDR_B,
+                       (uint32_t)((int32_t)(P4 & 0xFFFF0000u) >> 4));
+        CHECK(lookup(ADDR_B, (uint32_t)((int32_t)(P4 & 0xFFFF0000u) >> 4), 0, 0,
+                     nullptr, nullptr, nullptr) == PGXP_SRC_NATIVE);
+    }
+
