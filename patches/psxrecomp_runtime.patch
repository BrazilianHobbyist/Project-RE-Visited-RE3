+static void handle_frame_history_dump(int id, const char *json)
+{
+    if (!s_frame_history) { send_err(id, "ring buffer not allocated"); return; }
+    int f0 = json_get_int(json, "start", -1);
+    int f1 = json_get_int(json, "end", -1);
+    if (f0 < 0 || f1 < f0) { send_err(id, "missing or bad start/end"); return; }
+    char path[512];
+    if (!json_get_str(json, "out", path, sizeof(path)))
+        snprintf(path, sizeof(path), "psx_frame_history.csv");
+    FILE *fp = fopen(path, "w");
+    if (!fp) { send_err(id, "cannot open file"); return; }
+    fprintf(fp, "frame,pad_buttons,game_data");
+    for (int i = 0; i < RAM_SNAPSHOT_REGIONS; i++) fprintf(fp, ",snap%d_addr,snap%d", i, i);
