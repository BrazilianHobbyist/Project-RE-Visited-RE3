+static void load_re3_qol_settings(const std::filesystem::path& path) {
+    std::ifstream f(path);
+    if (!f.is_open()) return;
+    std::string line;
+    std::string setting_aspect_ratio;
+    int setting_pan_scan = -1;
+    while (std::getline(f, line)) {
+        size_t first = line.find_first_not_of(" \t\r\n");
+        if (first == std::string::npos || line[first] == '#') continue;
+        size_t eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        std::string key = line.substr(0, eq);
+        std::string val = line.substr(eq + 1);
+        auto trim = [](std::string& s) {
+            size_t p1 = s.find_first_not_of(" \t\r\n\"");
+            size_t p2 = s.find_last_not_of(" \t\r\n\"");
+            if (p1 == std::string::npos) s.clear();
+            else s = s.substr(p1, p2 - p1 + 1);
+        };
+        trim(key);
+        trim(val);
+        if (key == "fast_doors" || key == "door_skip") g_fast_doors = (val == "true" || val == "1" || val == "instant") ? 1 : 0;
+        else if (key == "quick_weapon_switch") g_quick_weapon_switch = (val == "true" || val == "1");
+        else if (key == "quick_reload") g_quick_reload = (val == "true" || val == "1");
+        else if (key == "uncapped_ammo_stacks") g_uncapped_ammo_stacks = (val == "true" || val == "1");
+        else if (key == "modern_controls") g_modern_controls = (val == "true" || val == "1");
+        else if (key == "infinite_health") g_infinite_health = (val == "true" || val == "1");
+        else if (key == "infinite_ammo") g_infinite_ammo = (val == "true" || val == "1");
+        else if (key == "infinite_ink_ribbons") g_infinite_ink_ribbons = (val == "true" || val == "1");
+        else if (key == "all_weapons_box") g_all_weapons_box = (val == "true" || val == "1");
+        else if (key == "unlock_mercenaries") g_unlock_mercenaries = (val == "true" || val == "1");
+        else if (key == "unlock_boutique") g_unlock_boutique = (val == "true" || val == "1");
+        else if (key == "unlock_epilogues") g_unlock_epilogues = (val == "true" || val == "1");
+        else if (key == "spu_hq") g_audio_spu_hq = (val == "true" || val == "1");
+        else if (key == "auto_skip_fmv") g_auto_skip_fmv = (val == "true" || val == "1") ? 1 : 0;
+        else if (key == "turbo_loads") g_turbo_loads_enabled = (val == "true" || val == "1") ? 1 : 0;
+        else if (key == "frequency") {
+            int freq = std::atoi(val.c_str());
+            if (freq >= 22050 && freq <= 96000) g_audio_freq = freq;
+        }
+        else if (key == "aspect_stretch") {
+            int stretch = (val == "true" || val == "1") ? 1 : 0;
+            gl_renderer_set_aspect_stretch(stretch);
+        }
+        else if (key == "pan_scan") {
+            setting_pan_scan = (val == "true" || val == "1") ? 1 : 0;
+        }
+        else if (key == "pan_scan_height" || key == "pan_scan_crop_height") {
+            int h = std::atoi(val.c_str());
+            if (h >= 160 && h <= 230) gl_renderer_set_pan_scan_height(h);
+        }
+        else if (key == "pan_scan_deadzone") {
+            float dz = (float)std::atof(val.c_str());
+            if (dz >= 0.0f && dz <= 50.0f) gl_renderer_set_pan_scan_deadzone(dz);
+        }
+        else if (key == "pan_scan_speed") {
+            float spd = (float)std::atof(val.c_str());
+            if (spd >= 0.01f && spd <= 0.3f) gl_renderer_set_pan_scan_speed(spd);
+        }
+        else if (key == "aspect_ratio") {
+            setting_aspect_ratio = val;
+        }
+        else if (key == "frame_interpolation_blend") {
+            if (val == "motion_adaptive" || val == "1") {
+                g_frame_interpolation_blend = PSX_MOD_FRAME_INTERPOLATION_MOTION_ADAPTIVE;
+            } else if (val == "hold" || val == "2") {
+                g_frame_interpolation_blend = PSX_MOD_FRAME_INTERPOLATION_HOLD;
+            } else if (val == "linear" || val == "0") {
+                g_frame_interpolation_blend = PSX_MOD_FRAME_INTERPOLATION_LINEAR;
+            }
+            g_frame_interpolation_blend_default = g_frame_interpolation_blend;
+            gl_renderer_set_interpolation_blend(g_frame_interpolation_blend);
+        }
+        else if (key == "frame_interpolation") {
+            g_frame_interpolation = (val == "true" || val == "1") ? 1 : 0;
+        }
+        else if (key == "frame_interpolation_fps") {
+            int fps = std::atoi(val.c_str());
+            if (fps >= 0 && fps <= 1000) g_frame_interpolation_fps = fps;
+        }
+        else if (key == "frame_interpolation_source") {
+            if (val == "flip" || val == "1") {
+                g_frame_interpolation_source = PSX_MOD_FRAME_SOURCE_FLIP;
+            } else if (val == "vblank" || val == "0") {
+                g_frame_interpolation_source = PSX_MOD_FRAME_SOURCE_VBLANK;
+            }
+            gl_renderer_set_interpolation_source(g_frame_interpolation_source);
+        }
+    }
+
+    int pan_scan_enabled = 0;
+    int pan_scan_h = 180;
+    if (setting_aspect_ratio.find("pan_scan_balanced") != std::string::npos) {
+        pan_scan_enabled = 1;
+        pan_scan_h = 196;
+    } else if (setting_aspect_ratio.find("pan_scan") != std::string::npos) {
+        pan_scan_enabled = 1;
+        pan_scan_h = 180;
+    }
+    if (setting_pan_scan != -1) {
+        pan_scan_enabled = setting_pan_scan;
+    }
+    gl_renderer_set_pan_scan(pan_scan_enabled);
+    if (pan_scan_enabled) {
+        gl_renderer_set_pan_scan_height(pan_scan_h);
+    }
+    std::fprintf(stdout, "psxrecomp: [Video] aspect_ratio=%s, pan_scan=%d (height=%d)\n",
+                 setting_aspect_ratio.empty() ? "default" : setting_aspect_ratio.c_str(),
+                 pan_scan_enabled, gl_renderer_get_pan_scan() ? pan_scan_h : 0);
+
+    if (g_fast_doors) {
+        g_turbo_loads_enabled = 1;
+        g_turbo_load_release_frames = 90;
+    }
+
+    if (g_infinite_health || g_infinite_ammo || g_infinite_ink_ribbons ||
+        g_all_weapons_box || g_unlock_mercenaries || g_unlock_boutique || g_unlock_epilogues) {
+        std::fprintf(stdout, "psxrecomp: [Cheats] Modifiers active from settings.toml (Health:%d, Ammo:%d, Ribbons:%d, Weapons:%d, Mercs:%d, Boutique:%d, Epilogues:%d)\n",
+                     g_infinite_health ? 1 : 0, g_infinite_ammo ? 1 : 0, g_infinite_ink_ribbons ? 1 : 0,
+                     g_all_weapons_box ? 1 : 0, g_unlock_mercenaries ? 1 : 0, g_unlock_boutique ? 1 : 0, g_unlock_epilogues ? 1 : 0);
+    }
+}
