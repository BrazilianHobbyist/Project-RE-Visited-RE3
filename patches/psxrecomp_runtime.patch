+/* Called when a real new guest frame is captured (or non-interpolated present finishes).
+ * Duplicate 60 Hz VBlanks on a 30 FPS game do NOT call this, preserving prev & cur! */
+static void actor_interp_commit_new_frame(int caller_tag) {
+    ActorFrameData *rec = &s_actor_frames[s_actor_rec_slot];
+    if (rec->total_verts == 0) {
+        static int s_skip_cnt = 0;
+        if (++s_skip_cnt <= 5) {
+            interp_audit_write("[COMMIT-NO-VERTS #%d] from caller=%d\n", s_skip_cnt, caller_tag);
+        }
+        return;
+    }
+    extern uint8_t psx_read_byte(uint32_t addr);
+    uint8_t cur_room = psx_read_byte(0x000D1F09);
+    uint8_t cur_cut  = psx_read_byte(0x000D1F0A);
+    rec->room = cur_room;
+    rec->cut  = cur_cut;
+    rec->frame_seq = ++s_actor_frame_counter;
+
+    /* Rotate slots: prev <- cur, cur <- rec, rec <- old prev */
+    int old_prev = s_actor_prev_slot;
+    s_actor_prev_slot = s_actor_cur_slot;
+    s_actor_cur_slot  = s_actor_rec_slot;
+    s_actor_rec_slot  = old_prev;
+
+    /* Reset the new recording slot for the upcoming frame */
+    s_actor_frames[s_actor_rec_slot].total_verts = 0;
+    s_actor_frames[s_actor_rec_slot].num_cmds    = 0;
+
+    ActorFrameData *cur_act  = &s_actor_frames[s_actor_cur_slot];
+    ActorFrameData *prev_act = &s_actor_frames[s_actor_prev_slot];
+
+    if (cur_act->total_verts >= 12 && prev_act->total_verts >= 12 &&
+        cur_act->room == prev_act->room && cur_act->cut == prev_act->cut &&
+        cur_act->frame_seq == prev_act->frame_seq + 1) {
+        actor_interp_match_triangles(prev_act, cur_act);
+        /* Require at least 12 matched triangles (or >= 20% of actor triangles) */
+        size_t n_tris = cur_act->total_verts / 3;
+        if (s_actor_matched_tris >= 12 || (n_tris > 0 && (size_t)s_actor_matched_tris * 10 >= n_tris * 2)) {
+            s_actor_interp_eligible = 1;
+        } else {
+            s_actor_interp_eligible = 0;
+        }
+    } else {
+        s_actor_interp_eligible = 0;
+    }
+
+    static int s_interp_audit_cnt = 0;
+    if (++s_interp_audit_cnt % 30 == 0 || s_interp_audit_cnt <= 15) {
+        size_t n_tris = cur_act->total_verts / 3;
+        interp_audit_write("[FRAME-COMMIT #%d from caller=%d] verts: cur=%zu, prev=%zu | room=%u cut=%u | matched=%d/%zu | eligible=%d\n",
+                s_interp_audit_cnt, caller_tag, cur_act->total_verts, prev_act->total_verts,
+                cur_act->room, cur_act->cut, s_actor_matched_tris, n_tris,
+                s_actor_interp_eligible);
+    }
+}
