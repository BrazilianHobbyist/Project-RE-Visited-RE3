+static void actor_geo_record_triangle(const float *v3, int semi, int mask, int filter, GLuint tex, GLuint clut_tex) {
+    ActorFrameData *rec = &s_actor_frames[s_actor_rec_slot];
+    if (rec->total_verts + 3 > MAX_ACTOR_VERTS_PER_FRAME) return;
+
+    int append = 0;
+    if (rec->num_cmds > 0) {
+        ActorBatchCmd *last = &rec->cmds[rec->num_cmds - 1];
+        if (last->semi == semi && last->mask == mask && last->filter == filter &&
+            last->tex == tex && last->clut_tex == clut_tex) {
+            last->nverts += 3;
+            append = 1;
+        }
+    }
+    if (!append) {
+        if (rec->num_cmds >= MAX_ACTOR_BATCHES) return;
+        ActorBatchCmd *cmd = &rec->cmds[rec->num_cmds++];
+        cmd->v_offset = rec->total_verts * TEXV;
+        cmd->nverts = 3;
+        cmd->semi = semi;
+        cmd->mask = mask;
+        cmd->filter = filter;
+        cmd->tex = tex;
+        cmd->clut_tex = clut_tex;
+    }
+
+    float *dst = &rec->verts[rec->total_verts * TEXV];
+    memcpy(dst, v3, 3 * TEXV * sizeof(float));
+    /* Normalize Y coordinate: PS1 double buffers alternate between Y=0 and Y=240.
+     * In local frame space, vertices are always in [0, 240). */
+    for (int i = 0; i < 3; i++) {
+        float *vp = &dst[i * TEXV];
+        if (vp[1] >= 240.0f) {
+            vp[1] -= 240.0f;
+        }
+    }
+    rec->total_verts += 3;
+}
+
+static void actor_interp_match_triangles(const ActorFrameData *prev, const ActorFrameData *cur) {
+    size_t n_cur_tris  = cur->total_verts / 3;
+    size_t n_prev_tris = prev->total_verts / 3;
+    s_actor_matched_tris = 0;
+
+    for (size_t tc = 0; tc < n_cur_tris; tc++) {
+        const float *vc0 = &cur->verts[(tc * 3 + 0) * TEXV];
+        const float *vc1 = &cur->verts[(tc * 3 + 1) * TEXV];
+        const float *vc2 = &cur->verts[(tc * 3 + 2) * TEXV];
+
+        /* Default fallback: current position (zero displacement) */
+        s_actor_matched_prev_pos[(tc * 3 + 0) * 2 + 0] = vc0[0];
+        s_actor_matched_prev_pos[(tc * 3 + 0) * 2 + 1] = vc0[1];
+        s_actor_matched_prev_pos[(tc * 3 + 1) * 2 + 0] = vc1[0];
+        s_actor_matched_prev_pos[(tc * 3 + 1) * 2 + 1] = vc1[1];
+        s_actor_matched_prev_pos[(tc * 3 + 2) * 2 + 0] = vc2[0];
+        s_actor_matched_prev_pos[(tc * 3 + 2) * 2 + 1] = vc2[1];
+
+        float cur_cx = (vc0[0] + vc1[0] + vc2[0]) * (1.0f / 3.0f);
+        float cur_cy = (vc0[1] + vc1[1] + vc2[1]) * (1.0f / 3.0f);
+
+        /* Invariant texture signature of this triangle */
+        float tp_x = vc0[8],  tp_y = vc0[9];
+        float cl_x = vc0[10], cl_y = vc0[11];
+        float u0 = vc0[2], v0 = vc0[3];
+        float u1 = vc1[2], v1 = vc1[3];
+        float u2 = vc2[2], v2 = vc2[3];
+
+        float best_dist_sq = 48.0f * 48.0f; /* Max 48px screen-space motion between 30fps frames */
+        size_t best_tp = (size_t)-1;
+        int best_rot = 0;
+
+        for (size_t tp = 0; tp < n_prev_tris; tp++) {
+            const float *vp0 = &prev->verts[(tp * 3 + 0) * TEXV];
+            const float *vp1 = &prev->verts[(tp * 3 + 1) * TEXV];
+            const float *vp2 = &prev->verts[(tp * 3 + 2) * TEXV];
+
+            if (vp0[8] != tp_x || vp0[9] != tp_y || vp0[10] != cl_x || vp0[11] != cl_y)
+                continue;
+
+            int rot = -1;
+            /* Test all 3 cyclic permutations of triangle vertices */
+            if (fabsf(vp0[2] - u0) <= 1.5f && fabsf(vp0[3] - v0) <= 1.5f &&
+                fabsf(vp1[2] - u1) <= 1.5f && fabsf(vp1[3] - v1) <= 1.5f &&
+                fabsf(vp2[2] - u2) <= 1.5f && fabsf(vp2[3] - v2) <= 1.5f) {
+                rot = 0;
+            } else if (fabsf(vp1[2] - u0) <= 1.5f && fabsf(vp1[3] - v0) <= 1.5f &&
+                       fabsf(vp2[2] - u1) <= 1.5f && fabsf(vp2[3] - v1) <= 1.5f &&
+                       fabsf(vp0[2] - u2) <= 1.5f && fabsf(vp0[3] - v2) <= 1.5f) {
+                rot = 1;
+            } else if (fabsf(vp2[2] - u0) <= 1.5f && fabsf(vp2[3] - v0) <= 1.5f &&
+                       fabsf(vp0[2] - u1) <= 1.5f && fabsf(vp0[3] - v1) <= 1.5f &&
+                       fabsf(vp1[2] - u2) <= 1.5f && fabsf(vp1[3] - v2) <= 1.5f) {
+                rot = 2;
+            }
+
+            if (rot < 0) continue;
+
+            float prev_cx = (vp0[0] + vp1[0] + vp2[0]) * (1.0f / 3.0f);
+            float prev_cy = (vp0[1] + vp1[1] + vp2[1]) * (1.0f / 3.0f);
+            float dx = cur_cx - prev_cx;
+            float dy = cur_cy - prev_cy;
+            float d2 = dx * dx + dy * dy;
+            if (d2 < best_dist_sq) {
+                best_dist_sq = d2;
+                best_tp = tp;
+                best_rot = rot;
+            }
+        }
+
+        if (best_tp != (size_t)-1) {
+            const float *m0 = &prev->verts[(best_tp * 3 + best_rot) * TEXV];
+            const float *m1 = &prev->verts[(best_tp * 3 + ((best_rot + 1) % 3)) * TEXV];
+            const float *m2 = &prev->verts[(best_tp * 3 + ((best_rot + 2) % 3)) * TEXV];
+            /* Individual vertex sanity check (< 56px per vertex) */
+            if (fabsf(vc0[0] - m0[0]) < 56.0f && fabsf(vc0[1] - m0[1]) < 56.0f &&
+                fabsf(vc1[0] - m1[0]) < 56.0f && fabsf(vc1[1] - m1[1]) < 56.0f &&
+                fabsf(vc2[0] - m2[0]) < 56.0f && fabsf(vc2[1] - m2[1]) < 56.0f) {
+                s_actor_matched_prev_pos[(tc * 3 + 0) * 2 + 0] = m0[0];
+                s_actor_matched_prev_pos[(tc * 3 + 0) * 2 + 1] = m0[1];
+                s_actor_matched_prev_pos[(tc * 3 + 1) * 2 + 0] = m1[0];
+                s_actor_matched_prev_pos[(tc * 3 + 1) * 2 + 1] = m1[1];
+                s_actor_matched_prev_pos[(tc * 3 + 2) * 2 + 0] = m2[0];
+                s_actor_matched_prev_pos[(tc * 3 + 2) * 2 + 1] = m2[1];
+                s_actor_matched_tris++;
+            }
+        }
+    }
+}
