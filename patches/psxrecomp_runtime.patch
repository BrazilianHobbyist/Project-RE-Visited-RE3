+static void re3_quick_weapon_switch(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    int weapon_indices[10];
+    int weapon_count = 0;
+    for (int i = 0; i < max_slots; ++i) {
+        if (re3_is_weapon(slots[i].id)) {
+            weapon_indices[weapon_count++] = i;
+        }
+    }
+
+    if (weapon_count == 0) {
+        host_osd_push("Nenhuma arma no inventario!", 1200);
+        return;
+    }
+    if (weapon_count == 1) {
+        char msg[64];
+        std::snprintf(msg, sizeof(msg), "Apenas 1 arma: %s (%d)",
+                      re3_get_item_name(slots[weapon_indices[0]].id),
+                      (int)slots[weapon_indices[0]].count);
+        host_osd_push(msg, 1200);
+        return;
+    }
+
+    int target_idx = -1;
+    for (int w = 1; w < weapon_count; ++w) {
+        if (weapon_indices[w] > 0) {
+            target_idx = weapon_indices[w];
+            break;
+        }
+    }
+    if (target_idx == -1) target_idx = weapon_indices[1];
+
+    RE3ItemSlot temp = slots[0];
+    slots[0] = slots[target_idx];
+    slots[target_idx] = temp;
+
+    slots[0].attr = 0x80;
+    if (slots[target_idx].attr == 0x80) slots[target_idx].attr = 0x00;
+    ram[0x000D2535] = slots[0].id;
+
+    char msg[64];
+    std::snprintf(msg, sizeof(msg), "Equipado: %s (%d)",
+                  re3_get_item_name(slots[0].id), (int)slots[0].count);
+    host_osd_push(msg, 1500);
+}
+
+static void re3_quick_reload(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    int wep_idx = -1;
+    if (re3_is_weapon(slots[0].id)) {
+        wep_idx = 0;
+    } else {
+        for (int i = 0; i < max_slots; ++i) {
+            if (re3_is_weapon(slots[i].id)) {
+                wep_idx = i;
+                break;
+            }
+        }
+    }
+
+    if (wep_idx == -1) {
+        host_osd_push("Nenhuma arma no inventario!", 1000);
+        return;
+    }
+
+    uint8_t wep_id = slots[wep_idx].id;
+    if (wep_id == 0x01) {
+        host_osd_push("Faca de combate nao usa municao!", 1000);
+        return;
+    }
+    if (wep_id == 0x0A || wep_id == 0x0B) {
+        host_osd_push("Arma pesada com municao infinita!", 1000);
+        return;
+    }
+
+    uint8_t ammo_id1 = 0, ammo_id2 = 0;
+    int max_ammo = 0;
+    if (wep_id == 0x02 || wep_id == 0x03 || wep_id == 0x0D) {
+        ammo_id1 = 0x15; // Handgun Bullets
+        ammo_id2 = 0x24; // Enhanced Handgun Bullets
+        max_ammo = 15;
+    } else if (wep_id == 0x04 || wep_id == 0x0E) {
+        ammo_id1 = 0x17; // Shotgun Shells
+        ammo_id2 = 0x25; // Enhanced Shotgun Shells
+        max_ammo = (wep_id == 0x0E) ? 8 : 7;
+    } else if (wep_id == 0x05) {
+        ammo_id1 = 0x16; // Magnum Bullets
+        max_ammo = 6;
+    } else if (wep_id == 0x06) {
+        ammo_id1 = 0x18; // Grenade normal
+        max_ammo = 6;
+    } else if (wep_id == 0x07) {
+        ammo_id1 = 0x19; // Grenade flame
+        max_ammo = 6;
+    } else if (wep_id == 0x08) {
+        ammo_id1 = 0x1A; // Grenade acid
+        max_ammo = 6;
+    } else if (wep_id == 0x09) {
+        ammo_id1 = 0x1B; // Grenade freeze
+        max_ammo = 6;
+    } else if (wep_id == 0x0C) {
+        ammo_id1 = 0x1F; // Mine Thrower
+        max_ammo = 6;
+    } else if (wep_id == 0x0E || wep_id == 0x0F) {
+        ammo_id1 = 0x22; // Assault rifle
+        max_ammo = 100;
+    }
+
+    if (max_ammo == 0) return;
+    if (slots[wep_idx].count >= max_ammo) {
+        char msg[64];
+        std::snprintf(msg, sizeof(msg), "Arma ja cheia! (%d/%d)", (int)slots[wep_idx].count, max_ammo);
+        host_osd_push(msg, 1000);
+        return;
+    }
+
+    int needed = max_ammo - (int)slots[wep_idx].count;
+    int reloaded = 0;
+
+    for (int i = 0; i < max_slots; ++i) {
+        if (i == wep_idx) continue;
+        if ((slots[i].id == ammo_id1 || (ammo_id2 && slots[i].id == ammo_id2)) && slots[i].count > 0) {
+            int take = (slots[i].count < needed) ? slots[i].count : needed;
+            slots[wep_idx].count += (uint8_t)take;
+            slots[i].count -= (uint8_t)take;
+            needed -= take;
+            reloaded += take;
+            if (slots[i].count == 0) {
+                slots[i].id = 0;
+                slots[i].count = 0;
+                slots[i].attr = 0;
+                slots[i].pad = 0;
+            }
+            if (needed <= 0) break;
+        }
+    }
+
+    if (reloaded > 0) {
+        char msg[64];
+        std::snprintf(msg, sizeof(msg), "Recarregado: %s (%d/%d)",
+                      re3_get_item_name(wep_id), (int)slots[wep_idx].count, max_ammo);
+        host_osd_push(msg, 1500);
+    } else {
+        host_osd_push("Sem municao no inventario!", 1200);
+    }
+}
+
+static void re3_combine_ammo_stacks(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    for (int i = 0; i < max_slots; ++i) {
+        if (slots[i].id == 0 || !re3_is_ammo(slots[i].id)) continue;
+        for (int j = i + 1; j < max_slots; ++j) {
+            if (slots[j].id == slots[i].id && slots[j].count > 0) {
+                int space = 255 - (int)slots[i].count;
+                if (space > 0) {
+                    int take = (slots[j].count <= space) ? slots[j].count : space;
+                    slots[i].count += (uint8_t)take;
+                    slots[j].count -= (uint8_t)take;
+                    if (slots[j].count == 0) {
+                        slots[j].id = 0;
+                        slots[j].count = 0;
+                        slots[j].attr = 0;
+                        slots[j].pad = 0;
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void re3_max_out_ammo(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    int touched = 0;
+    for (int i = 0; i < max_slots; ++i) {
+        if (re3_is_ammo(slots[i].id)) {
+            slots[i].count = 255;
+            touched++;
+        } else if (re3_is_weapon(slots[i].id) && slots[i].id != 0x01) {
+            uint8_t wid = slots[i].id;
+            if (wid == 0x02 || wid == 0x03 || wid == 0x0D) slots[i].count = 15;
+            else if (wid == 0x04) slots[i].count = 7;
+            else if (wid == 0x0E) slots[i].count = 8;
+            else if (wid == 0x05 || (wid >= 0x06 && wid <= 0x09) || wid == 0x0C) slots[i].count = 6;
+            else if (wid == 0x0E || wid == 0x0F) slots[i].count = 100;
+            touched++;
+        }
+    }
+    if (touched > 0) {
+        host_osd_push("Municao no Maximo (255 balas)!", 1500);
+    }
+}
