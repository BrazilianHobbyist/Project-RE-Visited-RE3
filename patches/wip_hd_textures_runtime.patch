+const char* re3_hd_bg_resolve_file(uint8_t stage, uint8_t room, uint8_t cut,
+                                   char* out_path, size_t max_len) {
+    if (!out_path || max_len == 0) return nullptr;
+    out_path[0] = '\0';
+
+    std::string base_pack = s_pack_path;
+    if (base_pack.empty()) {
+        const char* p = re3_textures_get_pack_path();
+        if (p) base_pack = p;
+    }
+
+    if (base_pack.empty()) return nullptr;
+
+    // Prevent directory traversal
+    if (base_pack.find("..") != std::string::npos) return nullptr;
+
+    fs::path pack_fs(base_pack);
+    fs::path bg_dir = pack_fs / "backgrounds";
+    std::error_code ec;
+    if (!fs::exists(bg_dir, ec) || !fs::is_directory(bg_dir, ec)) return nullptr;
+
+    // Security path traversal check: canonical path must stay within pack bounds
+    fs::path norm_bg = fs::weakly_canonical(bg_dir, ec);
+    fs::path norm_pack = fs::weakly_canonical(pack_fs, ec);
+    if (norm_bg.generic_string().rfind(norm_pack.generic_string(), 0) != 0) {
+        return nullptr;
+    }
+
+    std::vector<std::string> candidates;
+    char cand[64];
+    uint8_t s_nib = stage & 0x0F;
+
+    // 1. R<stage><room:02X>_<cut:02X>.png
+    std::snprintf(cand, sizeof(cand), "R%1X%02X_%02X.png", s_nib, room, cut);
+    candidates.push_back(cand);
+
+    // 2. R<stage><room:02X>_<cut>.png
+    std::snprintf(cand, sizeof(cand), "R%1X%02X_%u.png", s_nib, room, cut);
+    if (std::find(candidates.begin(), candidates.end(), cand) == candidates.end())
+        candidates.push_back(cand);
+
+    // 3. r<stage><room:02x>_<cut:02x>.png
+    std::snprintf(cand, sizeof(cand), "r%1x%02x_%02x.png", s_nib, room, cut);
+    if (std::find(candidates.begin(), candidates.end(), cand) == candidates.end())
+        candidates.push_back(cand);
+
+    // 4. r<stage><room:02x>_<cut>.png
+    std::snprintf(cand, sizeof(cand), "r%1x%02x_%u.png", s_nib, room, cut);
+    if (std::find(candidates.begin(), candidates.end(), cand) == candidates.end())
+        candidates.push_back(cand);
+
+    if (stage > 0x0F) {
+        std::snprintf(cand, sizeof(cand), "R%X%02X_%02X.png", stage, room, cut);
+        if (std::find(candidates.begin(), candidates.end(), cand) == candidates.end())
+            candidates.push_back(cand);
+    }
+
+    // 5. Uppercase .PNG variations
+    size_t base_count = candidates.size();
+    for (size_t i = 0; i < base_count; ++i) {
+        std::string upper_ext = candidates[i];
+        if (upper_ext.size() >= 4 && upper_ext.substr(upper_ext.size() - 4) == ".png") {
+            upper_ext.replace(upper_ext.size() - 4, 4, ".PNG");
+            if (std::find(candidates.begin(), candidates.end(), upper_ext) == candidates.end())
+                candidates.push_back(upper_ext);
+        }
+    }
+
+    // Direct filesystem lookup
+    for (const auto& name : candidates) {
+        fs::path p = bg_dir / name;
+        if (fs::exists(p, ec) && fs::is_regular_file(p, ec)) {
+            std::string p_str = p.generic_string();
+            std::strncpy(out_path, p_str.c_str(), max_len - 1);
+            out_path[max_len - 1] = '\0';
+            return out_path;
+        }
+    }
+
+    // Fallback case-insensitive scan of backgrounds directory
+    for (const auto& dir_entry : fs::directory_iterator(bg_dir, ec)) {
+        if (dir_entry.is_regular_file(ec)) {
+            std::string actual_file = dir_entry.path().filename().generic_string();
+            std::string lower_actual = actual_file;
+            std::transform(lower_actual.begin(), lower_actual.end(), lower_actual.begin(), ::tolower);
+
+            for (const auto& cand_name : candidates) {
+                std::string lower_cand = cand_name;
+                std::transform(lower_cand.begin(), lower_cand.end(), lower_cand.begin(), ::tolower);
+                if (lower_actual == lower_cand) {
+                    std::string p_str = dir_entry.path().generic_string();
+                    std::strncpy(out_path, p_str.c_str(), max_len - 1);
+                    out_path[max_len - 1] = '\0';
+                    return out_path;
+                }
+            }
+        }
+    }
+
+    return nullptr;
+}
+
+void re3_hd_bg_init(const char* pack_path) {
+    re3_hd_bg_shutdown();
+
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        if (pack_path && pack_path[0] != '\0') {
+            s_pack_path = pack_path;
+            for (char& c : s_pack_path) {
+                if (c == '\\') c = '/';
+            }
+            while (s_pack_path.size() > 1 && s_pack_path.back() == '/') {
+                s_pack_path.pop_back();
+            }
+        } else {
+            s_pack_path.clear();
+        }
+
+        s_active_stage = 0xFF;
+        s_active_room  = 0xFF;
+        s_active_cut   = 0xFF;
+        s_active_gl_tex = 0;
+        s_queue.clear();
+        s_entries.clear();
+        s_lru_list.clear();
+
+        s_metrics_hits = 0;
+        s_metrics_misses = 0;
+        s_metrics_evictions = 0;
+        s_metrics_prefetches = 0;
+
+        s_stop = false;
+        s_worker = std::thread(worker_thread_func);
+    }
+}
+
+void re3_hd_bg_shutdown(void) {
+    s_stop = true;
+    s_cv.notify_all();
+
+    if (s_worker.joinable()) {
+        s_worker.join();
+    }
+
+    std::lock_guard<std::mutex> lock(s_mutex);
+
+    // Free GL resources if context is valid
+    for (auto& kv : s_entries) {
+        if (kv.second.gl_tex_id != 0) {
+            glDeleteTextures(1, &kv.second.gl_tex_id);
+            kv.second.gl_tex_id = 0;
+        }
+        kv.second.staging_pixels.reset();
+    }
+
+    if (s_blit_vao && p_glDeleteVertexArrays) {
+        p_glDeleteVertexArrays(1, &s_blit_vao);
+        s_blit_vao = 0;
+    }
+    if (s_blit_program && p_glDeleteProgram) {
+        p_glDeleteProgram(s_blit_program);
+        s_blit_program = 0;
+    }
+
+    s_queue.clear();
+    s_entries.clear();
+    s_lru_list.clear();
+    s_active_gl_tex = 0;
+    s_active_stage = 0xFF;
+    s_active_room  = 0xFF;
+    s_active_cut   = 0xFF;
+}
+
+void re3_hd_bg_on_room_change(uint8_t stage, uint8_t room, uint8_t cut) {
+    if (!g_re3_tex_config.hd_backgrounds) return;
+
+    std::lock_guard<std::mutex> lock(s_mutex);
+
+    bool room_changed = (stage != s_active_stage || room != s_active_room);
+    s_active_stage = stage;
+    s_active_room  = room;
+    s_active_cut   = cut;
+
+    uint32_t active_key = bg_make_key(stage, room, cut);
+
+    // Track hit vs miss on the requested cut
+    auto cur_it = s_entries.find(active_key);
+    if (cur_it != s_entries.end() &&
+        (cur_it->second.state == BgState::ReadyGL || cur_it->second.state == BgState::ReadyRAM)) {
+        s_metrics_hits++;
+    } else {
+        s_metrics_misses++;
+    }
+
+    // Eager room cut prefetching when room changes
+    if (room_changed) {
+        std::string base_pack = s_pack_path;
+        if (base_pack.empty()) {
+            const char* p = re3_textures_get_pack_path();
+            if (p) base_pack = p;
+        }
+
+        if (!base_pack.empty() && base_pack.find("..") == std::string::npos) {
+            fs::path bg_dir = fs::path(base_pack) / "backgrounds";
+            std::error_code ec;
+            if (fs::exists(bg_dir, ec) && fs::is_directory(bg_dir, ec)) {
+                char prefix_buf[32];
+                std::snprintf(prefix_buf, sizeof(prefix_buf), "r%1x%02x_", stage & 0x0F, room);
+                std::string prefix = prefix_buf;
+
+                for (const auto& item : fs::directory_iterator(bg_dir, ec)) {
+                    if (item.is_regular_file(ec)) {
+                        std::string fname = item.path().filename().generic_string();
+                        std::string fl = fname;
+                        std::transform(fl.begin(), fl.end(), fl.begin(), ::tolower);
+
+                        if (fl.rfind(prefix, 0) == 0 && str_ends_with(fl, ".png")) {
+                            std::string cut_str = fl.substr(prefix.size(), fl.size() - prefix.size() - 4);
+                            int cut_val = -1;
+                            try {
+                                cut_val = std::stoi(cut_str, nullptr, 16);
+                            } catch (...) {
+                                try {
+                                    cut_val = std::stoi(cut_str, nullptr, 10);
+                                } catch (...) {}
+                            }
+
+                            if (cut_val >= 0 && cut_val <= 255) {
+                                uint8_t c_u8 = static_cast<uint8_t>(cut_val);
+                                uint32_t k = bg_make_key(stage, room, c_u8);
+                                auto ent_find = s_entries.find(k);
+                                if (ent_find == s_entries.end() || ent_find->second.state == BgState::None) {
+                                    if (ent_find == s_entries.end()) {
+                                        BgTextureEntry ent;
+                                        ent.key = k;
+                                        ent.stage = stage;
+                                        ent.room = room;
+                                        ent.cut = c_u8;
+                                        ent.filepath = item.path().generic_string();
+                                        ent.state = BgState::Queued;
+                                        s_entries[k] = std::move(ent);
+                                    } else {
+                                        ent_find->second.state = BgState::Queued;
+                                        ent_find->second.filepath = item.path().generic_string();
+                                    }
+                                    s_queue.push_back(k);
+                                    s_metrics_prefetches++;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    // Ensure active cut is resolved and queued with high priority if not yet present
+    auto act_it = s_entries.find(active_key);
+    if (act_it == s_entries.end() || act_it->second.state == BgState::None) {
+        char resolved[1024];
+        if (re3_hd_bg_resolve_file(stage, room, cut, resolved, sizeof(resolved))) {
+            BgTextureEntry ent;
+            ent.key = active_key;
+            ent.stage = stage;
+            ent.room = room;
+            ent.cut = cut;
+            ent.filepath = resolved;
+            ent.state = BgState::Queued;
+            s_entries[active_key] = std::move(ent);
+
+            // Put active cut at the FRONT of the queue for immediate loading
+            s_queue.push_front(active_key);
+            s_metrics_prefetches++;
+        }
+    } else if (act_it->second.state == BgState::Queued) {
+        // If already queued at back by room prefetch, elevate to front for immediate decoding
+        auto q_it = std::find(s_queue.begin(), s_queue.end(), active_key);
+        if (q_it != s_queue.end()) {
+            s_queue.erase(q_it);
+            s_queue.push_front(active_key);
+        }
+    }
+
+    s_cv.notify_one();
+}
+
+bool re3_hd_bg_has_hd_current(void) {
+    if (!g_re3_tex_config.hd_backgrounds) return false;
+    if (!re3_textures_is_pack_valid()) return false;
+
+    std::lock_guard<std::mutex> lock(s_mutex);
+    uint32_t key = bg_make_key(s_active_stage, s_active_room, s_active_cut);
+    auto it = s_entries.find(key);
+    if (it == s_entries.end()) return false;
+    return (it->second.gl_tex_id != 0 || it->second.state == BgState::ReadyRAM);
+}
+
+uint32_t re3_hd_bg_get_current_gl_tex(void) {
+    if (!g_re3_tex_config.hd_backgrounds) return 0;
+
+    std::lock_guard<std::mutex> lock(s_mutex);
+    uint32_t key = bg_make_key(s_active_stage, s_active_room, s_active_cut);
+    auto it = s_entries.find(key);
+    if (it == s_entries.end()) return 0;
+
+    if (it->second.gl_tex_id == 0 && it->second.state == BgState::ReadyRAM) {
+        upload_entry_to_gl(it->second);
+    } else if (it->second.gl_tex_id != 0) {
+        if (!s_lru_list.empty() && s_lru_list.front() != key) {
+            s_lru_list.remove(key);
+            s_lru_list.push_front(key);
+        }
+    }
+    s_active_gl_tex = it->second.gl_tex_id;
+    return s_active_gl_tex;
+}
+
+bool re3_hd_bg_render_current(uint32_t fbo, int width, int height) {
+    if (!g_re3_tex_config.hd_backgrounds) return false;
+    if (!re3_textures_is_pack_valid()) return false;
+
+    uint32_t tex = re3_hd_bg_get_current_gl_tex();
+    if (tex == 0) return false;
+
+    // Headless / non-GL context safe-check
+    if (!SDL_GL_GetCurrentContext()) {
+        return true;
+    }
+
+    if (!init_blit_pipeline()) {
+        return true;
+    }
+
+    // Target FBO binding
+    if (fbo != 0 && p_glBindFramebuffer) {
+        p_glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    }
+
+    GLint cur_vp[4] = {0, 0, 0, 0};
+    glGetIntegerv(GL_VIEWPORT, cur_vp);
+    if (width > 0 && height > 0 && !(cur_vp[2] == width && cur_vp[3] == height)) {
+        glViewport(0, 0, width, height);
+    }
+
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_BLEND);
+
+    p_glUseProgram(s_blit_program);
+    p_glUniform1i(s_u_tex, 0);
+
+    if (p_glActiveTexture) {
+        p_glActiveTexture(GL_TEXTURE0);
+    }
+    glBindTexture(GL_TEXTURE_2D, tex);
+
+    p_glBindVertexArray(s_blit_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    p_glBindVertexArray(0);
+
+    p_glUseProgram(0);
+    glBindTexture(GL_TEXTURE_2D, 0);
+
+    return true;
+}
+
+void re3_hd_bg_get_screen_uv(int x, int y, int w, int h, float out_uv[4]) {
+    if (!out_uv) return;
+    out_uv[0] = static_cast<float>(x) / 320.0f;
+    out_uv[1] = static_cast<float>(y) / 240.0f;
+    out_uv[2] = static_cast<float>(x + w) / 320.0f;
+    out_uv[3] = static_cast<float>(y + h) / 240.0f;
+}
+
+void re3_hd_bg_get_metrics(re3_hd_bg_metrics_t* out_metrics) {
+    if (!out_metrics) return;
+    std::lock_guard<std::mutex> lock(s_mutex);
+    out_metrics->hits = s_metrics_hits;
+    out_metrics->misses = s_metrics_misses;
+    out_metrics->evictions = s_metrics_evictions;
+    out_metrics->prefetches = s_metrics_prefetches;
+    out_metrics->memory_used_bytes = s_entries.size() * sizeof(BgTextureEntry);
+    out_metrics->memory_budget_bytes = 256 * 1024 * 1024;
+    out_metrics->active_entries = static_cast<uint32_t>(s_entries.size());
+}
