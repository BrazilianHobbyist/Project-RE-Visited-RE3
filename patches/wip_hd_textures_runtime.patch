+#include <cstdio>
+#include <cstring>
+#include <algorithm>
+#include <mutex>
+
+namespace fs = std::filesystem;
+
+#ifndef GL_TEXTURE_MAX_ANISOTROPY_EXT
+#define GL_TEXTURE_MAX_ANISOTROPY_EXT 0x84FE
+#endif
+#ifndef GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT
+#define GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT 0x84FF
+#endif
+#ifndef GL_CLAMP_TO_EDGE
+#define GL_CLAMP_TO_EDGE 0x812F
+#endif
+#ifndef GL_LINEAR_MIPMAP_LINEAR
+#define GL_LINEAR_MIPMAP_LINEAR 0x2703
+#endif
+#ifndef GL_RGBA8
+#define GL_RGBA8 0x8058
+#endif
+
+typedef void (APIENTRY *PFN_glGenerateMipmap)(GLenum target);
+
+#pragma pack(push, 1)
+typedef struct {
+    uint16_t tpage;
+    uint16_t clut;
+    uint16_t u_min;
+    uint16_t v_min;
+    uint16_t u_max;
+    uint16_t v_max;
+    uint32_t flags;
+} re3_tex_meta_header_t;
+#pragma pack(pop)
+
+namespace {
+
+static bool s_initialized = false;
+static std::string s_pack_path;
+static std::string s_replacements_dir;
+
+static std::unordered_map<uint64_t, uint32_t> s_tex_cache;
+static std::unordered_set<uint64_t> s_missing_cache;
+static re3_hd_tex_metrics_t s_metrics = {0, 0, 0, 0};
+static std::mutex s_tex_mutex;
+
+static PFN_glGenerateMipmap p_glGenerateMipmap = nullptr;
+static float s_max_anisotropy = 1.0f;
+static bool s_gl_caps_queried = false;
+
+static void query_gl_caps() {
+    if (s_gl_caps_queried) return;
+
+    p_glGenerateMipmap = (PFN_glGenerateMipmap)SDL_GL_GetProcAddress("glGenerateMipmap");
+
+    GLfloat max_aniso = 1.0f;
+    glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, &max_aniso);
+    while (glGetError() != GL_NO_ERROR) {}
+
+    // Clamp between 1.0x and 16.0x as required by Project Specifications
+    if (max_aniso > 16.0f) max_aniso = 16.0f;
+    if (max_aniso < 1.0f)  max_aniso = 1.0f;
+    s_max_anisotropy = max_aniso;
+
+    s_gl_caps_queried = true;
+}
+
+static std::string resolve_replacement_file(uint64_t hash) {
+    if (s_replacements_dir.empty()) return "";
+
+    std::error_code ec;
+    fs::path base_dir(s_replacements_dir);
+    if (!fs::exists(base_dir, ec) || !fs::is_directory(base_dir, ec)) return "";
+
+    // Candidate patterns: 16-hex padded lowercase, uppercase, unpadded, and .PNG variations
+    char c1[32], c2[32], c3[32], c4[32];
+    std::snprintf(c1, sizeof(c1), "%016llx.png", (unsigned long long)hash);
+    std::snprintf(c2, sizeof(c2), "%016llX.png", (unsigned long long)hash);
+    std::snprintf(c3, sizeof(c3), "%llx.png", (unsigned long long)hash);
+    std::snprintf(c4, sizeof(c4), "%llX.png", (unsigned long long)hash);
+
+    const char* cand_names[] = { c1, c2, c3, c4 };
+    for (const char* name : cand_names) {
+        fs::path p = base_dir / name;
+        if (fs::exists(p, ec) && !fs::is_directory(p, ec)) {
+            return p.generic_string();
+        }
+        // Try uppercase extension (.PNG)
+        fs::path p_ext = p;
+        p_ext.replace_extension(".PNG");
+        if (fs::exists(p_ext, ec) && !fs::is_directory(p_ext, ec)) {
+            return p_ext.generic_string();
+        }
+    }
+
+    return "";
+}
+
+static uint32_t load_replacement_png(const char* filepath) {
+    query_gl_caps();
+
+    std::ifstream file(filepath, std::ios::binary | std::ios::ate);
+    if (!file.is_open()) return 0;
+
+    std::streamsize size = file.tellg();
+    if (size <= 8 || size > 64 * 1024 * 1024) return 0;
+
+    file.seekg(0, std::ios::beg);
+    std::vector<uint8_t> buffer(static_cast<size_t>(size));
+    if (!file.read(reinterpret_cast<char*>(buffer.data()), size)) return 0;
+
+    // Check PNG signature: 89 50 4E 47 0D 0A 1A 0A
+    if (buffer.size() < 8 ||
+        buffer[0] != 0x89 || buffer[1] != 'P' || buffer[2] != 'N' || buffer[3] != 'G' ||
+        buffer[4] != 0x0D || buffer[5] != 0x0A || buffer[6] != 0x1A || buffer[7] != 0x0A) {
+        return 0;
+    }
+
+    int w = 0, h = 0, comp = 0;
+    unsigned char* decoded = stbi_load_from_memory(buffer.data(), static_cast<int>(buffer.size()), &w, &h, &comp, 4);
+    if (!decoded || w <= 0 || h <= 0) {
+        if (decoded) stbi_image_free(decoded);
+        return 0;
+    }
+
+    GLuint tex_id = 0;
+    glGenTextures(1, &tex_id);
+    if (tex_id == 0) {
+        stbi_image_free(decoded);
+        return 0;
+    }
+
+    glBindTexture(GL_TEXTURE_2D, tex_id);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, decoded);
+    stbi_image_free(decoded);
+
+    // Mipmap generation and trilinear filtering
+    if (p_glGenerateMipmap) {
+        p_glGenerateMipmap(GL_TEXTURE_2D);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+    } else {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    }
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    // Anisotropic filtering up to 16x
+    if (s_max_anisotropy > 1.0f) {
+        glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAX_ANISOTROPY_EXT, s_max_anisotropy);
+    }
+
+    return tex_id;
+}
+
+} // anonymous namespace
+
+void re3_hd_tex_init(const char* pack_path) {
+    std::lock_guard<std::mutex> lock(s_tex_mutex);
+
+    s_tex_cache.clear();
+    s_missing_cache.clear();
+    s_metrics = {0, 0, 0, 0};
+
+    const re3_texture_config_t* cfg = re3_textures_get_config();
+    if (!cfg || !cfg->hd_models || !pack_path || pack_path[0] == '\0') {
+        s_initialized = false;
+        s_pack_path.clear();
+        s_replacements_dir.clear();
+        return;
+    }
+
+    s_pack_path = pack_path;
+    fs::path rep_path = fs::path(s_pack_path) / "replacements";
+    s_replacements_dir = rep_path.generic_string();
+
+    std::error_code ec;
+    if (fs::exists(rep_path, ec) && fs::is_directory(rep_path, ec)) {
+        s_initialized = true;
+        std::fprintf(stdout, "psxrecomp: [HD Textures] Initialized. Replacements path: \"%s\"\n",
+                     s_replacements_dir.c_str());
+    } else {
+        s_initialized = false;
+        std::fprintf(stdout, "psxrecomp: [HD Textures] Replacements directory not found at \"%s\". Fallback active.\n",
+                     s_replacements_dir.c_str());
+    }
+}
+
+void re3_hd_tex_shutdown(void) {
+    std::lock_guard<std::mutex> lock(s_tex_mutex);
+
+    if (!s_tex_cache.empty()) {
+        for (const auto& pair : s_tex_cache) {
+            if (pair.second != 0) {
+                GLuint tex = pair.second;
+                glDeleteTextures(1, &tex);
+            }
+        }
+    }
+    s_tex_cache.clear();
+    s_missing_cache.clear();
+    s_metrics = {0, 0, 0, 0};
+    s_initialized = false;
+    s_pack_path.clear();
+    s_replacements_dir.clear();
+    std::fprintf(stdout, "psxrecomp: [HD Textures] Shutdown complete. All textures released.\n");
+}
+
+bool re3_hd_tex_is_active(void) {
+    const re3_texture_config_t* cfg = re3_textures_get_config();
+    return s_initialized && cfg && cfg->hd_models;
+}
+
+uint64_t re3_hd_tex_compute_hash_bytes(
+    uint16_t tpage,
+    uint16_t clut,
+    const uint8_t lim[4],
+    const uint16_t* palette,
+    int palette_len,
+    const void* vram_pixels,
+    size_t pixel_bytes
+) {
+    static_assert(sizeof(re3_tex_meta_header_t) == 16, "re3_tex_meta_header_t must be exactly 16 bytes (<HHHHHHI)");
+
+    re3_tex_meta_header_t hdr;
+    hdr.tpage = tpage;
+    hdr.clut  = clut;
+    hdr.u_min = lim ? (uint16_t)lim[0] : 0u;
+    hdr.v_min = lim ? (uint16_t)lim[1] : 0u;
+    hdr.u_max = lim ? (uint16_t)lim[2] : 255u;
+    hdr.v_max = lim ? (uint16_t)lim[3] : 255u;
+    hdr.flags = 0u;
+
+    XXH64_state_t state;
+    XXH64_reset(&state, 0);
+    XXH64_update(&state, &hdr, sizeof(hdr));
+
+    int depth = (tpage >> 7) & 3;
+    if (depth < 2) {
+        int pal_count = (depth == 0) ? 16 : 256;
+        if (palette && palette_len > 0) {
+            int to_copy = palette_len < pal_count ? palette_len : pal_count;
+            XXH64_update(&state, palette, (size_t)to_copy * sizeof(uint16_t));
+            if (to_copy < pal_count) {
+                uint16_t zero_pad[256] = {0};
+                XXH64_update(&state, zero_pad, (size_t)(pal_count - to_copy) * sizeof(uint16_t));
+            }
+        } else {
+            uint16_t zero_pad[256] = {0};
+            XXH64_update(&state, zero_pad, (size_t)pal_count * sizeof(uint16_t));
+        }
+    }
+
+    if (vram_pixels && pixel_bytes > 0) {
+        XXH64_update(&state, vram_pixels, pixel_bytes);
+    }
+
+    return XXH64_digest(&state);
+}
+
+uint64_t re3_hd_tex_compute_hash(
+    uint16_t tpage,
+    uint16_t clut,
+    const uint8_t lim[4],
+    const uint16_t* palette,
+    int palette_len,
+    const uint16_t* vram_pixels,
+    int pixel_words
+) {
+    size_t bytes = (pixel_words > 0) ? ((size_t)pixel_words * sizeof(uint16_t)) : 0;
+    return re3_hd_tex_compute_hash_bytes(tpage, clut, lim, palette, palette_len, vram_pixels, bytes);
+}
+
+uint64_t re3_hd_tex_compute_from_vram(
+    uint16_t tpage,
+    uint16_t clut,
+    const int lim[4],
+    const uint16_t* vram
+) {
+    if (!vram) return 0;
+
+    static_assert(sizeof(re3_tex_meta_header_t) == 16, "re3_tex_meta_header_t must be exactly 16 bytes (<HHHHHHI)");
+
+    re3_tex_meta_header_t hdr;
+    hdr.tpage = tpage;
+    hdr.clut  = clut;
+    hdr.u_min = lim ? (uint16_t)std::clamp(lim[0], 0, 255) : 0u;
+    hdr.v_min = lim ? (uint16_t)std::clamp(lim[1], 0, 255) : 0u;
+    hdr.u_max = lim ? (uint16_t)std::clamp(lim[2], 0, 255) : 255u;
+    hdr.v_max = lim ? (uint16_t)std::clamp(lim[3], 0, 255) : 255u;
+    hdr.flags = 0u;
+
+    XXH64_state_t state;
+    XXH64_reset(&state, 0);
+    XXH64_update(&state, &hdr, sizeof(hdr));
+
+    int depth = (tpage >> 7) & 3;
+    if (depth < 2) {
+        int pal_count = (depth == 0) ? 16 : 256;
+        uint16_t clut_x = (clut & 0x3F) * 16;
+        uint16_t clut_y = (clut >> 6) & 0x1FF;
+        uint16_t pal_buf[256];
+        const uint16_t* pal_row = &vram[clut_y * 1024u];
+        for (int i = 0; i < pal_count; i++) {
+            pal_buf[i] = pal_row[(clut_x + i) & 1023u];
+        }
+        XXH64_update(&state, pal_buf, (size_t)pal_count * sizeof(uint16_t));
+    }
+
+    // Stream bounding rect rows from VRAM without heap allocation
+    int base_x = (tpage & 0xF) * 64;
+    int base_y = ((tpage >> 4) & 1) * 256;
+    int px_shift = (depth == 0) ? 2 : ((depth == 1) ? 1 : 0);
+    int word_start_x = base_x + (hdr.u_min >> px_shift);
+    int word_end_x   = base_x + (hdr.u_max >> px_shift);
+    int row_words    = word_end_x - word_start_x + 1;
+    if (row_words > 0 && row_words <= 1024) {
+        for (uint16_t v = hdr.v_min; v <= hdr.v_max; v++) {
+            int y = (base_y + v) & 511;
+            int x = word_start_x & 1023;
+            if (x + row_words <= 1024) {
+                XXH64_update(&state, &vram[y * 1024 + x], (size_t)row_words * sizeof(uint16_t));
+            } else {
+                int first_chunk = 1024 - x;
+                int second_chunk = row_words - first_chunk;
+                XXH64_update(&state, &vram[y * 1024 + x], (size_t)first_chunk * sizeof(uint16_t));
+                XXH64_update(&state, &vram[y * 1024], (size_t)second_chunk * sizeof(uint16_t));
+            }
+        }
+    }
+
+    return XXH64_digest(&state);
+}
+
+uint32_t re3_hd_tex_bind_replacement(uint64_t hash) {
+    if (!re3_hd_tex_is_active() || hash == 0) return 0;
+
+    std::lock_guard<std::mutex> lock(s_tex_mutex);
+
+    // 1. Positive cache hit
+    auto hit = s_tex_cache.find(hash);
+    if (hit != s_tex_cache.end()) {
+        s_metrics.cache_hits++;
+        return hit->second;
+    }
+
+    // 2. Negative cache hit (known missing replacement)
+    if (s_missing_cache.find(hash) != s_missing_cache.end()) {
+        s_metrics.cache_misses++;
+        return 0;
+    }
+
+    // 3. Resolve replacement on disk
+    std::string file = resolve_replacement_file(hash);
+    if (file.empty()) {
+        s_missing_cache.insert(hash);
+        s_metrics.cache_misses++;
+        return 0;
+    }
+
+    // 4. Decode PNG and upload to GL texture
+    uint32_t tex_id = load_replacement_png(file.c_str());
+    if (tex_id == 0) {
+        s_missing_cache.insert(hash);
+        s_metrics.cache_misses++;
+        return 0;
+    }
+
+    // 5. Store in positive cache
+    s_tex_cache[hash] = tex_id;
+    s_metrics.disk_loads++;
+    s_metrics.active_textures = static_cast<uint32_t>(s_tex_cache.size());
+    return tex_id;
+}
+
+void re3_hd_tex_dump_if_enabled(
+    uint64_t hash,
+    uint16_t tpage,
+    uint16_t clut,
+    int w,
+    int h,
+    const uint32_t* rgba_pixels
+) {
+    const re3_texture_config_t* cfg = re3_textures_get_config();
+    if (!cfg || !cfg->dump_textures || !rgba_pixels || w <= 0 || h <= 0) {
+        return;
+    }
+
+    // Placeholder / base export hook for Milestone 5 tooling
+    fs::path dump_dir = fs::path(re3_textures_get_base_path()) / "dump" / "textures";
+    std::error_code ec;
+    fs::create_directories(dump_dir, ec);
+}
+
+void re3_hd_tex_get_metrics(re3_hd_tex_metrics_t* out_metrics) {
+    std::lock_guard<std::mutex> lock(s_tex_mutex);
+    if (out_metrics) {
+        *out_metrics = s_metrics;
+    }
+}
