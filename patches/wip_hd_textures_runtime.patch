+std::string s_pack_path;
+uint8_t s_active_stage = 0xFF;
+uint8_t s_active_room  = 0xFF;
+uint8_t s_active_cut   = 0xFF;
+uint32_t s_active_gl_tex = 0;
+
+std::deque<uint32_t> s_queue;
+std::unordered_map<uint32_t, BgTextureEntry> s_entries;
+std::list<uint32_t> s_lru_list;
+
+// Metrics
+uint64_t s_metrics_hits = 0;
+uint64_t s_metrics_misses = 0;
+uint64_t s_metrics_evictions = 0;
+uint64_t s_metrics_prefetches = 0;
