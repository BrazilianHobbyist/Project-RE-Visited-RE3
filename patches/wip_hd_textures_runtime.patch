+static const char* re3_get_item_name(uint8_t id) {
+    switch (id) {
+        case 0x01: return "Combat Knife";
+        case 0x02: return "Merc's Handgun (Eagle)";
+        case 0x03: return "Handgun (M92F)";
+        case 0x04: return "Shotgun (M3S)";
+        case 0x05: return "Magnum (M629C)";
+        case 0x06: return "Grenade Launcher (Normal)";
+        case 0x07: return "Grenade Launcher (Flame)";
+        case 0x08: return "Grenade Launcher (Acid)";
+        case 0x09: return "Grenade Launcher (Freeze)";
+        case 0x0A: return "Rocket Launcher";
+        case 0x0B: return "Gatling Gun";
+        case 0x0C: return "Mine Thrower";
+        case 0x0D: return "Custom Handgun";
+        case 0x0E: return "Assault Rifle (Manual)";
+        case 0x0F: return "Assault Rifle (Auto)";
+        case 0x15: return "Handgun Bullets";
+        case 0x16: return "Magnum Bullets";
+        case 0x17: return "Shotgun Shells";
+        case 0x18: return "Grenade Rounds (Normal)";
+        case 0x19: return "Flame Rounds";
+        case 0x1A: return "Acid Rounds";
+        case 0x1B: return "Freeze Rounds";
+        case 0x1F: return "Mine Thrower Bullets";
+        case 0x22: return "Assault Rifle Bullets";
+        case 0x24: return "Enhanced Handgun Bullets";
+        case 0x25: return "Enhanced Shotgun Shells";
+        case 0x80: return "Boutique Key";
+        case 0x81: return "Ink Ribbon";
+        default: return "Item";
+    }
+}
+
+static inline bool re3_is_weapon(uint8_t id) {
+    return (id >= 0x01 && id <= 0x0F);
+}
+
+static inline bool re3_is_ammo(uint8_t id) {
+    return (id >= 0x15 && id <= 0x1B) || id == 0x1F || id == 0x22 || id == 0x23 || id == 0x24 || id == 0x25;
+}
+
+static void re3_quick_weapon_switch(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    int weapon_indices[10];
+    int weapon_count = 0;
+    for (int i = 0; i < max_slots; ++i) {
+        if (re3_is_weapon(slots[i].id)) {
+            weapon_indices[weapon_count++] = i;
+        }
+    }
+
+    if (weapon_count == 0) {
+        host_osd_push("Nenhuma arma no inventario!", 1200);
+        return;
+    }
+    if (weapon_count == 1) {
+        char msg[64];
+        std::snprintf(msg, sizeof(msg), "Apenas 1 arma: %s (%d)",
+                      re3_get_item_name(slots[weapon_indices[0]].id),
+                      (int)slots[weapon_indices[0]].count);
+        host_osd_push(msg, 1200);
+        return;
+    }
+
+    int target_idx = -1;
+    for (int w = 1; w < weapon_count; ++w) {
+        if (weapon_indices[w] > 0) {
+            target_idx = weapon_indices[w];
+            break;
+        }
+    }
+    if (target_idx == -1) target_idx = weapon_indices[1];
+
+    RE3ItemSlot temp = slots[0];
+    slots[0] = slots[target_idx];
+    slots[target_idx] = temp;
+
+    slots[0].attr = 0x80;
+    if (slots[target_idx].attr == 0x80) slots[target_idx].attr = 0x00;
+    ram[0x000D2535] = slots[0].id;
+
+    char msg[64];
+    std::snprintf(msg, sizeof(msg), "Equipado: %s (%d)",
+                  re3_get_item_name(slots[0].id), (int)slots[0].count);
+    host_osd_push(msg, 1500);
+}
+
+static void re3_quick_reload(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    int wep_idx = -1;
+    if (re3_is_weapon(slots[0].id)) {
+        wep_idx = 0;
+    } else {
+        for (int i = 0; i < max_slots; ++i) {
+            if (re3_is_weapon(slots[i].id)) {
+                wep_idx = i;
+                break;
+            }
+        }
+    }
+
+    if (wep_idx == -1) {
+        host_osd_push("Nenhuma arma no inventario!", 1000);
+        return;
+    }
+
+    uint8_t wep_id = slots[wep_idx].id;
+    if (wep_id == 0x01) {
+        host_osd_push("Faca de combate nao usa municao!", 1000);
+        return;
+    }
+    if (wep_id == 0x0A || wep_id == 0x0B) {
+        host_osd_push("Arma pesada com municao infinita!", 1000);
+        return;
+    }
+
+    uint8_t ammo_id1 = 0, ammo_id2 = 0;
+    int max_ammo = 0;
+    if (wep_id == 0x02 || wep_id == 0x03 || wep_id == 0x0D) {
+        ammo_id1 = 0x15; // Handgun Bullets
+        ammo_id2 = 0x24; // Enhanced Handgun Bullets
+        max_ammo = 15;
+    } else if (wep_id == 0x04 || wep_id == 0x0E) {
+        ammo_id1 = 0x17; // Shotgun Shells
+        ammo_id2 = 0x25; // Enhanced Shotgun Shells
+        max_ammo = (wep_id == 0x0E) ? 8 : 7;
+    } else if (wep_id == 0x05) {
+        ammo_id1 = 0x16; // Magnum Bullets
+        max_ammo = 6;
+    } else if (wep_id == 0x06) {
+        ammo_id1 = 0x18; // Grenade normal
+        max_ammo = 6;
+    } else if (wep_id == 0x07) {
+        ammo_id1 = 0x19; // Grenade flame
+        max_ammo = 6;
+    } else if (wep_id == 0x08) {
+        ammo_id1 = 0x1A; // Grenade acid
+        max_ammo = 6;
+    } else if (wep_id == 0x09) {
+        ammo_id1 = 0x1B; // Grenade freeze
+        max_ammo = 6;
+    } else if (wep_id == 0x0C) {
+        ammo_id1 = 0x1F; // Mine Thrower
+        max_ammo = 6;
+    } else if (wep_id == 0x0E || wep_id == 0x0F) {
+        ammo_id1 = 0x22; // Assault rifle
+        max_ammo = 100;
+    }
+
+    if (max_ammo == 0) return;
+    if (slots[wep_idx].count >= max_ammo) {
+        char msg[64];
+        std::snprintf(msg, sizeof(msg), "Arma ja cheia! (%d/%d)", (int)slots[wep_idx].count, max_ammo);
+        host_osd_push(msg, 1000);
+        return;
+    }
+
+    int needed = max_ammo - (int)slots[wep_idx].count;
+    int reloaded = 0;
+
+    for (int i = 0; i < max_slots; ++i) {
+        if (i == wep_idx) continue;
+        if ((slots[i].id == ammo_id1 || (ammo_id2 && slots[i].id == ammo_id2)) && slots[i].count > 0) {
+            int take = (slots[i].count < needed) ? slots[i].count : needed;
+            slots[wep_idx].count += (uint8_t)take;
+            slots[i].count -= (uint8_t)take;
+            needed -= take;
+            reloaded += take;
+            if (slots[i].count == 0) {
+                slots[i].id = 0;
+                slots[i].count = 0;
+                slots[i].attr = 0;
+                slots[i].pad = 0;
+            }
+            if (needed <= 0) break;
+        }
+    }
+
+    if (reloaded > 0) {
+        char msg[64];
+        std::snprintf(msg, sizeof(msg), "Recarregado: %s (%d/%d)",
+                      re3_get_item_name(wep_id), (int)slots[wep_idx].count, max_ammo);
+        host_osd_push(msg, 1500);
+    } else {
+        host_osd_push("Sem municao no inventario!", 1200);
+    }
+}
+
+static void re3_combine_ammo_stacks(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    for (int i = 0; i < max_slots; ++i) {
+        if (slots[i].id == 0 || !re3_is_ammo(slots[i].id)) continue;
+        for (int j = i + 1; j < max_slots; ++j) {
+            if (slots[j].id == slots[i].id && slots[j].count > 0) {
+                int space = 255 - (int)slots[i].count;
+                if (space > 0) {
+                    int take = (slots[j].count <= space) ? slots[j].count : space;
+                    slots[i].count += (uint8_t)take;
+                    slots[j].count -= (uint8_t)take;
+                    if (slots[j].count == 0) {
+                        slots[j].id = 0;
+                        slots[j].count = 0;
+                        slots[j].attr = 0;
+                        slots[j].pad = 0;
+                    }
+                }
+            }
+        }
+    }
+}
+
+static void re3_max_out_ammo(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+    RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+    int max_slots = ram[0x000D225E];
+    if (max_slots < 8 || max_slots > 10) max_slots = 8;
+
+    int touched = 0;
+    for (int i = 0; i < max_slots; ++i) {
+        if (re3_is_ammo(slots[i].id)) {
+            slots[i].count = 255;
+            touched++;
+        } else if (re3_is_weapon(slots[i].id) && slots[i].id != 0x01) {
+            uint8_t wid = slots[i].id;
+            if (wid == 0x02 || wid == 0x03 || wid == 0x0D) slots[i].count = 15;
+            else if (wid == 0x04) slots[i].count = 7;
+            else if (wid == 0x0E) slots[i].count = 8;
+            else if (wid == 0x05 || (wid >= 0x06 && wid <= 0x09) || wid == 0x0C) slots[i].count = 6;
+            else if (wid == 0x0E || wid == 0x0F) slots[i].count = 100;
+            touched++;
+        }
+    }
+    if (touched > 0) {
+        host_osd_push("Municao no Maximo (255 balas)!", 1500);
+    }
+}
+
+static void re3_maintain_qol_per_frame(void) {
+    if (!g_psx_ram || !fntrace_is_game_started()) return;
+    uint8_t* ram = g_psx_ram;
+
+    // Door Skipping: bypass 3D door animation & camera sequence (Stage 1: 0x80015754)
+    // and jump directly to Stage 2 (0x80016150: finalize room transition and restore gameplay).
+    // Also null out Stage 2 (table[2]) so the transition loop terminates without running Stage 2 twice.
+    uint32_t* p_door_stage1 = (uint32_t*)(ram + 0x000979F4);
+    uint32_t* p_door_stage2 = (uint32_t*)(ram + 0x000979F8);
+    if (g_fast_doors) {
+        *p_door_stage1 = 0x80016150u;
+        *p_door_stage2 = 0x00000000u;
+    } else {
+        if (*p_door_stage1 == 0x80016150u) {
+            *p_door_stage1 = 0x80015754u;
+        }
+        if (*p_door_stage2 == 0x00000000u) {
+            *p_door_stage2 = 0x80016150u;
+        }
+    }
+
+    // Capcom native Secret Mode / Clear Mode flag (0x800D1F32):
+    // Bitmask 0xFFE0 populates item box with special weapons (Rocket Launcher, Gatling, M4A1, etc.),
+    // infinite ink ribbons, and unlocks the Boutique & all costumes.
+    if (g_all_weapons_box || g_unlock_boutique || g_unlock_mercenaries) {
+        *(uint16_t*)(ram + 0x000D1F32) |= 0xFFE0;
+    }
+
+    if (g_unlock_epilogues) {
+        ram[0x000D1F3E] = 8; // All 8 epilogues unlocked in gallery
+    }
+
+    // Active gameplay cheats (when player entity is active: inventory size 8 or 10)
+    uint8_t max_slots = ram[0x000D225E];
+    if (max_slots == 8 || max_slots == 10) {
+        // Infinite Health (God Mode)
+        if (g_infinite_health) {
+            uint16_t* p_hp = (uint16_t*)(ram + 0x000CCC90);
+            if (*p_hp > 0 && *p_hp < 200) {
+                *p_hp = 200;
+            }
+            ram[0x000CCC97] = 0x04; // Status condition Fine & poison cleared
+        }
+
+        // Infinite Ammo
+        if (g_infinite_ammo) {
+            RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+            for (int i = 0; i < max_slots; ++i) {
+                uint8_t wid = slots[i].id;
+                if (re3_is_weapon(wid) && wid != 0x01) { // firearm weapons
+                    uint8_t cap = 0;
+                    if (wid == 0x02 || wid == 0x03 || wid == 0x0D) cap = 15; // Handguns
+                    else if (wid == 0x04) cap = 7;                            // Shotgun M3S
+                    else if (wid == 0x05) cap = 6;                            // Magnum
+                    else if (wid >= 0x06 && wid <= 0x09) cap = 6;            // Grenade Launchers
+                    else if (wid == 0x0A || wid == 0x0B) cap = 255;          // Heavy weapons
+                    else if (wid == 0x0C) cap = 6;                            // Mine Thrower
+                    else if (wid == 0x0E || wid == 0x0F) cap = 100;          // Assault Rifle
+                    if (cap > 0 && slots[i].count < cap) {
+                        slots[i].count = cap;
+                    }
+                } else if (re3_is_ammo(wid)) {
+                    if (slots[i].count < 250) {
+                        slots[i].count = 250;
+                    }
+                }
+            }
+        }
+
+        // Infinite Ink Ribbons
+        if (g_infinite_ink_ribbons) {
+            RE3ItemSlot* slots = (RE3ItemSlot*)(ram + 0x000D2134);
+            for (int i = 0; i < max_slots; ++i) {
+                if (slots[i].id == 0x81 && slots[i].count < 99) { // 0x81 = Ink Ribbon
+                    slots[i].count = 99;
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------------
+    // Native Cutscene & Dialogue Skip (Instant Response, Zero Freezing)
+    // ------------------------------------------------------------------------
+    if (g_skip_cutscenes || g_skip_dialogues) {
+        uint16_t pad_btn = pad_buttons_for(g_players[0], 1, true);
+        const Uint8* keys = SDL_GetKeyboardState(NULL);
+
+        bool esc_down    = keys && (keys[SDL_SCANCODE_ESCAPE] != 0);
+        bool space_down  = keys && (keys[SDL_SCANCODE_SPACE] != 0);
+        bool return_down = keys && (keys[SDL_SCANCODE_RETURN] != 0 || keys[SDL_SCANCODE_KP_ENTER] != 0);
+        bool tab_down    = keys && (keys[SDL_SCANCODE_TAB] != 0);
+
+        bool esc_pressed    = esc_down && !s_re3_prev_esc;
+        bool space_pressed  = space_down && !s_re3_prev_space;
+        bool return_pressed = return_down && !s_re3_prev_return;
+        bool tab_pressed    = tab_down && !s_re3_prev_tab;
+
+        bool pad_select_down = ((pad_btn & PAD_SELECT) == 0);
+        bool pad_start_down  = ((pad_btn & PAD_START) == 0);
+        bool pad_action_down = ((pad_btn & (PAD_CROSS | PAD_CIRCLE)) != (PAD_CROSS | PAD_CIRCLE));
+
+        bool pad_select_pressed = pad_select_down && ((s_re3_prev_pad_buttons & PAD_SELECT) != 0);
+        bool pad_start_pressed  = pad_start_down && ((s_re3_prev_pad_buttons & PAD_START) != 0);
+        bool pad_action_pressed = pad_action_down && ((s_re3_prev_pad_buttons & (PAD_CROSS | PAD_CIRCLE)) == (PAD_CROSS | PAD_CIRCLE));
+
+        s_re3_prev_pad_buttons = pad_btn;
+        s_re3_prev_esc = esc_down;
+        s_re3_prev_space = space_down;
+        s_re3_prev_return = return_down;
+        s_re3_prev_tab = tab_down;
+
+        // An authentic PS1 FMV uses 24-bit color depth (GP1(08h) display_depth=1) and active MDEC.
+        // 2D backgrounds and 3D scenes during gameplay run in 15-bit mode (display_depth=0),
+        // preventing false FMV positives during room transitions or camera angle switches.
+        bool is_fmv = (gpu_display_is_depth24() != 0) && (mdec_recently_active(8) != 0);
+        bool is_xa_speaking = cdrom_xa_stream_active() != 0;
+
+        if (is_fmv) {
+            // Only Start, Select, Esc or Tab skip movie playback.
+            // Never include action buttons (A/Cross, B/Circle) to prevent gameplay disruption.
+            bool fmv_skip_requested = pad_start_down || pad_select_down || esc_down || tab_down;
+            if (fmv_skip_requested) {
+                s_re3_fmv_skip_frames = 20;
+            }
+        } else {
+            s_re3_fmv_skip_frames = 0; // Immediate disarm outside FMVs
+            // In-Game Real-Time Cutscenes:
+            // RE3 native engine skips cutscenes and radio sequences when PAD_SELECT is pressed.
+            // Escape and Tab on keyboard are mapped to trigger cutscene skip as well.
+            // Never trigger on PAD_START: Start is standard pause/inventory during gameplay.
+            bool cutscene_skip_requested = pad_select_down || esc_down || tab_down;
+
+            if (g_skip_cutscenes && cutscene_skip_requested) {
+                s_re3_cutscene_skip_frames = 15;
+                if (is_xa_speaking) {
+                    cdrom_skip_current_xa();
+                }
+            } else if (g_skip_dialogues && is_xa_speaking && (pad_action_pressed || space_pressed || return_pressed)) {
+                // For voiced dialogue lines, pressing Action (Cross/Circle), Space or Return skips
+                // the speech audio track cleanly without injecting any synthetic pad buttons,
+                // ensuring normal investigation/running/action is never disrupted.
+                cdrom_skip_current_xa();
+            }
+        }
+
+        if (s_re3_fmv_skip_frames > 0) {
+            s_re3_fmv_skip_frames--;
+            uint16_t cur = sio_get_pad_buttons_slot(0);
+            sio_set_pad_state_slot(0, cur & ~(PAD_START | PAD_SELECT));
+        }
+        if (s_re3_cutscene_skip_frames > 0) {
+            s_re3_cutscene_skip_frames--;
+            uint16_t cur = sio_get_pad_buttons_slot(0);
+            sio_set_pad_state_slot(0, cur & ~PAD_SELECT);
+        }
+    }
+}
