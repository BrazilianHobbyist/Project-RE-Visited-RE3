+constexpr size_t kMaxCachedTextures = 32;
+constexpr uint32_t kInvalidBgKey = 0xFFFFFFFFu;
+
+inline uint32_t bg_make_key(uint8_t stage, uint8_t room, uint8_t cut) {
+    return (static_cast<uint32_t>(stage) << 16) |
+           (static_cast<uint32_t>(room) << 8) |
+           static_cast<uint32_t>(cut);
+}
+
+enum class BgState {
+    None,
+    Queued,
+    Loading,
+    ReadyRAM,  // Decoded by worker thread into host memory
+    ReadyGL,   // Uploaded to OpenGL texture
+    Failed
+};
+
+struct DecodedImage {
+    uint32_t width = 0;
+    uint32_t height = 0;
+    std::vector<uint8_t> rgba;
+};
+
+struct BgTextureEntry {
+    uint32_t key = kInvalidBgKey;
+    uint8_t stage = 0;
+    uint8_t room = 0;
+    uint8_t cut = 0;
+    std::string filepath;
+    BgState state = BgState::None;
+    uint32_t gl_tex_id = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    std::shared_ptr<DecodedImage> staging_pixels;
+};
