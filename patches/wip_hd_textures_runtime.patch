@@ -0,0 +1,422 @@
+#include "re3_hd_textures.h"
+#include "re3_textures.h"
+#include "xxhash.h"
+#include "psx_sdl.h"
+
+#if defined(PSX_SDL3)
+#include <SDL3/SDL_opengl.h>
+#else
+#include <SDL_opengl.h>
