+const char* re3_hd_ui_resolve_backdrop_path(const char* screen_name, char* out_path, size_t max_len) {
+    if (!out_path || max_len == 0) return nullptr;
+    out_path[0] = '\0';
+
+    if (!re3_hd_ui_is_active() || !screen_name || screen_name[0] == '\0') {
+        return nullptr;
+    }
+
+    std::string sname = screen_name;
+    // Security check: reject path traversal
+    if (sname.find("..") != std::string::npos ||
+        sname.find('/') != std::string::npos ||
+        sname.find('\\') != std::string::npos ||
+        sname.find(':') != std::string::npos) {
+        return nullptr;
+    }
+
+    // Boundary check for epilogues: only 0..7 are valid in RE3
+    if (sname.rfind("epilogue", 0) == 0) {
+        size_t digit_pos = sname.find_first_of("0123456789");
+        if (digit_pos != std::string::npos) {
+            int ep_idx = -1;
+            try {
+                ep_idx = std::stoi(sname.substr(digit_pos));
+            } catch (...) {}
+            if (ep_idx < 0 || ep_idx >= 8) {
+                return nullptr;
+            }
+        }
+    }
+
+    fs::path ui_dir_fs(s_ui_dir);
+    std::error_code ec;
+    if (!fs::exists(ui_dir_fs, ec) || !fs::is_directory(ui_dir_fs, ec)) {
+        return nullptr;
+    }
+
+    fs::path norm_ui = fs::weakly_canonical(ui_dir_fs, ec);
+
+    // Build candidate filenames in prioritized order
+    std::vector<std::string> candidates;
+    std::string lower_sname = sname;
+    std::transform(lower_sname.begin(), lower_sname.end(), lower_sname.begin(), ::tolower);
+
+    // Direct filename variations
+    candidates.push_back(lower_sname + ".png");
+    candidates.push_back(lower_sname + ".PNG");
+
+    std::string upper_sname = sname;
+    std::transform(upper_sname.begin(), upper_sname.end(), upper_sname.begin(), ::toupper);
+    candidates.push_back(upper_sname + ".PNG");
+    candidates.push_back(upper_sname + ".png");
+
+    // Title case (e.g. Inventory.png, Map.png)
+    std::string title_sname = lower_sname;
+    if (!title_sname.empty()) {
+        title_sname[0] = static_cast<char>(::toupper(title_sname[0]));
+        candidates.push_back(title_sname + ".png");
+        candidates.push_back(title_sname + ".PNG");
+    }
+
+    // Contextual aliases
+    if (lower_sname.rfind("status_", 0) == 0) {
+        candidates.push_back("status.png");
+        candidates.push_back("STATUS.PNG");
+        candidates.push_back("Status.png");
+    } else if (lower_sname == "save") {
+        candidates.push_back("typewriter.png");
+        candidates.push_back("TYPEWRITER.PNG");
+        candidates.push_back("Typewriter.png");
+    } else if (lower_sname.rfind("epilogue_", 0) == 0) {
+        std::string unseparated = "epilogue" + lower_sname.substr(9);
+        candidates.push_back(unseparated + ".png");
+        candidates.push_back(unseparated + ".PNG");
+    }
+
+    for (const auto& cand_name : candidates) {
+        fs::path p = ui_dir_fs / cand_name;
+        if (fs::exists(p, ec) && !fs::is_directory(p, ec)) {
+            fs::path p_norm = fs::weakly_canonical(p, ec);
+            if (p_norm.generic_string().rfind(norm_ui.generic_string(), 0) == 0) {
+                std::string full_str = p.generic_string();
+                std::strncpy(out_path, full_str.c_str(), max_len - 1);
+                out_path[max_len - 1] = '\0';
+                return out_path;
+            }
+        }
+    }
+
+    // Fallback: Case-insensitive scan of ui/ directory
+    for (const auto& entry : fs::directory_iterator(ui_dir_fs, ec)) {
+        if (!entry.is_regular_file(ec)) continue;
+        std::string fname = entry.path().filename().string();
+        std::string fname_lower = fname;
+        std::transform(fname_lower.begin(), fname_lower.end(), fname_lower.begin(), ::tolower);
+
+        if (fname_lower == lower_sname + ".png") {
+            fs::path p_norm = fs::weakly_canonical(entry.path(), ec);
+            if (p_norm.generic_string().rfind(norm_ui.generic_string(), 0) == 0) {
+                std::string full_str = entry.path().generic_string();
+                std::strncpy(out_path, full_str.c_str(), max_len - 1);
+                out_path[max_len - 1] = '\0';
+                return out_path;
+            }
+        }
+    }
+
+    return nullptr;
+}
+
+const char* re3_hd_ui_resolve_status_backdrop(uint8_t condition, char* out_path, size_t max_len) {
+    const char* screen_name = "status_fine";
+    switch (condition) {
+        case 0x04: screen_name = "status_fine";    break;
+        case 0x03: screen_name = "status_caution"; break;
+        case 0x02: screen_name = "status_danger";  break;
+        case 0x01: screen_name = "status_poison";  break;
+        default:   screen_name = "status_fine";    break; // Unknown defaults to status_fine
+    }
+    return re3_hd_ui_resolve_backdrop_path(screen_name, out_path, max_len);
+}
+
+bool re3_hd_ui_load_backdrop(const char* screen_name, re3_ui_backdrop_info_t* out_info) {
+    if (out_info) {
+        out_info->has_hd = false;
+        out_info->fallback_native_ui = true;
+        out_info->gl_tex_id = 0;
+        out_info->width = 0;
+        out_info->height = 0;
+        out_info->file_path[0] = '\0';
+        if (screen_name) {
+            std::strncpy(out_info->screen_name, screen_name, sizeof(out_info->screen_name) - 1);
+            out_info->screen_name[sizeof(out_info->screen_name) - 1] = '\0';
+        } else {
+            out_info->screen_name[0] = '\0';
+        }
+    }
+
+    if (!re3_hd_ui_is_active() || !screen_name || screen_name[0] == '\0') {
+        return false;
+    }
+
+    std::lock_guard<std::mutex> lock(s_ui_mutex);
+
+    // 1. Check existing backdrop cache
+    auto it = s_backdrop_cache.find(screen_name);
+    if (it != s_backdrop_cache.end()) {
+        s_backdrop_lru.remove(screen_name);
+        s_backdrop_lru.push_front(screen_name);
+        if (out_info) {
+            *out_info = it->second;
+        }
+        s_metrics.backdrop_hits++;
+        return true;
+    }
+
+    // 2. Resolve file path
+    char resolved[1024];
+    if (!re3_hd_ui_resolve_backdrop_path(screen_name, resolved, sizeof(resolved))) {
+        s_metrics.backdrop_misses++;
+        return false;
+    }
+
+    // 3. Decode PNG
+    std::vector<uint8_t> rgba;
+    int w = 0, h = 0;
+    if (!decode_png_to_rgba(resolved, rgba, w, h)) {
+        s_metrics.backdrop_misses++;
+        return false;
+    }
+
+    // 4. Create OpenGL Texture
+    query_gl_caps();
+    uint32_t tex_id = 0;
+    if (SDL_GL_GetCurrentContext()) {
+        GLuint gl_tex = 0;
+        glGenTextures(1, &gl_tex);
+        if (gl_tex != 0) {
+            glBindTexture(GL_TEXTURE_2D, gl_tex);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+            glBindTexture(GL_TEXTURE_2D, 0);
+            tex_id = gl_tex;
+        }
+    } else {
+        // Headless context fallback (deterministic non-zero handle for test validation)
+        tex_id = static_cast<uint32_t>(std::hash<std::string>{}(screen_name) & 0x7FFFFFFF) | 1;
+    }
+
+    // 5. Populate metadata
+    re3_ui_backdrop_info_t entry;
+    entry.has_hd = true;
+    entry.fallback_native_ui = false;
+    entry.gl_tex_id = tex_id;
+    entry.width = w;
+    entry.height = h;
+    std::strncpy(entry.file_path, resolved, sizeof(entry.file_path) - 1);
+    entry.file_path[sizeof(entry.file_path) - 1] = '\0';
+    std::strncpy(entry.screen_name, screen_name, sizeof(entry.screen_name) - 1);
+    entry.screen_name[sizeof(entry.screen_name) - 1] = '\0';
+
+    s_backdrop_cache[screen_name] = entry;
+    s_backdrop_lru.push_front(screen_name);
+    s_metrics.backdrop_hits++;
+    s_metrics.active_textures = static_cast<uint32_t>(s_backdrop_cache.size() + s_sprite_cache.size());
+
+    // 6. Eviction if LRU exceeds capacity
+    if (s_backdrop_cache.size() > kMaxCachedBackdrops) {
+        std::string victim = s_backdrop_lru.back();
+        s_backdrop_lru.pop_back();
+        auto vict_it = s_backdrop_cache.find(victim);
+        if (vict_it != s_backdrop_cache.end()) {
+            if (vict_it->second.gl_tex_id != 0 && SDL_GL_GetCurrentContext()) {
+                glDeleteTextures(1, &vict_it->second.gl_tex_id);
+            }
+            s_backdrop_cache.erase(vict_it);
+        }
+    }
+
+    if (out_info) {
+        *out_info = entry;
+    }
+    return true;
+}
+
+bool re3_hd_ui_has_backdrop(const char* screen_name) {
+    if (!re3_hd_ui_is_active() || !screen_name || screen_name[0] == '\0') {
+        return false;
+    }
+    re3_ui_backdrop_info_t info;
+    return re3_hd_ui_load_backdrop(screen_name, &info);
+}
+
+uint32_t re3_hd_ui_get_backdrop_gl_tex(const char* screen_name) {
+    if (!re3_hd_ui_is_active() || !screen_name || screen_name[0] == '\0') {
+        return 0;
+    }
+    re3_ui_backdrop_info_t info;
+    if (re3_hd_ui_load_backdrop(screen_name, &info)) {
+        return info.gl_tex_id;
+    }
+    return 0;
+}
+
+bool re3_hd_ui_render_backdrop(const char* screen_name, uint32_t fbo, int width, int height) {
+    if (!re3_hd_ui_is_active() || !screen_name || screen_name[0] == '\0') {
+        return false;
+    }
+
+    re3_ui_backdrop_info_t info;
+    if (!re3_hd_ui_load_backdrop(screen_name, &info) || !info.has_hd) {
+        return false;
+    }
+
+    // Headless / non-GL context safe-check
+    if (!SDL_GL_GetCurrentContext()) {
+        return true;
+    }
+
+    if (!init_blit_pipeline()) {
+        return true;
+    }
+
+    // Bind destination FBO
+    if (fbo != 0 && p_glBindFramebuffer) {
+        p_glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    }
+
+    if (width > 0 && height > 0) {
+        glViewport(0, 0, width, height);
+    }
+
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_BLEND);
+
+    p_glUseProgram(s_blit_program);
+    p_glUniform1i(s_u_tex, 0);
+
+    if (p_glActiveTexture) {
+        p_glActiveTexture(GL_TEXTURE0);
+    }
+    glBindTexture(GL_TEXTURE_2D, info.gl_tex_id);
+
+    if (p_glBindVertexArray && s_blit_vao != 0) {
+        p_glBindVertexArray(s_blit_vao);
+    }
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    if (p_glBindVertexArray && s_blit_vao != 0) {
+        p_glBindVertexArray(0);
+    }
+
+    p_glUseProgram(0);
+    glBindTexture(GL_TEXTURE_2D, 0);
+
+    return true;
+}
+
+bool re3_hd_ui_is_fullscreen_quad(int32_t x0, int32_t y0, int32_t w, int32_t h) {
+    if (h < 220) return false;
+    // Single full-screen quad (320x240 standard)
+    if (w >= 310 && (x0 >= -16 && x0 <= 16) && (y0 >= -16 && y0 <= 16)) return true;
+    // Split vertical/horizontal tiles (160x240, 256x240, or 64x240)
+    if ((w >= 140 && w <= 260) && (y0 >= -16 && y0 <= 16)) return true;
+    return false;
+}
+
+const char* re3_hd_ui_detect_screen_from_memory(void) {
+    uint8_t cond = read_guest_ram(0x000CCC97);
+    uint8_t ep_count = read_guest_ram(0x000D1F3E);
+
+    // Epilogue Gallery mode
+    if (ep_count > 0 && ep_count <= 8) {
+        static char ep_str[32];
+        uint8_t idx = ep_count - 1;
+        std::snprintf(ep_str, sizeof(ep_str), "epilogue_%u", idx);
+        return ep_str;
+    }
+
+    // Status condition screen mapping
+    switch (cond) {
+        case 0x04: return "status_fine";
+        case 0x03: return "status_caution";
+        case 0x02: return "status_danger";
+        case 0x01: return "status_poison";
+        default:   break;
+    }
+
+    // Default 2D menu fallback
+    return "inventory";
+}
+
+bool re3_hd_ui_intercept_menu_quad(int32_t x0, int32_t y0, int32_t w, int32_t h,
+                                  uint16_t tpage, uint16_t clut,
+                                  uint32_t fbo, int fb_w, int fb_h) {
+    if (!re3_hd_ui_is_active()) return false;
+    if (!re3_hd_ui_is_fullscreen_quad(x0, y0, w, h)) return false;
+
+    const char* screen = re3_hd_ui_detect_screen_from_memory();
+    if (!screen) screen = "inventory";
+
+    if (re3_hd_ui_has_backdrop(screen)) {
+        bool blitted = re3_hd_ui_render_backdrop(screen, fbo, fb_w, fb_h);
+        if (blitted) {
+            return true; // Low-res quad intercepted and HD backdrop rendered
+        }
+    }
+
+    return false;
+}
+
+uint32_t re3_hd_ui_bind_sprite(uint64_t hash) {
+    if (!re3_hd_ui_is_active() || hash == 0) {
+        return 0;
+    }
+
+    std::lock_guard<std::mutex> lock(s_ui_mutex);
+
+    // 1. Check missing cache
+    if (s_missing_sprites.find(hash) != s_missing_sprites.end()) {
+        s_metrics.sprite_misses++;
+        return 0;
+    }
+
+    // 2. Check resident texture cache
+    auto it = s_sprite_cache.find(hash);
+    if (it != s_sprite_cache.end()) {
+        s_sprite_lru.remove(hash);
+        s_sprite_lru.push_front(hash);
+        s_metrics.sprite_hits++;
+        return it->second;
+    }
+
+    // 3. Resolve replacement on disk
+    fs::path ui_dir_fs(s_ui_dir);
+    std::error_code ec;
+    if (!fs::exists(ui_dir_fs, ec) || !fs::is_directory(ui_dir_fs, ec)) {
+        s_missing_sprites.insert(hash);
+        s_metrics.sprite_misses++;
+        return 0;
+    }
+
+    char c1[32], c2[32], c3[32], c4[32];
+    std::snprintf(c1, sizeof(c1), "%016llx.png", (unsigned long long)hash);
+    std::snprintf(c2, sizeof(c2), "%016llX.png", (unsigned long long)hash);
+    std::snprintf(c3, sizeof(c3), "%llx.png", (unsigned long long)hash);
+    std::snprintf(c4, sizeof(c4), "%llX.png", (unsigned long long)hash);
+
+    const char* cand_names[] = { c1, c2, c3, c4 };
+    std::string found_path;
+
+    for (const char* name : cand_names) {
+        fs::path p = ui_dir_fs / name;
+        if (fs::exists(p, ec) && !fs::is_directory(p, ec)) {
+            found_path = p.generic_string();
+            break;
+        }
+        // Try uppercase extension
+        fs::path p_ext = p;
+        p_ext.replace_extension(".PNG");
+        if (fs::exists(p_ext, ec) && !fs::is_directory(p_ext, ec)) {
+            found_path = p_ext.generic_string();
+            break;
+        }
+    }
+
+    if (found_path.empty()) {
+        s_missing_sprites.insert(hash);
+        s_metrics.sprite_misses++;
+        return 0;
+    }
+
+    // 4. Decode sprite PNG
+    std::vector<uint8_t> rgba;
+    int w = 0, h = 0;
+    if (!decode_png_to_rgba(found_path, rgba, w, h)) {
+        s_missing_sprites.insert(hash);
+        s_metrics.sprite_misses++;
+        return 0;
+    }
+
+    // 5. Upload to OpenGL
+    query_gl_caps();
+    uint32_t tex_id = 0;
+    if (SDL_GL_GetCurrentContext()) {
+        GLuint gl_tex = 0;
+        glGenTextures(1, &gl_tex);
+        if (gl_tex != 0) {
+            glBindTexture(GL_TEXTURE_2D, gl_tex);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+
+            if (p_glGenerateMipmap) {
+                p_glGenerateMipmap(GL_TEXTURE_2D);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+            } else {
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+            }
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+            if (s_max_anisotropy > 1.0f) {
+                glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAX_ANISOTROPY_EXT, s_max_anisotropy);
+            }
+            glBindTexture(GL_TEXTURE_2D, 0);
+            tex_id = gl_tex;
+        }
+    } else {
+        // Headless context fallback
+        tex_id = static_cast<uint32_t>(hash & 0xFFFFFFFF) | 1;
+    }
+
+    s_sprite_cache[hash] = tex_id;
+    s_sprite_lru.push_front(hash);
+    s_metrics.sprite_hits++;
+    s_metrics.active_textures = static_cast<uint32_t>(s_backdrop_cache.size() + s_sprite_cache.size());
+
+    // 6. LRU eviction
+    if (s_sprite_cache.size() > kMaxCachedSprites) {
+        uint64_t victim = s_sprite_lru.back();
+        s_sprite_lru.pop_back();
+        auto vict_it = s_sprite_cache.find(victim);
+        if (vict_it != s_sprite_cache.end()) {
+            if (vict_it->second != 0 && SDL_GL_GetCurrentContext()) {
+                glDeleteTextures(1, &vict_it->second);
+            }
+            s_sprite_cache.erase(vict_it);
+        }
+    }
+
+    return tex_id;
+}
+
+void re3_hd_ui_get_metrics(re3_hd_ui_metrics_t* out_metrics) {
+    if (!out_metrics) return;
+    std::lock_guard<std::mutex> lock(s_ui_mutex);
+    *out_metrics = s_metrics;
+}
+
+void re3_hd_ui_set_memory_reader(re3_hd_ui_mem_reader_fn reader) {
+    s_custom_mem_reader = reader;
+}
diff --git a/runtime/src/re3_textures.cpp b/runtime/src/re3_textures.cpp
new file mode 100644
index 00000000..952d2083
--- /dev/null
+++ b/runtime/src/re3_textures.cpp
@@ -0,0 +1,175 @@
+#include "re3_textures.h"
+#include "re3_hd_backgrounds.h"
+#include "re3_hd_textures.h"
+#include "re3_hd_ui.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <filesystem>
+#include <algorithm>
+
+// Global texture configuration initialized with defaults
+re3_texture_config_t g_re3_tex_config = {
+    "SeamlessHD", // pack
+    true,         // hd_backgrounds
+    true,         // hd_models
+    true,         // hd_ui
+    false         // dump_textures
+};
+
+static char s_base_path[1024] = ".";
+static char s_pack_path[1024] = "";
+static bool s_pack_valid = false;
+static bool s_initialized = false;
+
+static void normalize_path_string(char* path) {
+    if (!path) return;
+    for (char* p = path; *p; ++p) {
+        if (*p == '\\') *p = '/';
+    }
+    // Remove trailing slash if not root
+    size_t len = strlen(path);
+    while (len > 1 && path[len - 1] == '/') {
+        path[len - 1] = '\0';
+        --len;
+    }
+}
+
+void re3_textures_init(const char* base_path) {
+    if (base_path && base_path[0] != '\0') {
+        std::strncpy(s_base_path, base_path, sizeof(s_base_path) - 1);
+        s_base_path[sizeof(s_base_path) - 1] = '\0';
+    } else {
+        std::strncpy(s_base_path, ".", sizeof(s_base_path) - 1);
+        s_base_path[sizeof(s_base_path) - 1] = '\0';
+    }
+    normalize_path_string(s_base_path);
+
+    // Trim whitespace from pack name
+    std::string pack_name = g_re3_tex_config.pack;
+    size_t p1 = pack_name.find_first_not_of(" \t\r\n\"");
+    size_t p2 = pack_name.find_last_not_of(" \t\r\n\"");
+    if (p1 == std::string::npos) pack_name.clear();
+    else pack_name = pack_name.substr(p1, p2 - p1 + 1);
+
+    std::strncpy(g_re3_tex_config.pack, pack_name.c_str(), sizeof(g_re3_tex_config.pack) - 1);
+    g_re3_tex_config.pack[sizeof(g_re3_tex_config.pack) - 1] = '\0';
+
+    // Check if pack is disabled or empty
+    if (pack_name.empty() ||
+        pack_name == "None" || pack_name == "none" ||
+        pack_name == "Vanilla" || pack_name == "vanilla" ||
+        pack_name == "off" || pack_name == "disabled" ||
+        pack_name == "0") {
+        s_pack_valid = false;
+        s_pack_path[0] = '\0';
+        std::fprintf(stdout, "psxrecomp: [Textures] Pack is disabled or vanilla. HD replacement inactive.\n");
+    } else {
+        std::filesystem::path base_fs(s_base_path);
+        std::filesystem::path pack_fs = base_fs / "mods" / "textures" / pack_name;
+        std::string pack_str = pack_fs.generic_string();
+
+        std::strncpy(s_pack_path, pack_str.c_str(), sizeof(s_pack_path) - 1);
+        s_pack_path[sizeof(s_pack_path) - 1] = '\0';
+
+        std::error_code ec;
+        if (std::filesystem::exists(pack_fs, ec) && std::filesystem::is_directory(pack_fs, ec)) {
+            s_pack_valid = true;
+            std::fprintf(stdout, "psxrecomp: [Textures] Active pack: \"%s\" at \"%s\" [BG:%s, Models:%s, UI:%s, Dump:%s]\n",
+                         g_re3_tex_config.pack,
+                         s_pack_path,
+                         g_re3_tex_config.hd_backgrounds ? "ON" : "OFF",
+                         g_re3_tex_config.hd_models ? "ON" : "OFF",
+                         g_re3_tex_config.hd_ui ? "ON" : "OFF",
+                         g_re3_tex_config.dump_textures ? "ON" : "OFF");
+        } else {
+            s_pack_valid = false;
+            std::fprintf(stdout, "psxrecomp: [Textures] Pack folder not found at \"%s\". Vanilla textures active.\n",
+                         s_pack_path);
+        }
+    }
+
+    // Prepare dumping directory if enabled
+    if (g_re3_tex_config.dump_textures) {
+        std::filesystem::path dump_fs = std::filesystem::path(s_base_path) / "dump" / "textures";
+        std::error_code ec;
+        std::filesystem::create_directories(dump_fs, ec);
+        std::fprintf(stdout, "psxrecomp: [Textures] Dumping enabled. Target directory: \"%s\"\n",
+                     dump_fs.generic_string().c_str());
+    }
+
+    s_initialized = true;
+    re3_hd_bg_init(s_pack_path);
+    re3_hd_tex_init(s_pack_path);
+    re3_hd_ui_init(s_pack_path);
+}
+
+void re3_textures_shutdown(void) {
+    if (s_initialized) {
+        re3_hd_ui_shutdown();
+        re3_hd_tex_shutdown();
+        re3_hd_bg_shutdown();
+        std::fprintf(stdout, "psxrecomp: [Textures] Subsystem shutdown complete.\n");
+        s_pack_valid = false;
+        s_pack_path[0] = '\0';
+        s_initialized = false;
+    }
+}
+
+const re3_texture_config_t* re3_textures_get_config(void) {
+    return &g_re3_tex_config;
+}
+
+const char* re3_textures_get_pack_path(void) {
+    return s_pack_path;
+}
+
+const char* re3_textures_get_base_path(void) {
+    return s_base_path;
+}
+
+bool re3_textures_is_pack_valid(void) {
+    return s_pack_valid;
+}
+
+bool re3_textures_resolve_path(char* out_path, size_t max_len, const char* subfolder, const char* filename) {
+    if (!out_path || max_len == 0) return false;
+    out_path[0] = '\0';
+
+    if (!s_pack_valid || !filename || filename[0] == '\0') {
+        return false;
+    }
+
+    std::filesystem::path p(s_pack_path);
+    if (subfolder && subfolder[0] != '\0') {
+        p /= subfolder;
+    }
+    p /= filename;
+
+    std::error_code ec;
+    if (std::filesystem::exists(p, ec) && !std::filesystem::is_directory(p, ec)) {
+        std::string gen = p.generic_string();
+        std::strncpy(out_path, gen.c_str(), max_len - 1);
+        out_path[max_len - 1] = '\0';
+        return true;
+    }
+
+    // Fallback: check alternate extension case (.png <-> .PNG)
+    std::filesystem::path p_alt = p;
+    std::string ext = p.extension().generic_string();
+    if (ext == ".png") {
+        p_alt.replace_extension(".PNG");
+    } else if (ext == ".PNG") {
+        p_alt.replace_extension(".png");
+    }
+    if (std::filesystem::exists(p_alt, ec) && !std::filesystem::is_directory(p_alt, ec)) {
+        std::string gen = p_alt.generic_string();
+        std::strncpy(out_path, gen.c_str(), max_len - 1);
+        out_path[max_len - 1] = '\0';
+        return true;
+    }
+
+    return false;
+}
