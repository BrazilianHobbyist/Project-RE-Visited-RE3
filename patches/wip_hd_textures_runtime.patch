diff --git a/runtime/include/re3_hd_backgrounds.h b/runtime/include/re3_hd_backgrounds.h
new file mode 100644
index 00000000..9679cd8a
--- /dev/null
+++ b/runtime/include/re3_hd_backgrounds.h
@@ -0,0 +1,93 @@
+#ifndef RE3_HD_BACKGROUNDS_H
+#define RE3_HD_BACKGROUNDS_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    uint64_t hits;
+    uint64_t misses;
+    uint64_t evictions;
+    uint64_t prefetches;
+    size_t memory_used_bytes;
+    size_t memory_budget_bytes;
+    uint32_t active_entries;
+} re3_hd_bg_metrics_t;
+
+/**
+ * Initializes the HD pre-rendered backgrounds engine.
+ * @param pack_path Path to the active texture pack directory (e.g. "mods/textures/SeamlessHD").
+ */
+void re3_hd_bg_init(const char* pack_path);
+
+/**
+ * Shuts down the background engine, stops worker threads, and releases all GL textures.
+ */
+void re3_hd_bg_shutdown(void);
+
+/**
+ * Notifies the engine of an updated game camera state.
+ * Eagerly prefetches room cuts if the room or stage has changed.
+ * @param stage Stage ID (0x000D1F08)
+ * @param room  Room ID (0x000D1F09)
+ * @param cut   Cut/Camera angle ID (0x000D1F0A)
+ */
+void re3_hd_bg_on_room_change(uint8_t stage, uint8_t room, uint8_t cut);
+
+/**
+ * Returns true if an HD background is currently available and ready for the active cut.
+ */
+bool re3_hd_bg_has_hd_current(void);
+
+/**
+ * Returns the OpenGL texture handle (GLuint) for the currently active background, or 0.
+ */
+uint32_t re3_hd_bg_get_current_gl_tex(void);
+
+/**
+ * Blits the current HD background texture into the target FBO (s_hr_fbo).
+ * @param fbo    Target OpenGL Framebuffer Object handle
+ * @param width  Target framebuffer/viewport width in pixels
+ * @param height Target framebuffer/viewport height in pixels
+ * @return true if successfully rendered, false if fallback to VRAM is required.
+ */
+bool re3_hd_bg_render_current(uint32_t fbo, int width, int height);
+
+/**
+ * Resolves a background file path on disk for given (stage, room, cut) using
+ * deterministic RESHDP candidate matching and fallback rules.
+ * @param stage    Stage ID
+ * @param room     Room ID
+ * @param cut      Cut ID
+ * @param out_path Buffer to receive resolved path
+ * @param max_len  Capacity of out_path buffer
+ * @return Pointer to out_path on success, NULL if no file exists.
+ */
+const char* re3_hd_bg_resolve_file(uint8_t stage, uint8_t room, uint8_t cut,
+                                   char* out_path, size_t max_len);
+
+/**
+ * Calculates screen-space UV coordinates for an occlusion mask quad.
+ * @param x      Quad X coordinate on 320x240 screen
+ * @param y      Quad Y coordinate on 320x240 screen
+ * @param w      Quad width on screen
+ * @param h      Quad height on screen
+ * @param out_uv Output array of 4 floats: [u_min, v_min, u_max, v_max]
+ */
+void re3_hd_bg_get_screen_uv(int x, int y, int w, int h, float out_uv[4]);
+
+/**
+ * Retrieves engine metrics and statistics.
+ */
+void re3_hd_bg_get_metrics(re3_hd_bg_metrics_t* out_metrics);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RE3_HD_BACKGROUNDS_H */
diff --git a/runtime/include/re3_hd_textures.h b/runtime/include/re3_hd_textures.h
new file mode 100644
index 00000000..db0cd1d7
--- /dev/null
+++ b/runtime/include/re3_hd_textures.h
@@ -0,0 +1,113 @@
+#ifndef RE3_HD_TEXTURES_H
+#define RE3_HD_TEXTURES_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    uint64_t cache_hits;
+    uint64_t cache_misses;
+    uint64_t disk_loads;
+    uint32_t active_textures;
+} re3_hd_tex_metrics_t;
+
+/**
+ * Initializes the HD texture replacement subsystem with the active pack path.
+ * @param pack_path Path to the texture pack directory (e.g. "mods/textures/SeamlessHD").
+ */
+void re3_hd_tex_init(const char* pack_path);
+
+/**
+ * Shuts down the HD texture subsystem, deletes all GL textures and clears caches.
+ */
+void re3_hd_tex_shutdown(void);
+
+/**
+ * Returns true if the HD texture replacement subsystem is active and initialized.
+ */
+bool re3_hd_tex_is_active(void);
+
+/**
+ * Computes 64-bit deterministic hash (xxHash64) from composite texture payload.
+ * Matches Python compute_texture_xxhash64 bit-for-bit.
+ *
+ * @param tpage        PS1 texture page word (depth at bits 7..8)
+ * @param clut         PS1 CLUT word
+ * @param lim          Bounding UV limits [u_min, v_min, u_max, v_max] (or NULL for default 0,0,255,255)
+ * @param palette      Palette words (16 for 4bpp, 256 for 8bpp; ignored for 15bpp direct)
+ * @param palette_len  Number of palette entries available
+ * @param vram_pixels  Raw 16-bit VRAM texel words within bounding box
+ * @param pixel_words  Number of 16-bit words in vram_pixels
+ */
+uint64_t re3_hd_tex_compute_hash(uint16_t tpage, uint16_t clut, const uint8_t lim[4],
+                                 const uint16_t* palette, int palette_len,
+                                 const uint16_t* vram_pixels, int pixel_words);
+
+/**
+ * Computes xxHash64 with explicit byte length for raw texels.
+ */
+uint64_t re3_hd_tex_compute_hash_bytes(uint16_t tpage, uint16_t clut, const uint8_t lim[4],
+                                       const uint16_t* palette, int palette_len,
+                                       const void* vram_pixels, size_t pixel_bytes);
+
+/**
+ * High-performance streaming xxHash64 computed directly from live 1024x512 VRAM.
+ * Zero dynamic heap allocations.
+ *
+ * @param tpage PS1 texture page word
+ * @param clut  PS1 CLUT word
+ * @param lim   Primitive UV limits [u_min, v_min, u_max, v_max]
+ * @param vram  Pointer to 1024x512 16-bit VRAM buffer
+ */
+uint64_t re3_hd_tex_compute_from_vram(uint16_t tpage, uint16_t clut, const int lim[4],
+                                      const uint16_t* vram);
+
+/**
+ * Binds/retrieves the OpenGL texture handle for the given hash replacement.
+ * Returns GLuint texture handle, or 0 if no replacement exists (transparent PS1 fallback).
+ *
+ * @param hash 64-bit xxHash64 fingerprint
+ */
+uint32_t re3_hd_tex_bind_replacement(uint64_t hash);
+
+/**
+ * Dumps texture to disk as PNG if dump_textures is enabled in configuration.
+ */
+void re3_hd_tex_dump_if_enabled(uint64_t hash, uint16_t tpage, uint16_t clut,
+                                int w, int h, const uint32_t* rgba_pixels);
+
+/**
+ * Retrieves performance metrics for the HD texture cache.
+ */
+void re3_hd_tex_get_metrics(re3_hd_tex_metrics_t* out_metrics);
+
+/**
+ * Full page UV normalization with half-texel centering (maps [0, 255] to [0.5/256, 255.5/256]).
+ */
+static inline void re3_hd_tex_normalize_uv_full_page(float u, float v, float* out_u, float* out_v) {
+    if (out_u) *out_u = (u + 0.5f) / 256.0f;
+    if (out_v) *out_v = (v + 0.5f) / 256.0f;
+}
+
+/**
+ * Bounded sub-rectangle UV normalization.
+ */
+static inline void re3_hd_tex_normalize_uv_sub_rect(float u, float v, int u_min, int v_min,
+                                                    int u_max, int v_max,
+                                                    float* out_u, float* out_v) {
+    float w = (float)(u_max > u_min ? (u_max - u_min + 1) : 1);
+    float h = (float)(v_max > v_min ? (v_max - v_min + 1) : 1);
+    if (out_u) *out_u = (u - (float)u_min) / w;
+    if (out_v) *out_v = (v - (float)v_min) / h;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RE3_HD_TEXTURES_H */
diff --git a/runtime/include/re3_hd_ui.h b/runtime/include/re3_hd_ui.h
new file mode 100644
index 00000000..7c961c9a
--- /dev/null
+++ b/runtime/include/re3_hd_ui.h
@@ -0,0 +1,160 @@
+#ifndef RE3_HD_UI_H
+#define RE3_HD_UI_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    RE3_UI_SCREEN_NONE = 0,
+    RE3_UI_SCREEN_INVENTORY,
+    RE3_UI_SCREEN_STATUS_FINE,
+    RE3_UI_SCREEN_STATUS_CAUTION,
+    RE3_UI_SCREEN_STATUS_DANGER,
+    RE3_UI_SCREEN_STATUS_POISON,
+    RE3_UI_SCREEN_MAP,
+    RE3_UI_SCREEN_CLOCK,
+    RE3_UI_SCREEN_SAVE,
+    RE3_UI_SCREEN_EPILOGUE_0,
+    RE3_UI_SCREEN_EPILOGUE_1,
+    RE3_UI_SCREEN_EPILOGUE_2,
+    RE3_UI_SCREEN_EPILOGUE_3,
+    RE3_UI_SCREEN_EPILOGUE_4,
+    RE3_UI_SCREEN_EPILOGUE_5,
+    RE3_UI_SCREEN_EPILOGUE_6,
+    RE3_UI_SCREEN_EPILOGUE_7,
+    RE3_UI_SCREEN_COUNT
+} re3_ui_screen_t;
+
+typedef struct {
+    bool has_hd;
+    bool fallback_native_ui;
+    uint32_t gl_tex_id;
+    int width;
+    int height;
+    char file_path[512];
+    char screen_name[64];
+} re3_ui_backdrop_info_t;
+
+typedef struct {
+    uint64_t backdrop_hits;
+    uint64_t backdrop_misses;
+    uint64_t sprite_hits;
+    uint64_t sprite_misses;
+    uint32_t active_textures;
+} re3_hd_ui_metrics_t;
+
+/**
+ * Initializes the HD UI subsystem with the active texture pack path.
+ * @param pack_path Path to the texture pack directory (e.g. "mods/textures/SeamlessHD").
+ */
+void re3_hd_ui_init(const char* pack_path);
+
+/**
+ * Shuts down the HD UI subsystem and frees all allocated GL textures and caches.
+ */
+void re3_hd_ui_shutdown(void);
+
+/**
+ * Returns true if the HD UI subsystem is initialized and active.
+ */
+bool re3_hd_ui_is_active(void);
+
+/**
+ * Resolves the candidate file path for a UI screen backdrop.
+ * Performs direct lookup, uppercase/extension variants, and case-insensitive fallback.
+ *
+ * @param screen_name Canonical name (e.g. "inventory", "map", "status_fine", "epilogue_0")
+ * @param out_path    Buffer to receive the resolved filesystem path
+ * @param max_len     Capacity of out_path buffer
+ * @return Pointer to out_path on success, NULL if not found.
+ */
+const char* re3_hd_ui_resolve_backdrop_path(const char* screen_name, char* out_path, size_t max_len);
+
+/**
+ * Resolves the status ECG backdrop based on player condition byte (0x000CCC97).
+ * Condition mappings:
+ *   0x04 -> status_fine
+ *   0x03 -> status_caution
+ *   0x02 -> status_danger
+ *   0x01 -> status_poison
+ *   Unknown (e.g. 0xFF) -> status_fine
+ */
+const char* re3_hd_ui_resolve_status_backdrop(uint8_t condition, char* out_path, size_t max_len);
+
+/**
+ * Loads and caches a UI backdrop texture into OpenGL.
+ *
+ * @param screen_name Canonical screen name
+ * @param out_info    Pointer to receive loaded backdrop metadata
+ * @return true if HD backdrop is loaded, false if native fallback applies.
+ */
+bool re3_hd_ui_load_backdrop(const char* screen_name, re3_ui_backdrop_info_t* out_info);
+
+/**
+ * Returns true if an HD backdrop texture is available and cached for the screen.
+ */
+bool re3_hd_ui_has_backdrop(const char* screen_name);
+
+/**
+ * Returns the GLuint texture handle for the specified backdrop, or 0 if missing.
+ */
+uint32_t re3_hd_ui_get_backdrop_gl_tex(const char* screen_name);
+
+/**
+ * Blits an HD backdrop directly into the target FBO (s_hr_fbo) at native aspect ratio.
+ *
+ * @param screen_name Canonical screen name
+ * @param fbo         Target Framebuffer Object handle
+ * @param width       Target FBO viewport width
+ * @param height      Target FBO viewport height
+ * @return true on successful blit, false if native UI fallback is needed.
+ */
+bool re3_hd_ui_render_backdrop(const char* screen_name, uint32_t fbo, int width, int height);
+
+/**
+ * Tests whether a drawn quad represents a full-screen or screen-spanning 2D menu quad.
+ */
+bool re3_hd_ui_is_fullscreen_quad(int32_t x0, int32_t y0, int32_t w, int32_t h);
+
+/**
+ * Detects the active UI screen from guest RAM memory indicators (0x000CCC97, 0x000D1F3E, etc.).
+ * Returns canonical screen name string, or NULL if standard room gameplay is active.
+ */
+const char* re3_hd_ui_detect_screen_from_memory(void);
+
+/**
+ * Intercepts a potential menu quad in the GPU pipeline.
+ * If recognized as a UI backdrop, renders HD backdrop to s_hr_fbo and returns true
+ * (signaling that the native low-res quad should be skipped).
+ */
+bool re3_hd_ui_intercept_menu_quad(int32_t x0, int32_t y0, int32_t w, int32_t h,
+                                  uint16_t tpage, uint16_t clut,
+                                  uint32_t fbo, int fb_w, int fb_h);
+
+/**
+ * Binds and returns GLuint texture handle for a replacement UI sprite (Feature 13).
+ * Returns 0 if no replacement exists (transparent fallback).
+ */
+uint32_t re3_hd_ui_bind_sprite(uint64_t hash);
+
+/**
+ * Retrieves performance metrics for the HD UI subsystem.
+ */
+void re3_hd_ui_get_metrics(re3_hd_ui_metrics_t* out_metrics);
+
+/**
+ * Optional memory reader hook for guest RAM inspection (defaults to psx_read_byte).
+ */
+typedef uint8_t (*re3_hd_ui_mem_reader_fn)(uint32_t addr);
+void re3_hd_ui_set_memory_reader(re3_hd_ui_mem_reader_fn reader);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* RE3_HD_UI_H */
