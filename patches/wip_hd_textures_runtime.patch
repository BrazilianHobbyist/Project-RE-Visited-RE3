+
+static GLuint compile_shader(GLenum type, const char* src) {
+    if (!p_glCreateShader || !p_glShaderSource || !p_glCompileShader) return 0;
+    GLuint s = p_glCreateShader(type);
+    if (!s) return 0;
+    p_glShaderSource(s, 1, &src, nullptr);
+    p_glCompileShader(s);
+    GLint ok = 0;
+    p_glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        p_glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+static bool init_blit_pipeline() {
+    if (s_blit_program != 0) return true;
+    query_gl_caps();
+    if (!p_glCreateShader || !p_glCreateProgram || !p_glUseProgram) return false;
+
+    const char* vs_src =
+        "#version 330 core\n"
+        "out vec2 v_uv;\n"
+        "void main() {\n"
+        "    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+        "    v_uv = vec2(p.x, 1.0 - p.y);\n"
+        "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+        "}\n";
+
+    const char* fs_src =
+        "#version 330 core\n"
+        "in vec2 v_uv;\n"
+        "out vec4 fragColor;\n"
+        "uniform sampler2D u_tex;\n"
+        "void main() {\n"
+        "    fragColor = texture(u_tex, v_uv);\n"
+        "}\n";
+
+    GLuint vs = compile_shader(GL_VERTEX_SHADER, vs_src);
+    GLuint fs = compile_shader(GL_FRAGMENT_SHADER, fs_src);
+    if (!vs || !fs) {
+        if (vs) p_glDeleteShader(vs);
+        if (fs) p_glDeleteShader(fs);
+        return false;
+    }
+
+    s_blit_program = p_glCreateProgram();
+    p_glAttachShader(s_blit_program, vs);
+    p_glAttachShader(s_blit_program, fs);
+    p_glLinkProgram(s_blit_program);
+
+    p_glDeleteShader(vs);
+    p_glDeleteShader(fs);
+
+    GLint ok = 0;
+    p_glGetProgramiv(s_blit_program, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        p_glDeleteProgram(s_blit_program);
+        s_blit_program = 0;
+        return false;
+    }
+
+    s_u_tex = p_glGetUniformLocation(s_blit_program, "u_tex");
+    if (p_glGenVertexArrays) {
+        p_glGenVertexArrays(1, &s_blit_vao);
+    }
+    return true;
+}
+
+static bool decode_png_to_rgba(const std::string& path, std::vector<uint8_t>& out_rgba, int& out_w, int& out_h) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file.is_open()) return false;
+
+    std::streamsize size = file.tellg();
+    if (size <= 8 || size > 64 * 1024 * 1024) return false;
+
+    file.seekg(0, std::ios::beg);
+    std::vector<uint8_t> buffer(static_cast<size_t>(size));
+    if (!file.read(reinterpret_cast<char*>(buffer.data()), size)) return false;
+
+    // Validate PNG signature: 89 50 4E 47 0D 0A 1A 0A
+    if (buffer.size() < 8 ||
+        buffer[0] != 0x89 || buffer[1] != 'P' || buffer[2] != 'N' || buffer[3] != 'G' ||
+        buffer[4] != 0x0D || buffer[5] != 0x0A || buffer[6] != 0x1A || buffer[7] != 0x0A) {
+        return false;
+    }
+
+    int comp = 0;
+    unsigned char* decoded = stbi_load_from_memory(buffer.data(), static_cast<int>(buffer.size()), &out_w, &out_h, &comp, 4);
+    if (!decoded || out_w <= 0 || out_h <= 0) {
+        if (decoded) stbi_image_free(decoded);
+        return false;
+    }
+
+    out_rgba.assign(decoded, decoded + (out_w * out_h * 4));
+    stbi_image_free(decoded);
+    return true;
+}
+
+static uint8_t read_guest_ram(uint32_t addr) {
+    if (s_custom_mem_reader) {
+        return s_custom_mem_reader(addr);
+    }
+    return psx_read_byte(addr);
+}
