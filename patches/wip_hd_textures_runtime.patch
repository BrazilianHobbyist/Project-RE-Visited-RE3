diff --git a/runtime/include/xxhash.h b/runtime/include/xxhash.h
new file mode 100644
index 00000000..c6914883
--- /dev/null
+++ b/runtime/include/xxhash.h
@@ -0,0 +1,165 @@
+#ifndef PSXRECOMP_XXHASH_H
+#define PSXRECOMP_XXHASH_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifndef XXH_INLINE_ALL
+#define XXH_INLINE_ALL 1
+#endif
+
+typedef uint64_t XXH64_hash_t;
+
+typedef struct {
+    uint64_t total_len;
+    uint64_t v1, v2, v3, v4;
+    uint64_t mem64[4];
+    uint32_t memsize;
+    uint32_t reserved;
+} XXH64_state_t;
+
+#define XXH_PRIME64_1 0x9E3779B185EBCA87ULL
+#define XXH_PRIME64_2 0xC2B2AE3D27D4EB4FULL
+#define XXH_PRIME64_3 0x165667B19E3779F9ULL
+#define XXH_PRIME64_4 0x85EBCA77C2B2AE63ULL
+#define XXH_PRIME64_5 0x27D4EB2F165667C5ULL
+
+static inline uint64_t XXH_rotl64(uint64_t x, int r) {
+    return (x << r) | (x >> (64 - r));
+}
+
+static inline uint64_t XXH64_round(uint64_t acc, uint64_t input) {
+    acc += input * XXH_PRIME64_2;
+    acc = XXH_rotl64(acc, 31);
+    acc *= XXH_PRIME64_1;
+    return acc;
+}
+
+static inline uint64_t XXH64_mergeRound(uint64_t acc, uint64_t val) {
+    val = XXH64_round(0, val);
+    acc ^= val;
+    acc = acc * XXH_PRIME64_1 + XXH_PRIME64_4;
+    return acc;
+}
+
+static inline void XXH64_reset(XXH64_state_t* state, XXH64_hash_t seed) {
+    if (!state) return;
+    memset(state, 0, sizeof(*state));
+    state->v1 = seed + XXH_PRIME64_1 + XXH_PRIME64_2;
+    state->v2 = seed + XXH_PRIME64_2;
+    state->v3 = seed + 0;
+    state->v4 = seed - XXH_PRIME64_1;
+    state->total_len = 0;
+    state->memsize = 0;
+}
+
+static inline void XXH64_update(XXH64_state_t* state, const void* input, size_t len) {
+    if (!state || !input || len == 0) return;
+    const uint8_t* p = (const uint8_t*)input;
+    const uint8_t* const bEnd = p + len;
+    state->total_len += len;
+
+    if (state->memsize + len < 32) {
+        memcpy(((uint8_t*)state->mem64) + state->memsize, input, len);
+        state->memsize += (uint32_t)len;
+        return;
+    }
+
+    if (state->memsize > 0) {
+        size_t fill = 32 - state->memsize;
+        memcpy(((uint8_t*)state->mem64) + state->memsize, p, fill);
+        const uint64_t* p64 = state->mem64;
+        state->v1 = XXH64_round(state->v1, p64[0]);
+        state->v2 = XXH64_round(state->v2, p64[1]);
+        state->v3 = XXH64_round(state->v3, p64[2]);
+        state->v4 = XXH64_round(state->v4, p64[3]);
+        p += fill;
+        state->memsize = 0;
+    }
+
+    const uint8_t* const limit = bEnd - 32;
+    while (p <= limit) {
+        uint64_t k1, k2, k3, k4;
+        memcpy(&k1, p, 8);
+        memcpy(&k2, p + 8, 8);
+        memcpy(&k3, p + 16, 8);
+        memcpy(&k4, p + 24, 8);
+        state->v1 = XXH64_round(state->v1, k1);
+        state->v2 = XXH64_round(state->v2, k2);
+        state->v3 = XXH64_round(state->v3, k3);
+        state->v4 = XXH64_round(state->v4, k4);
+        p += 32;
+    }
+
+    if (p < bEnd) {
+        size_t rem = (size_t)(bEnd - p);
+        memcpy(state->mem64, p, rem);
+        state->memsize = (uint32_t)rem;
+    }
+}
+
+static inline XXH64_hash_t XXH64_digest(const XXH64_state_t* state) {
+    if (!state) return 0;
+    uint64_t h64;
+    if (state->total_len >= 32) {
+        h64 = XXH_rotl64(state->v1, 1) + XXH_rotl64(state->v2, 7) +
+              XXH_rotl64(state->v3, 12) + XXH_rotl64(state->v4, 18);
+        h64 = XXH64_mergeRound(h64, state->v1);
+        h64 = XXH64_mergeRound(h64, state->v2);
+        h64 = XXH64_mergeRound(h64, state->v3);
+        h64 = XXH64_mergeRound(h64, state->v4);
+    } else {
+        h64 = state->v3 + XXH_PRIME64_5;
+    }
+
+    h64 += state->total_len;
+
+    const uint8_t* p = (const uint8_t*)state->mem64;
+    const uint8_t* const bEnd = p + state->memsize;
+
+    while (p + 8 <= bEnd) {
+        uint64_t k1;
+        memcpy(&k1, p, 8);
+        k1 = XXH64_round(0, k1);
+        h64 = XXH_rotl64(h64 ^ k1, 27) * XXH_PRIME64_1 + XXH_PRIME64_4;
+        p += 8;
+    }
+
+    if (p + 4 <= bEnd) {
+        uint32_t k1;
+        memcpy(&k1, p, 4);
+        h64 = XXH_rotl64(h64 ^ ((uint64_t)k1 * XXH_PRIME64_1), 23) * XXH_PRIME64_2 + XXH_PRIME64_3;
+        p += 4;
+    }
+
+    while (p < bEnd) {
+        uint8_t k1 = *p++;
+        h64 = XXH_rotl64(h64 ^ ((uint64_t)k1 * XXH_PRIME64_5), 11) * XXH_PRIME64_1;
+    }
+
+    h64 ^= h64 >> 33;
+    h64 *= XXH_PRIME64_2;
+    h64 ^= h64 >> 29;
+    h64 *= XXH_PRIME64_3;
+    h64 ^= h64 >> 32;
+
+    return h64;
+}
+
+static inline XXH64_hash_t XXH64(const void* input, size_t length, XXH64_hash_t seed) {
+    XXH64_state_t state;
+    XXH64_reset(&state, seed);
+    XXH64_update(&state, input, length);
+    return XXH64_digest(&state);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSXRECOMP_XXHASH_H */
