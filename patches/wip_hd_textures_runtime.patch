+void re3_hd_ui_init(const char* pack_path) {
+    std::lock_guard<std::mutex> lock(s_ui_mutex);
+
+    // Clean previous state
+    re3_hd_ui_shutdown();
+
+    const re3_texture_config_t* cfg = re3_textures_get_config();
+    if (!cfg || !cfg->hd_ui) {
+        s_is_active = false;
+        return;
+    }
+
+    if (!pack_path || pack_path[0] == '\0') {
+        s_is_active = false;
+        return;
+    }
+
+    // Security path traversal check on pack path
+    std::string pp = pack_path;
+    if (pp.find("..") != std::string::npos) {
+        s_is_active = false;
+        return;
+    }
+
+    fs::path pack_fs(pp);
+    fs::path ui_fs = pack_fs / "ui";
+    std::error_code ec;
+    if (!fs::exists(ui_fs, ec) || !fs::is_directory(ui_fs, ec)) {
+        s_is_active = false;
+        return;
+    }
+
+    s_pack_path = pp;
+    s_ui_dir = ui_fs.generic_string();
+    s_is_active = true;
+    s_metrics = {0, 0, 0, 0, 0};
+}
+
+void re3_hd_ui_shutdown(void) {
+    // Delete all GL textures
+    if (SDL_GL_GetCurrentContext()) {
+        for (auto& kv : s_backdrop_cache) {
+            if (kv.second.gl_tex_id != 0) {
+                glDeleteTextures(1, &kv.second.gl_tex_id);
+            }
+        }
+        for (auto& kv : s_sprite_cache) {
+            if (kv.second != 0) {
+                glDeleteTextures(1, &kv.second);
+            }
+        }
+        if (s_blit_vao && p_glDeleteVertexArrays) {
+            p_glDeleteVertexArrays(1, &s_blit_vao);
+            s_blit_vao = 0;
+        }
+        if (s_blit_program && p_glDeleteProgram) {
+            p_glDeleteProgram(s_blit_program);
+            s_blit_program = 0;
+        }
+    }
+
+    s_backdrop_cache.clear();
+    s_backdrop_lru.clear();
+    s_sprite_cache.clear();
+    s_missing_sprites.clear();
+    s_sprite_lru.clear();
+
+    s_is_active = false;
+    s_pack_path.clear();
+    s_ui_dir.clear();
+}
