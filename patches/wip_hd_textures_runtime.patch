+bool load_gl_extensions() {
+    if (s_gl_ptrs_loaded) return true;
+
+    p_glCreateShader = (PFN_glCreateShader)SDL_GL_GetProcAddress("glCreateShader");
+    p_glShaderSource = (PFN_glShaderSource)SDL_GL_GetProcAddress("glShaderSource");
+    p_glCompileShader = (PFN_glCompileShader)SDL_GL_GetProcAddress("glCompileShader");
+    p_glGetShaderiv = (PFN_glGetShaderiv)SDL_GL_GetProcAddress("glGetShaderiv");
+    p_glDeleteShader = (PFN_glDeleteShader)SDL_GL_GetProcAddress("glDeleteShader");
+    p_glCreateProgram = (PFN_glCreateProgram)SDL_GL_GetProcAddress("glCreateProgram");
+    p_glAttachShader = (PFN_glAttachShader)SDL_GL_GetProcAddress("glAttachShader");
+    p_glLinkProgram = (PFN_glLinkProgram)SDL_GL_GetProcAddress("glLinkProgram");
+    p_glGetProgramiv = (PFN_glGetProgramiv)SDL_GL_GetProcAddress("glGetProgramiv");
+    p_glUseProgram = (PFN_glUseProgram)SDL_GL_GetProcAddress("glUseProgram");
+    p_glDeleteProgram = (PFN_glDeleteProgram)SDL_GL_GetProcAddress("glDeleteProgram");
+    p_glGetUniformLocation = (PFN_glGetUniformLocation)SDL_GL_GetProcAddress("glGetUniformLocation");
+    p_glUniform1i = (PFN_glUniform1i)SDL_GL_GetProcAddress("glUniform1i");
+    p_glGenVertexArrays = (PFN_glGenVertexArrays)SDL_GL_GetProcAddress("glGenVertexArrays");
+    p_glBindVertexArray = (PFN_glBindVertexArray)SDL_GL_GetProcAddress("glBindVertexArray");
+    p_glDeleteVertexArrays = (PFN_glDeleteVertexArrays)SDL_GL_GetProcAddress("glDeleteVertexArrays");
+    p_glBindFramebuffer = (PFN_glBindFramebuffer)SDL_GL_GetProcAddress("glBindFramebuffer");
+    p_glActiveTexture = (PFN_glActiveTexture)SDL_GL_GetProcAddress("glActiveTexture");
+
+    if (!p_glCreateShader || !p_glShaderSource || !p_glCompileShader || !p_glCreateProgram ||
+        !p_glAttachShader || !p_glLinkProgram || !p_glUseProgram || !p_glGenVertexArrays ||
+        !p_glBindVertexArray) {
+        return false;
+    }
+
+    s_gl_ptrs_loaded = true;
+    return true;
+}
+
+GLuint compile_shader(GLenum type, const char* src) {
+    GLuint s = p_glCreateShader(type);
+    p_glShaderSource(s, 1, &src, nullptr);
+    p_glCompileShader(s);
+    GLint ok = 0;
+    p_glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        p_glDeleteShader(s);
+        return 0;
+    }
+    return s;
+}
+
+bool init_blit_pipeline() {
+    if (s_blit_program != 0) return true;
+    if (!load_gl_extensions()) return false;
+
+    const char* vs_src =
+        "#version 330 core\n"
+        "out vec2 v_uv;\n"
+        "void main() {\n"
+        "    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+        "    v_uv = vec2(p.x, 1.0 - p.y);\n"
+        "    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+        "}\n";
+
+    const char* fs_src =
+        "#version 330 core\n"
+        "in vec2 v_uv;\n"
+        "out vec4 fragColor;\n"
+        "uniform sampler2D u_tex;\n"
+        "void main() {\n"
+        "    fragColor = texture(u_tex, v_uv);\n"
+        "}\n";
+
+    GLuint vs = compile_shader(GL_VERTEX_SHADER, vs_src);
+    GLuint fs = compile_shader(GL_FRAGMENT_SHADER, fs_src);
+    if (!vs || !fs) {
+        if (vs) p_glDeleteShader(vs);
+        if (fs) p_glDeleteShader(fs);
+        return false;
+    }
+
+    s_blit_program = p_glCreateProgram();
+    p_glAttachShader(s_blit_program, vs);
+    p_glAttachShader(s_blit_program, fs);
+    p_glLinkProgram(s_blit_program);
+
+    p_glDeleteShader(vs);
+    p_glDeleteShader(fs);
+
+    GLint ok = 0;
+    p_glGetProgramiv(s_blit_program, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        p_glDeleteProgram(s_blit_program);
+        s_blit_program = 0;
+        return false;
+    }
+
+    s_u_tex = p_glGetUniformLocation(s_blit_program, "u_tex");
+    p_glGenVertexArrays(1, &s_blit_vao);
+    return true;
+}
+
+bool decode_png_file(const std::string& path, DecodedImage& out_img) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file.is_open()) return false;
+
+    std::streamsize size = file.tellg();
+    if (size <= 8 || size > 64 * 1024 * 1024) return false;
+
+    file.seekg(0, std::ios::beg);
+    std::vector<uint8_t> buffer(static_cast<size_t>(size));
+    if (!file.read(reinterpret_cast<char*>(buffer.data()), size)) return false;
+
+    // Validate PNG signature: 89 50 4E 47 0D 0A 1A 0A
+    if (buffer.size() < 8 ||
+        buffer[0] != 0x89 || buffer[1] != 'P' || buffer[2] != 'N' || buffer[3] != 'G' ||
+        buffer[4] != 0x0D || buffer[5] != 0x0A || buffer[6] != 0x1A || buffer[7] != 0x0A) {
+        return false;
+    }
+
+    int w = 0, h = 0, comp = 0;
+    unsigned char* decoded = stbi_load_from_memory(buffer.data(), static_cast<int>(buffer.size()), &w, &h, &comp, 4);
+    if (!decoded) return false;
+    if (w <= 0 || h <= 0) {
+        stbi_image_free(decoded);
+        return false;
+    }
+
+    out_img.width = static_cast<uint32_t>(w);
+    out_img.height = static_cast<uint32_t>(h);
+    out_img.rgba.assign(decoded, decoded + (w * h * 4));
+    stbi_image_free(decoded);
+    return true;
+}
+
+void worker_thread_func() {
+#ifdef _WIN32
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+#endif
+
+    while (!s_stop) {
+        bool has_job = false;
+        uint32_t key = kInvalidBgKey;
+        std::string resolved_path;
+
+        {
+            std::unique_lock<std::mutex> lock(s_mutex);
+            s_cv.wait(lock, [&] {
+                return s_stop.load() || !s_queue.empty();
+            });
+
+            if (s_stop) break;
+
+            if (!s_queue.empty()) {
+                key = s_queue.front();
+                s_queue.pop_front();
+
+                auto it = s_entries.find(key);
+                if (it != s_entries.end()) {
+                    if (it->second.state == BgState::ReadyGL || it->second.state == BgState::ReadyRAM) {
+                        continue; // Already decoded/uploaded
+                    }
+                    if (it->second.filepath.empty()) {
+                        it->second.state = BgState::Failed;
+                        continue;
+                    }
+                    it->second.state = BgState::Loading;
+                    resolved_path = it->second.filepath;
+                    has_job = true;
+                }
+            }
+        }
+
+        if (!has_job || resolved_path.empty()) continue;
+
+        DecodedImage img;
+        bool success = decode_png_file(resolved_path, img);
+
+        {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            auto it = s_entries.find(key);
+            if (it != s_entries.end()) {
+                if (success) {
+                    it->second.width = img.width;
+                    it->second.height = img.height;
+                    it->second.staging_pixels = std::make_shared<DecodedImage>(std::move(img));
+                    it->second.state = BgState::ReadyRAM;
+                } else {
+                    it->second.state = BgState::Failed;
+                }
+            }
+        }
+    }
+}
+
+void upload_entry_to_gl(BgTextureEntry& entry) {
+    if (entry.state != BgState::ReadyRAM || !entry.staging_pixels) return;
+
+    glGenTextures(1, &entry.gl_tex_id);
+    glBindTexture(GL_TEXTURE_2D, entry.gl_tex_id);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8,
+                 entry.width, entry.height, 0,
+                 GL_RGBA, GL_UNSIGNED_BYTE,
+                 entry.staging_pixels->rgba.data());
+
+    // Free staging pixels immediately to keep near-zero host CPU memory
+    entry.staging_pixels.reset();
+    entry.state = BgState::ReadyGL;
+
+    // Update LRU tracking
+    s_lru_list.remove(entry.key);
+    s_lru_list.push_front(entry.key);
+
+    // Eviction if capacity exceeded
+    size_t resident_count = 0;
+    for (const auto& kv : s_entries) {
+        if (kv.second.gl_tex_id != 0) resident_count++;
+    }
+
+    if (resident_count > kMaxCachedTextures) {
+        for (auto it = s_lru_list.rbegin(); it != s_lru_list.rend(); ++it) {
+            uint32_t victim_key = *it;
+            if (victim_key == bg_make_key(s_active_stage, s_active_room, s_active_cut)) {
+                continue; // Do not evict active cut
+            }
+            auto ent_it = s_entries.find(victim_key);
+            if (ent_it != s_entries.end() && ent_it->second.gl_tex_id != 0) {
+                glDeleteTextures(1, &ent_it->second.gl_tex_id);
+                ent_it->second.gl_tex_id = 0;
+                ent_it->second.staging_pixels.reset();
+                s_metrics_evictions++;
+                s_lru_list.erase(std::next(it).base());
+                s_entries.erase(ent_it);
+                break;
+            }
+        }
+    }
+}
+
+static bool str_ends_with(const std::string& str, const std::string& suffix) {
+    return str.size() >= suffix.size() &&
+           str.compare(str.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
