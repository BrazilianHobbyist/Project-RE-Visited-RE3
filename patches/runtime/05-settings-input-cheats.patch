 /* Build the active-low PSX button word from a controller's input.ini map. When
  * suppress_stick_axes is set (the pad is presenting as analog this frame), the
  * left/right analog-stick axes do NOT contribute button bits — see
  * source_is_stick_axis above. Digital mode passes false, so ls_* stick
  * directions still fold onto the D-pad via fold_bit. */
+/* RE3 screen-relative movement (modern_controls).
+ *
+ * Addresses found by diffing RAM dumps of SLUS-00923 (no public RAM map):
+ *   player work 0x800CCBC4: +0x04 mode (1 = normal), +0x05 routine
+ *     (0 idle .. 4 = free movement states, as on the PC build), +0x34/+0x3C
+ *     world X/Z (int32), +0x6E facing (int16, 4096 = 360 deg).
+ *     Facing convention: deg = -atan2(dz, dx).
+ *   camera view matrix 0x80098990: 3x3 int16 (4096 = 1.0), row 0 = screen
+ *     right on the ground plane; translation int32 x3 at +0x14.
+ *   0x800D4314: bits 0x00080808 set while inventory / map / message is open.
+ *
+ * Stick up = into the screen along the camera's view on the ground, stick
+ * right = the camera's right axis: both fixed for the whole camera. The facing
+ * is turned toward the target at a capped rate and the game is fed "forward"
+ * (+ Square to run on a full tilt), so walking/running animations stay
+ * native. Holding the stick through a camera cut keeps the previous world
+ * heading until the stick turns more than 45 deg or is released (a cut to a
+ * camera facing the other way holds until release), then the heading glides
+ * to the new reference over ~0.2 s. The physical D-pad always drives the tank
+ * controls. Design follows the alternate
+ * controls idea in Fusion-Fix (PC build); no code from it is used. */
+static int re3_wrap_angle(int a) { return ((a + 2048) & 4095) - 2048; }
+
+/* Per-frame decision trace of the modern controls, stored in the debug
+ * server's frame history (game_data, 32 bytes) and read back with
+ * frame_history_dump. Debug-tools builds only; no effect on behaviour. */
+enum Re3CtrlPath : uint8_t {
+    RE3_CTRL_NONE = 0,
+    RE3_CTRL_FREE = 1,          /* screen-relative turn + walk/run */
+    RE3_CTRL_FORWARD_ONLY = 2,  /* stairs / pushing: forward only */
+    RE3_CTRL_EXIT_INACTIVE = 3, /* no RAM / game not started / aiming */
+    RE3_CTRL_EXIT_STATE = 4,    /* UI open, mode != 1 or routine > 4 */
+    RE3_CTRL_EXIT_NO_AXIS = 5,  /* degenerate camera axis */
+    RE3_CTRL_DEADZONE = 6,      /* stick below 0.26 */
+    RE3_CTRL_DPAD = 7,          /* physical D-pad held: tank path */
+    RE3_CTRL_INJECT_SKIP = 8,   /* debug injection seen, not routed (mode = modern on) */
+};
+#pragma pack(push, 1)
+struct Re3CtrlTrace {
+    uint8_t  magic;             /* 'C' */
+    uint8_t  path;              /* Re3CtrlPath; tank fallback ran if path is 3..5 */
+    uint8_t  mode, routine;
+    int16_t  lx, ly;            /* raw SDL stick */
+    int16_t  yaw_before, yaw_after;
+    int16_t  target_raw, target;   /* before / after the camera-cut hold */
+    uint8_t  hold, cut;
+    uint16_t clear;             /* buttons injected (active-high) */
+    int16_t  fx, fz;            /* forward axis * 1000 */
+    int32_t  flen;              /* camera-to-Jill ground distance (pre-normalise) */
+    uint32_t cam_sig;
+};
+#pragma pack(pop)
+static_assert(sizeof(Re3CtrlTrace) == 32, "fits PSXFrameRecord::game_data");
+
+static void re3_ctrl_trace_emit(const Re3CtrlTrace& t) {
+#ifndef PSX_NO_DEBUG_TOOLS
+    debug_server_set_game_data(&t, (int)sizeof t);
+#else
+    (void)t;
+#endif
+}
+
+static bool re3_screen_relative_move(int16_t lx, int16_t ly, double mag,
+                                     bool aiming, uint16_t* buttons) {
+    extern uint64_t s_frame_count;
+    static uint64_t s_last_frame = ~0ull;
+    static bool s_last_handled = false;
+    static uint16_t s_last_clear = 0;
+    static bool s_running = false;
+    static uint32_t s_cam_sig = 0;
+    static bool s_hold = false;
+    static int s_hold_yaw = 0;
+    static double s_hold_stick = 0.0;
+    static bool s_hold_firm = false;        /* cut to a nearly opposite camera */
+    static double s_prev_fx = 0.0, s_prev_fz = 0.0;
+    static int s_blend_left = 0, s_blend_from = 0;
+    Re3CtrlTrace tr = {};
+    tr.magic = 'C';
+    tr.lx = lx; tr.ly = ly;
+
+    if (!g_psx_ram || !fntrace_is_game_started() || aiming) {
+        s_hold = false;
+        tr.path = RE3_CTRL_EXIT_INACTIVE;
+        re3_ctrl_trace_emit(tr);
+        return false;
+    }
+    /* controller_pad_buttons can run several times per frame; turn once. */
+    if (s_last_frame == s_frame_count) {
+        if (s_last_handled) *buttons &= (uint16_t)~s_last_clear;
+        return s_last_handled;
+    }
+    /* A frame without a call means the stick was released (dead zone, D-pad,
+     * UI): the camera-cut heading hold ends there. */
+    if (s_last_frame + 1 != s_frame_count) { s_hold = false; s_blend_left = 0; }
+    s_last_frame = s_frame_count;
+    s_last_handled = false;
+    s_last_clear = 0;
+
+    uint8_t* ram = g_psx_ram;
+    const uint32_t ui_flags = *(uint32_t*)(ram + 0x000D4314);
+    uint8_t* pl = ram + 0x000CCBC4;
+    const uint8_t mode = pl[0x04], routine = pl[0x05];
+    /* Native animation states driven by forward input only: pushing (9) and
+     * stairs (10, 14, 15). Never rotate or inject turns there — that breaks
+     * the stair animation. */
+    const bool forward_only = routine == 9 || routine == 10 ||
+                              routine == 14 || routine == 15;
+    tr.mode = mode; tr.routine = routine;
+    tr.yaw_before = tr.yaw_after = (int16_t)(*(int16_t*)(pl + 0x6E) & 4095);
+    if ((ui_flags & 0x00080808u) != 0 || mode != 1 ||
+        (routine > 4 && !forward_only)) {
+        s_hold = false;
+        tr.path = RE3_CTRL_EXIT_STATE;
+        re3_ctrl_trace_emit(tr);
+        return false;
+    }
+
+    const int16_t* R = (const int16_t*)(ram + 0x00098990);
+    const int32_t* T = (const int32_t*)(ram + 0x00098990 + 0x14);
+    double m[3][3];
+    for (int r = 0; r < 3; r++)
+        for (int c = 0; c < 3; c++) m[r][c] = R[r * 3 + c] / 4096.0;
+    const double cam_x = -(m[0][0] * T[0] + m[1][0] * T[1] + m[2][0] * T[2]);  /* trace only */
+    const double cam_z = -(m[0][2] * T[0] + m[1][2] * T[1] + m[2][2] * T[2]);
+    const double px = (double)*(int32_t*)(pl + 0x34);
+    const double pz = (double)*(int32_t*)(pl + 0x3C);
+
+    /* Screen axes on the ground, fixed for the whole camera: right is the
+     * camera's X axis; forward is perpendicular to it, pointing along the view
+     * direction (or, for a camera looking nearly straight down, toward the
+     * top of the screen). The camera-to-Jill vector used before turned with
+     * every step, so a held stick drew an arc and flipped near the camera
+     * (measured 2026-10-27 in the RPD hall: ~32 deg of drift without a cut). */
+    tr.flen = (int32_t)std::lround(std::sqrt((px - cam_x) * (px - cam_x) +
+                                             (pz - cam_z) * (pz - cam_z)));
+    double rx = m[0][0], rz = m[0][2];
+    const double rlen = std::sqrt(rx * rx + rz * rz);
+    if (rlen < 1e-3) {
+        tr.path = RE3_CTRL_EXIT_NO_AXIS;
+        re3_ctrl_trace_emit(tr);
+        return false;
+    }
+    rx /= rlen; rz /= rlen;
+    double fx = -rz, fz = rx;
+    double vx = m[2][0], vz = m[2][2];
+    if (vx * vx + vz * vz < 0.04) { vx = -m[1][0]; vz = -m[1][2]; }  /* overhead */
+    if (fx * vx + fz * vz < 0.0) { fx = -fx; fz = -fz; }
+    tr.fx = (int16_t)std::lround(fx * 1000.0);
+    tr.fz = (int16_t)std::lround(fz * 1000.0);
+
+    const double sx = (double)lx / 32767.0, sy = -(double)ly / 32767.0;
+    const double dx = sx * rx + sy * fx, dz = sx * rz + sy * fz;
+    int target = (int)std::lround(-std::atan2(dz, dx) * 4096.0 / (2.0 * 3.141592653589793)) & 4095;
+
+    /* Camera-cut heading hold. */
+    uint32_t sig = 2166136261u;
+    for (int i = 0; i < 9; i++) sig = (sig ^ (uint16_t)R[i]) * 16777619u;
+    const double stick_deg = std::atan2(sy, sx) * 180.0 / 3.141592653589793;
+    int16_t* p_yaw = (int16_t*)(pl + 0x6E);
+    const int yaw = *p_yaw & 4095;
+    tr.target_raw = (int16_t)target;
+    tr.cam_sig = sig;
+    if (sig != s_cam_sig) {
+        if (s_cam_sig != 0) {
+            s_hold = true;
+            s_hold_yaw = yaw;
+            s_hold_stick = stick_deg;
+            /* A cut to a camera facing the other way (forward axes more
+             * than 120 deg apart) turns the same stick into the opposite
+             * direction: there only releasing the stick ends the hold. */
+            s_hold_firm = fx * s_prev_fx + fz * s_prev_fz < -0.5;
+            s_blend_left = 0;
+            tr.cut = 1;
+        }
+        s_cam_sig = sig;
+    }
+    s_prev_fx = fx; s_prev_fz = fz;
+    if (s_hold) {
+        double dd = std::fabs(stick_deg - s_hold_stick);
+        if (dd > 180.0) dd = 360.0 - dd;
+        if (dd > 45.0 && !s_hold_firm) {
+            /* A deliberate new direction ends the hold; the heading glides
+             * to the new camera's reference over ~0.2 s instead of jumping. */
+            s_hold = false;
+            s_blend_left = 12;
+            s_blend_from = s_hold_yaw;
+        } else {
+            target = s_hold_yaw;
+        }
+    }
+    if (!s_hold && s_blend_left > 0) {
+        const int d = re3_wrap_angle(target - s_blend_from);
+        target = (s_blend_from + d * (12 - s_blend_left) / 12) & 4095;
+        s_blend_left--;
+    }
+    tr.hold = s_hold ? 1 : 0;
+    tr.target = (int16_t)target;
+
+    if (forward_only) {
+        uint16_t clear = 0;
+        if (std::abs(re3_wrap_angle(target - yaw)) < 1024) {
+            clear |= 0x0010u;                               /* UP */
+            if (routine != 9 && mag >= 0.70) clear |= 0x8000u; /* run on stairs */
+        }
+        *buttons &= (uint16_t)~clear;
+        s_last_clear = clear;
+        s_last_handled = true;
+        tr.path = RE3_CTRL_FORWARD_ONLY;
+        tr.clear = clear;
+        re3_ctrl_trace_emit(tr);
+        return true;
+    }
+
+    /* Turn toward the target, capped so direction changes read as turns.
+     * settings.toml [controller] modern_turn_speed, in 1/4096-turn units
+     * per frame (default 90, ~8 deg: a half turn in ~0.4 s). */
+    const int kMaxTurn = g_modern_turn_speed;
+    int diff = re3_wrap_angle(target - yaw);
+    if (diff > kMaxTurn) diff = kMaxTurn;
+    if (diff < -kMaxTurn) diff = -kMaxTurn;
+    *p_yaw = (int16_t)((yaw + diff) & 4095);
+
+    /* Walk only once roughly facing the target; run on a firm tilt
+     * (hysteresis avoids walk/run flicker at the boundary). */
+    s_running = mag >= (s_running ? 0.65 : 0.70);
+    uint16_t clear = 0;
+    if (std::abs(re3_wrap_angle(target - (*p_yaw & 4095))) < 1024) {
+        clear |= 0x0010u;                 /* UP: forward */
+        if (s_running) clear |= 0x8000u;  /* Square: run */
+    }
+    *buttons &= (uint16_t)~clear;
+    s_last_clear = clear;
+    s_last_handled = true;
+    tr.path = RE3_CTRL_FREE;
+    tr.yaw_after = (int16_t)(*p_yaw & 4095);
+    tr.clear = clear;
+    re3_ctrl_trace_emit(tr);
+    return true;
+}
+
+#ifndef PSX_NO_DEBUG_TOOLS
+/* Modern controls read the physical left stick; an injected one takes the
+ * same path (and is then centred, as the physical path suppresses the stick
+ * axes), so scripted runs exercise the real decision code. */
+static void re3_modern_inject(uint16_t* w, uint8_t st[4]) {
+    if (!g_modern_controls || (st[0] == 0x80 && st[1] == 0x80) ||
+        ((uint16_t)~*w & 0x00F0u) != 0) {
+        Re3CtrlTrace tr = {};
+        tr.magic = 'C'; tr.path = RE3_CTRL_INJECT_SKIP;
+        tr.mode = (uint8_t)(g_modern_controls ? 1 : 0);
+        tr.lx = st[0]; tr.ly = st[1]; tr.clear = (uint16_t)~*w;
+        re3_ctrl_trace_emit(tr);
+        return;
+    }
+    const int16_t lx = (int16_t)((st[0] - 128) * 256 + (st[0] > 128 ? 255 : 0));
+    const int16_t ly = (int16_t)((st[1] - 128) * 256 + (st[1] > 128 ? 255 : 0));
+    double mag = std::sqrt((double)lx * lx + (double)ly * ly) / 32767.0;
+    if (mag > 1.0) mag = 1.0;
+    if (mag < 0.26) return;
+    re3_screen_relative_move(lx, ly, mag, (*w & 0x0800u) == 0, w);
+    st[0] = st[1] = 0x80;
+}
+#endif
