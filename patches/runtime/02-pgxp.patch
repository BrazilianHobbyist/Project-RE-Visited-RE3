+/* Depth of a quad corner the GTE never projected, from the other three.
+ *
+ * A game that clips a floor quad against the near plane builds the new corner
+ * with CPU math, so it has no recorded Z, while the quad's other corners do.
+ * Leaving its triangle affine next to perspective-correct neighbours draws a
+ * visible texture break along their shared edge. A quad is planar, and on a
+ * plane 1/Z is an affine function of screen position, so the three known
+ * corners fix the plane and give 1/Z at the fourth. Packet integers are used
+ * for all four corners so they share one coordinate space. Returns 0 (keep the
+ * triangle affine) when the known corners are collinear or the result is not
+ * a plausible depth for this quad. */
+static int quad_plane_depth(const int idx[4], const uint16_t z[4], int missing,
+                            uint16_t *out) {
+    double x[3], y[3], q[3], qmin = 0.0, qmax = 0.0;
+    int n = 0;
+    for (int i = 0; i < 4; i++) {
+        if (i == missing) continue;
+        int32_t rx, ry;
+        parse_vertex(gp0_cmd_buf[idx[i]], &rx, &ry);
+        x[n] = rx; y[n] = ry; q[n] = 1.0 / (double)z[i];
+        if (n == 0 || q[n] < qmin) qmin = q[n];
+        if (n == 0 || q[n] > qmax) qmax = q[n];
+        n++;
+    }
+    int32_t mx, my;
+    parse_vertex(gp0_cmd_buf[idx[missing]], &mx, &my);
+    const double det = (x[1] - x[0]) * (y[2] - y[0]) - (x[2] - x[0]) * (y[1] - y[0]);
+    if (det > -1.0 && det < 1.0) return 0;
+    const double a = ((q[1] - q[0]) * (y[2] - y[0]) - (q[2] - q[0]) * (y[1] - y[0])) / det;
+    const double b = ((x[1] - x[0]) * (q[2] - q[0]) - (x[2] - x[0]) * (q[1] - q[0])) / det;
+    const double qm = q[0] + a * ((double)mx - x[0]) + b * ((double)my - y[0]);
+    /* A clipped corner lies on an edge of the quad: its depth cannot be far
+     * outside the known corners'. Reject extrapolations past 8x. */
+    if (!(qm > qmin / 8.0) || !(qm < qmax * 8.0)) return 0;
