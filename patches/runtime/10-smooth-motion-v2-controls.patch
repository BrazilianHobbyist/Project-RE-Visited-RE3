+        while (cap < n * 6u) cap <<= 1;
+        NAcc *tab = (NAcc *)calloc(cap, sizeof *tab);
+        for (int pass = 0; tab && pass < 2; pass++) {
+            uint32_t ntorn = 0;
+            memset(tab, 0, cap * sizeof *tab);
+            for (uint32_t j = 0; j < n; j++) {
+                const FgPrim *pr = &newer->v[j];
+                int bad = 0;
+                for (int e = 0; e < 3 && !bad; e++) {
+                    const uint32_t i0 = 3 * j + e, i1 = 3 * j + (e + 1) % 3;
+                    if (isnan(dxs[i0]) || isnan(dxs[i1])) continue;
+                    const float bx = pr->x[(e + 1) % 3] - pr->x[e], by = pr->y[(e + 1) % 3] - pr->y[e];
+                    const float ax = bx + dxs[i1] - dxs[i0], ay = by + dys[i1] - dys[i0];
+                    const float lb = sqrtf(bx * bx + by * by), la = sqrtf(ax * ax + ay * ay);
+                    bad = la > 1.5f * lb + 8.0f;
+                }
+                if (!bad) continue;
+                for (int k = 0; k < 3; k++) {
+                    const int32_t qx = (int32_t)lrintf(pr->x[k] * 16.0f), qy = (int32_t)lrintf(pr->y[k] * 16.0f);
+                    uint32_t h = ((uint32_t)qx * 73856093u ^ (uint32_t)qy * 19349663u) & (cap - 1);
+                    while (tab[h].n && (tab[h].qx != qx || tab[h].qy != qy)) h = (h + 1) & (cap - 1);
+                    tab[h].qx = qx; tab[h].qy = qy; tab[h].n = 1;
+                }
+                ntorn++;
+            }
+            if (!ntorn) break;
+            fit->torn += ntorn;
+            for (uint32_t i = 0; i < n * 3u; i++) {
+                const FgPrim *pr = &newer->v[i / 3];
+                const int32_t qx = (int32_t)lrintf(pr->x[i % 3] * 16.0f), qy = (int32_t)lrintf(pr->y[i % 3] * 16.0f);
+                uint32_t h = ((uint32_t)qx * 73856093u ^ (uint32_t)qy * 19349663u) & (cap - 1);
+                while (tab[h].n && (tab[h].qx != qx || tab[h].qy != qy)) h = (h + 1) & (cap - 1);
+                if (tab[h].n && !isnan(dxs[i])) { dxs[i] = 0.0f; dys[i] = 0.0f; }
+            }
+        }
+        free(tab);
+    }
     free(done);
     fit->clamped = clamped;
     fit->guessed = guessed;
diff --git a/runtime/src/gpu_gl_renderer.c b/runtime/src/gpu_gl_renderer.c
index aa32d3d7..dc57a1dc 100644
--- a/runtime/src/gpu_gl_renderer.c
+++ b/runtime/src/gpu_gl_renderer.c
@@ -10110,8 +10110,353 @@ static void pt_end(void) {
     p_glBindFramebuffer(PSXGL_FRAMEBUFFER, 0);
