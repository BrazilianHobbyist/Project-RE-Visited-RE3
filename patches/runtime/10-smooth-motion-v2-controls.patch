+/* Present thread, the slot's picture ready in read_fbo. Above 60 Hz a game
+ * frame lasts several refreshes: a new frame becomes K pictures spread over
+ * one game frame (K = refresh x frame period: 5 at 144 Hz for a 30 Hz game),
+ * the in-between ones at phases 1/K .. (K-1)/K from the previous frame, the
+ * frame itself last; its later VBlank's present is then not shown. At 60 Hz
+ * K = 2: the halfway picture and the frame, as on the render thread. Returns
+ * 1 when the slot is not to be shown (that later VBlank), else 0 (the caller
+ * shows it). */
+static int ifg_pt_present(int slot, GLuint read_fbo, int sw, int sh, int ww, int wh) {
+    const int flag = s_pt_ifg_flag[slot];
+    s_pt_ifg_flag[slot] = 0;
+    if (!s_ifg_on || !flag || s_ifg_broken) return 0;
+    if (flag == 2) return s_ifg_have_prev;
+    const uint64_t now = rt_now_ns();
+    if (s_ifgp_last_ns) {
+        const double dt = (double)(now - s_ifgp_last_ns) * 1e-9;
+        if (dt > 0.010 && dt < 0.060) s_ifgp_period += (dt - s_ifgp_period) * 0.1;
+    }
+    s_ifgp_last_ns = now;
+    if (sw != ww || sh != wh || ww < 16 || wh < 16 || !ifg_ensure(ww, wh)) {
+        s_ifg_have_prev = 0;
+        return 0;
+    }
+    ifg_draw_state();
+    const int cur = s_ifg_cur, prv = cur ^ 1, gap = flag >> 4;
+    p_glBindFramebuffer_raw(PSXGL_READ_FRAMEBUFFER, read_fbo);
+    p_glBindFramebuffer_raw(PSXGL_DRAW_FRAMEBUFFER, s_ifg_img_fbo[cur]);
+    p_glBlitFramebuffer(0, 0, sw, sh, 0, 0, sw, sh, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    ifg_luma(cur);
+    if (s_ifg_have_prev && gap == 2) {
+        int K = (int)(s_ifg_hz * s_ifgp_period + 0.5);
+        if (K < 2) K = 2;
+        if (K > 8) K = 8;
+        const uint64_t step = (uint64_t)(s_ifgp_period / K * 1e9);
+        ifg_estimate(cur, prv);
+        for (int i = 1; i < K; i++) {
+            const uint64_t at = now + (uint64_t)(i - 1) * step;
+            if (rt_now_ns() > at + step) continue;          /* late: skip this phase */
+            ifg_wait_until(at);
+            p_glBindFramebuffer_raw(PSXGL_DRAW_FRAMEBUFFER, 0);
+            ifg_warp(prv, cur, (float)i / (float)K, ww, wh);
+            gl_window_swap();
+            s_ifg_generated++;
+        }
+        ifg_wait_until(now + (uint64_t)(K - 1) * step);
+    }
+    s_ifg_shown_real++;
+    s_ifg_have_prev = 1;
+    s_ifg_cur = prv;
+    p_glUseProgram(0);
+    p_glBindVertexArray(0);
+    return 0;
+}
