@@ -369,6 +369,51 @@ int fg_cam_fit(const FgPrimList *older, const FgPrimList *newer, const FgCamPara
         for (uint32_t j = 0; j < newer->n * 3u; j++) verts[j].mode = FG_PLACE_UNCHANGED;
