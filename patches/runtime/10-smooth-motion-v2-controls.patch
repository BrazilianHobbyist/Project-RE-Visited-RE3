+/* Composing context current, the real present's picture in the window. */
+static void ifg_before_swap(void) {
+    if (s_pt_on) {
+        s_pt_ifg_flag[pt_current()] = !s_ifg_armed ? 0 : !s_ifg_flip ? 2 : (1 | (s_ifg_gap << 4));
+        s_ifg_armed = 0;
+        return;
+    }
+    if (!s_ifg_armed) return;
+    s_ifg_armed = 0;
+    int ww = 0, wh = 0;
+    SDL_GL_GetDrawableSize(s_win, &ww, &wh);
+    if (ww < 16 || wh < 16) return;
+    if (!s_ifg_flip) { s_ifg_shown_real++; return; }   /* the frame's second VBlank: itself */
+    if (s_ifg_time < 0) { const char *e = getenv("PSX_IFG_TIME"); s_ifg_time = e && e[0] == '1'; }
+    uint64_t t0 = 0;
+    if (s_ifg_time) { glFinish(); t0 = rt_now_ns(); }
+    GLint prog = 0, vao = 0, dfb = 0, rfb = 0, at = 0, vp[4], tb[4];
+    glGetIntegerv(0x8B8D /* CURRENT_PROGRAM */, &prog);
+    glGetIntegerv(0x85B5 /* VERTEX_ARRAY_BINDING */, &vao);
+    glGetIntegerv(0x8CA6 /* DRAW_FRAMEBUFFER_BINDING */, &dfb);
+    glGetIntegerv(0x8CAA /* READ_FRAMEBUFFER_BINDING */, &rfb);
+    glGetIntegerv(0x84E0 /* ACTIVE_TEXTURE */, &at);
+    glGetIntegerv(GL_VIEWPORT, vp);
+    for (int i = 0; i < 4; i++) {
+        p_glActiveTexture(PSXGL_TEXTURE0 + i);
+        glGetIntegerv(0x8069 /* TEXTURE_BINDING_2D */, &tb[i]);
+    }
+    const GLboolean blend = glIsEnabled(GL_BLEND), scis = glIsEnabled(GL_SCISSOR_TEST),
+                    depth = glIsEnabled(GL_DEPTH_TEST), sten = glIsEnabled(GL_STENCIL_TEST),
+                    cull = glIsEnabled(GL_CULL_FACE);
+    GLboolean cm[4];
+    glGetBooleanv(GL_COLOR_WRITEMASK, cm);
+    if (!ifg_ensure(ww, wh)) goto restore;
+    ifg_draw_state();
+    {
+        const int cur = s_ifg_cur, prv = cur ^ 1;
+        /* This frame's picture, as composed for the window. */
+        p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, 0);
+        glBindTexture(GL_TEXTURE_2D, s_ifg_img[cur]);
+        glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, ww, wh);
+        ifg_luma(cur);
+        /* Halfway from the previous frame, for a frame shown on two VBlanks. */
+        if (s_ifg_have_prev && s_ifg_gap == 2) {
+            ifg_estimate(cur, prv);
+            p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, 0);
+            ifg_warp(prv, cur, 0.5f, ww, wh);
+            s_ifg_generated++;
+        } else {
+            s_ifg_shown_real++;
+        }
+        s_ifg_have_prev = 1;
+        s_ifg_cur = prv;
+    }
+restore:
+    p_glUseProgram((GLuint)prog);
+    p_glBindVertexArray((GLuint)vao);
+    for (int i = 0; i < 4; i++) { p_glActiveTexture(PSXGL_TEXTURE0 + i); glBindTexture(GL_TEXTURE_2D, (GLuint)tb[i]); }
+    p_glActiveTexture((GLenum)at);
+    p_glBindFramebuffer_raw(PSXGL_DRAW_FRAMEBUFFER, (GLuint)dfb);
+    p_glBindFramebuffer_raw(PSXGL_READ_FRAMEBUFFER, (GLuint)rfb);
+    glViewport(vp[0], vp[1], vp[2], vp[3]);
+    if (blend) glEnable(GL_BLEND);
+    if (scis) glEnable(GL_SCISSOR_TEST);
+    if (depth) glEnable(GL_DEPTH_TEST);
+    if (sten) glEnable(GL_STENCIL_TEST);
+    if (cull) glEnable(GL_CULL_FACE);
+    glColorMask(cm[0], cm[1], cm[2], cm[3]);
+    if (s_ifg_time) {
+        glFinish();
+        const double ms = (double)(rt_now_ns() - t0) * 1e-6;
+        s_ifg_ms = s_ifg_ms > 0.0 ? s_ifg_ms * 0.95 + ms * 0.05 : ms;
+    }
+}
