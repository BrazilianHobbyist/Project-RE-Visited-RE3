+static void ifg_wait_until(uint64_t target_ns) {
+    for (;;) {
+        const uint64_t now = rt_now_ns();
+        if (now >= target_ns) return;
+        if (target_ns - now > 2000000u) SDL_Delay(1);
+    }
+}
