+/* With the present thread the interpolation runs there (ifg_pt_present):
+ * each slot carries what its present is (0 not armed, 2 a frame's later
+ * VBlank, else 1 | gap << 4 for a new frame). */
+static int      s_pt_ifg_flag[PT_MAX_SLOTS];
+static double   s_ifg_hz = 60.0;            /* the display's refresh */
+static uint64_t s_ifgp_last_ns = 0;
+static double   s_ifgp_period = 1.0 / 30.0; /* game frame, measured */
+void gl_renderer_set_image_interpolation_hz(double hz) {
+    if (hz > 20.0) s_ifg_hz = hz;
+    fprintf(stdout, "psxrecomp: image interpolation: display %.1f Hz\n", s_ifg_hz);
+}
