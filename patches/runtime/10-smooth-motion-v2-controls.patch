+/* ---- image interpolation ([video] image_interpolation) ---------------------
+ * Smooth motion from the finished pictures, as frame generation outside the
+ * game does it: a 30 Hz game shows each frame on two VBlanks, and the first
+ * of the two shows instead the picture halfway from the previous frame,
+ * moved along a motion field estimated between the two (block matching on
+ * the luminance at about a quarter of the window size, coarse to fine). The
+ * second VBlank shows the frame itself, so frames reach the screen one
+ * VBlank later than without it. Nothing is redrawn: geometry cannot tear;
+ * where the estimate is wrong the picture blurs. Runs on the render thread
+ * just before the swap of a real present (rth_replay_present arms it). */
+#define IFG_LW   480            /* motion estimation width (level 0) */
+#define IFG_BLK  8              /* level-0 px per motion vector */
+#define IFG_LV   3              /* pyramid levels */
+static int      s_ifg_on = 0;
+static int      s_ifg_armed = 0, s_ifg_flip = 0, s_ifg_gap = 0;
+static GLuint   s_ifg_img[2], s_ifg_img_fbo[2];
+static GLuint   s_ifg_lum[2][IFG_LV], s_ifg_lum_fbo[2][IFG_LV];
+static GLuint   s_ifg_flow[2], s_ifg_flow_fbo[2];
+static GLuint   s_ifg_vao, s_ifg_p_luma, s_ifg_p_flow, s_ifg_p_refine, s_ifg_p_warp, s_ifg_p_cut;
+static GLuint   s_ifg_cut, s_ifg_cut_fbo;   /* 1x1: 1 when the two frames are different shots */
+static int      s_ifg_ww, s_ifg_wh, s_ifg_lw[IFG_LV], s_ifg_lh[IFG_LV], s_ifg_gw, s_ifg_gh;
+static int      s_ifg_cur = 0, s_ifg_have_prev = 0, s_ifg_broken = 0;
+static uint64_t s_ifg_generated = 0, s_ifg_shown_real = 0;
+static double   s_ifg_ms = 0.0;
+static int      s_ifg_time = -1;
+
+void gl_renderer_set_image_interpolation(int on) { s_ifg_on = on ? 1 : 0; s_ifg_have_prev = 0; }
+
+static const char *IFG_VS =
+    "#version 330\n"
+    "out vec2 uv;\n"
+    "void main(){ vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);\n"
+    "  uv = p; gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0); }\n";
+/* Luminance, 2x2 taps of the source around this texel. */
+static const char *IFG_FS_LUMA =
+    "#version 330\n"
+    "uniform sampler2D src; uniform vec2 dtex; uniform int rgb;\n"
+    "in vec2 uv; out vec4 o;\n"
+    "float l(vec2 q){ vec4 c = texture(src, q);\n"
+    "  return rgb == 1 ? dot(c.rgb, vec3(0.299, 0.587, 0.114)) : c.r; }\n"
+    "void main(){ vec2 h = dtex * 0.25;\n"
+    "  o = vec4(0.25 * (l(uv + vec2(-h.x, -h.y)) + l(uv + vec2(h.x, -h.y)) +\n"
+    "                   l(uv + vec2(-h.x, h.y)) + l(uv + vec2(h.x, h.y)))); }\n";
+/* One motion vector per grid cell, in level-0 px: the displacement d with
+ * cur(p) ~ prv(p + d), searched around the coarser level's vector. The zero
+ * vector wins unless clearly worse (a still background stays still). */
+static const char *IFG_FS_FLOW =
+    "#version 330\n"
+    "uniform sampler2D cur, prv, init; uniform vec2 lsize, gsize;\n"
+    "uniform float scale; uniform int radius, useinit, blk;\n"
+    "in vec2 uv; out vec4 o;\n"
+    "float sad(vec2 c, vec2 d){ float s = 0.0;\n"
+    "  for (int y = -3; y <= 3; y++) for (int x = -3; x <= 3; x++) {\n"
+    "    vec2 q = c + vec2(x, y);\n"
+    "    s += abs(texture(cur, q / lsize).r - texture(prv, (q + d) / lsize).r); }\n"
+    "  return s; }\n"
+    "void main(){\n"
+    "  vec2 g = floor(uv * gsize);\n"
+    "  vec2 c = (g + 0.5) * float(blk) / scale;\n"
+    "  vec2 base = useinit == 1 ? floor(texture(init, (g + 0.5) / gsize).xy / scale + 0.5) : vec2(0.0);\n"
+    "  vec2 bd = vec2(0.0); float best = sad(c, bd) * 0.95 - 0.05;\n"
+    "  for (int y = -radius; y <= radius; y++) for (int x = -radius; x <= radius; x++) {\n"
+    "    vec2 d = base + vec2(x, y); float s = sad(c, d);\n"
+    "    if (s < best) { best = s; bd = d; } }\n"
+    "  o = vec4(bd * scale, best, 1.0); }\n";
+/* Each cell takes the best of its own and its 8 neighbours' vectors
+ * (removes isolated wrong vectors, keeps object edges). */
+static const char *IFG_FS_REFINE =
+    "#version 330\n"
+    "uniform sampler2D cur, prv, flow; uniform vec2 lsize, gsize; uniform int blk;\n"
+    "in vec2 uv; out vec4 o;\n"
+    "float sad(vec2 c, vec2 d){ float s = 0.0;\n"
+    "  for (int y = -4; y <= 4; y++) for (int x = -4; x <= 4; x++) {\n"
+    "    vec2 q = c + vec2(x, y);\n"
+    "    s += abs(texture(cur, q / lsize).r - texture(prv, (q + d) / lsize).r); }\n"
+    "  return s; }\n"
+    "void main(){\n"
+    "  vec2 g = floor(uv * gsize); vec2 c = (g + 0.5) * float(blk);\n"
+    "  vec2 bd = texture(flow, (g + 0.5) / gsize).xy; float best = sad(c, bd);\n"
+    "  for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {\n"
+    "    if (x == 0 && y == 0) continue;\n"
+    "    vec2 d = texture(flow, (g + vec2(x, y) + 0.5) / gsize).xy; float s = sad(c, d) + 0.02;\n"
+    "    if (s < best) { best = s; bd = d; } }\n"
+    "  o = vec4(bd, best, 1.0); }\n";
+/* The halfway picture: each pixel takes, among no motion and the vectors of
+ * its cell and the 8 around it, the one along which both frames agree best
+ * (at a character's edge the background's vector and the character's are
+ * both at hand, so neither drags the other along: no halo), and averages
+ * the two frames along it; where none agrees (something uncovered) the
+ * newer frame. */
+static const char *IFG_FS_WARP =
+    "#version 330\n"
+    "uniform sampler2D A, B, flow, cut; uniform vec2 lsize, gsize; uniform float t;\n"
+    "in vec2 uv; out vec4 o;\n"
+    "float cost(vec2 d, out vec3 a, out vec3 b){\n"
+    "  vec2 ha = d * t / lsize, hb = d * (1.0 - t) / lsize;\n"
+    "  a = texture(A, uv + ha).rgb; b = texture(B, uv - hb).rgb;\n"
+    "  vec2 e = vec2(1.5) / lsize;\n"
+    "  vec3 a2 = texture(A, uv + ha + vec2(e.x, 0.0)).rgb, b2 = texture(B, uv - hb + vec2(e.x, 0.0)).rgb;\n"
+    "  vec3 a3 = texture(A, uv + ha + vec2(0.0, e.y)).rgb, b3 = texture(B, uv - hb + vec2(0.0, e.y)).rgb;\n"
+    "  return length(a - b) + 0.5 * (length(a2 - b2) + length(a3 - b3)); }\n"
+    "void main(){\n"
+    "  vec3 near = t < 0.5 ? texture(A, uv).rgb : texture(B, uv).rgb;\n"
+    "  if (texture(cut, vec2(0.5)).r > 0.5) { o = vec4(near, 1.0); return; }\n"
+    "  vec2 g = floor(uv * gsize);\n"
+    "  vec3 a, b, ba, bb; float best = cost(vec2(0.0), ba, bb) - 0.01;\n"
+    "  for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {\n"
+    "    vec2 d = texture(flow, (g + vec2(x, y) + 0.5) / gsize).xy;\n"
+    "    float c = cost(d, a, b) + (x != 0 || y != 0 ? 0.005 : 0.0);\n"
+    "    if (c < best) { best = c; ba = a; bb = b; } }\n"
+    "  float k = smoothstep(0.15, 0.4, best);\n"
+    "  o = vec4(mix(mix(ba, bb, t), near, k), 1.0); }\n";
+
+/* A camera cut: most cells found no match (mean luminance difference over
+ * the refine window above 0.08 in more than half of them). The halfway
+ * picture of two different shots would be a cross-fade; the new shot is
+ * shown instead. */
+static const char *IFG_FS_CUT =
+    "#version 330\n"
+    "uniform sampler2D flow; uniform ivec2 gsize;\n"
+    "out vec4 o;\n"
+    "void main(){ int bad = 0;\n"
+    "  for (int y = 0; y < gsize.y; y++) for (int x = 0; x < gsize.x; x++)\n"
+    "    if (texelFetch(flow, ivec2(x, y), 0).z > 81.0 * 0.08) bad++;\n"
+    "  o = vec4(bad * 2 > gsize.x * gsize.y ? 1.0 : 0.0); }\n";
+
+static GLuint ifg_tex(GLenum internal, int w, int h, GLenum fmt, GLenum type, int linear) {
+    GLuint t = make_tex(internal, w, h, fmt, type);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, linear ? GL_LINEAR : GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, linear ? GL_LINEAR : GL_NEAREST);
+    return t;
+}
+static GLuint ifg_fbo(GLuint tex) {
+    GLuint f = 0;
+    p_glGenFramebuffers(1, &f);
+    p_glBindFramebuffer_raw(PSXGL_FRAMEBUFFER, f);
+    p_glFramebufferTexture2D(PSXGL_FRAMEBUFFER, PSXGL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+    return f;
+}
+static void ifg_free(void) {
+    for (int i = 0; i < 2; i++) {
+        if (s_ifg_img_fbo[i]) { p_glDeleteFramebuffers(1, &s_ifg_img_fbo[i]); glDeleteTextures(1, &s_ifg_img[i]); }
+        if (s_ifg_flow_fbo[i]) { p_glDeleteFramebuffers(1, &s_ifg_flow_fbo[i]); glDeleteTextures(1, &s_ifg_flow[i]); }
+        for (int l = 0; l < IFG_LV; l++)
+            if (s_ifg_lum_fbo[i][l]) { p_glDeleteFramebuffers(1, &s_ifg_lum_fbo[i][l]); glDeleteTextures(1, &s_ifg_lum[i][l]); }
+    }
+    memset(s_ifg_img, 0, sizeof s_ifg_img); memset(s_ifg_img_fbo, 0, sizeof s_ifg_img_fbo);
+    memset(s_ifg_flow, 0, sizeof s_ifg_flow); memset(s_ifg_flow_fbo, 0, sizeof s_ifg_flow_fbo);
+    memset(s_ifg_lum, 0, sizeof s_ifg_lum); memset(s_ifg_lum_fbo, 0, sizeof s_ifg_lum_fbo);
+    s_ifg_ww = s_ifg_wh = 0;
+    s_ifg_have_prev = 0;
+}
+static int ifg_ensure(int ww, int wh) {
+    if (s_ifg_broken) return 0;
+    if (!s_ifg_vao) {
+        p_glGenVertexArrays(1, &s_ifg_vao);
+        s_ifg_p_luma = build_program(IFG_VS, IFG_FS_LUMA);
+        s_ifg_p_flow = build_program(IFG_VS, IFG_FS_FLOW);
+        s_ifg_p_refine = build_program(IFG_VS, IFG_FS_REFINE);
+        s_ifg_p_warp = build_program(IFG_VS, IFG_FS_WARP);
+        s_ifg_p_cut = build_program(IFG_VS, IFG_FS_CUT);
+        s_ifg_cut = ifg_tex(0x822D /* R16F */, 1, 1, 0x1903 /* RED */, GL_FLOAT, 0);
+        s_ifg_cut_fbo = ifg_fbo(s_ifg_cut);
+        if (!s_ifg_vao || !s_ifg_p_luma || !s_ifg_p_flow || !s_ifg_p_refine || !s_ifg_p_warp ||
+            !s_ifg_p_cut) {
+            fprintf(stdout, "psxrecomp: image interpolation: shaders failed; off\n");
+            s_ifg_broken = 1;
+            return 0;
+        }
+    }
+    if (ww == s_ifg_ww && wh == s_ifg_wh) return 1;
+    ifg_free();
+    s_ifg_ww = ww; s_ifg_wh = wh;
+    s_ifg_lw[0] = IFG_LW; s_ifg_lh[0] = (IFG_LW * wh + ww / 2) / ww;
+    if (s_ifg_lh[0] < 16) s_ifg_lh[0] = 16;
+    for (int l = 1; l < IFG_LV; l++) {
+        s_ifg_lw[l] = (s_ifg_lw[l - 1] + 1) / 2;
+        s_ifg_lh[l] = (s_ifg_lh[l - 1] + 1) / 2;
+    }
+    s_ifg_gw = (s_ifg_lw[0] + IFG_BLK - 1) / IFG_BLK;
+    s_ifg_gh = (s_ifg_lh[0] + IFG_BLK - 1) / IFG_BLK;
+    for (int i = 0; i < 2; i++) {
+        s_ifg_img[i] = ifg_tex(GL_RGBA8, ww, wh, GL_RGBA, GL_UNSIGNED_BYTE, 1);
+        s_ifg_img_fbo[i] = ifg_fbo(s_ifg_img[i]);
+        for (int l = 0; l < IFG_LV; l++) {
+            s_ifg_lum[i][l] = ifg_tex(0x822D /* R16F */, s_ifg_lw[l], s_ifg_lh[l], 0x1903 /* RED */, GL_FLOAT, 1);
+            s_ifg_lum_fbo[i][l] = ifg_fbo(s_ifg_lum[i][l]);
+        }
+        s_ifg_flow[i] = ifg_tex(0x8230 /* RG32F */, s_ifg_gw, s_ifg_gh, 0x8227 /* RG */, GL_FLOAT, 0);
+        s_ifg_flow_fbo[i] = ifg_fbo(s_ifg_flow[i]);
+    }
