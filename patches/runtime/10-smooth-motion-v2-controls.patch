+}
+static void ifg_bind(int unit, GLuint tex) {
+    p_glActiveTexture(PSXGL_TEXTURE0 + unit);
+    glBindTexture(GL_TEXTURE_2D, tex);
+}
+static void ifg_pass(GLuint fbo, int w, int h) {
+    p_glBindFramebuffer_raw(PSXGL_FRAMEBUFFER, fbo);
+    glViewport(0, 0, w, h);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+}
+static void ifg_luma(int slot) {
+    p_glUseProgram(s_ifg_p_luma);
+    p_glUniform1i(p_glGetUniformLocation(s_ifg_p_luma, "src"), 0);
+    for (int l = 0; l < IFG_LV; l++) {
+        ifg_bind(0, l ? s_ifg_lum[slot][l - 1] : s_ifg_img[slot]);
+        p_glUniform1i(p_glGetUniformLocation(s_ifg_p_luma, "rgb"), l == 0);
+        p_glUniform2f(p_glGetUniformLocation(s_ifg_p_luma, "dtex"),
+                      1.0f / (float)s_ifg_lw[l], 1.0f / (float)s_ifg_lh[l]);
+        ifg_pass(s_ifg_lum_fbo[slot][l], s_ifg_lw[l], s_ifg_lh[l]);
+    }
+}
+/* Motion field into s_ifg_flow[0] (s_ifg_flow[1] is the scratch side). */
+static void ifg_motion(int cur, int prv) {
+    GLuint P = s_ifg_p_flow;
+    p_glUseProgram(P);
+    p_glUniform1i(p_glGetUniformLocation(P, "cur"), 0);
+    p_glUniform1i(p_glGetUniformLocation(P, "prv"), 1);
+    p_glUniform1i(p_glGetUniformLocation(P, "init"), 2);
+    p_glUniform2f(p_glGetUniformLocation(P, "gsize"), (float)s_ifg_gw, (float)s_ifg_gh);
+    p_glUniform1i(p_glGetUniformLocation(P, "blk"), IFG_BLK);
+    int out = 1;
+    for (int l = IFG_LV - 1; l >= 0; l--) {
+        ifg_bind(0, s_ifg_lum[cur][l]);
+        ifg_bind(1, s_ifg_lum[prv][l]);
+        ifg_bind(2, s_ifg_flow[out ^ 1]);
+        p_glUniform2f(p_glGetUniformLocation(P, "lsize"), (float)s_ifg_lw[l], (float)s_ifg_lh[l]);
+        p_glUniform1f(p_glGetUniformLocation(P, "scale"), (float)(1 << l));
+        p_glUniform1i(p_glGetUniformLocation(P, "radius"), l == IFG_LV - 1 ? 8 : 2);
+        p_glUniform1i(p_glGetUniformLocation(P, "useinit"), l != IFG_LV - 1);
+        ifg_pass(s_ifg_flow_fbo[out], s_ifg_gw, s_ifg_gh);
+        out ^= 1;
+    }
+    /* The last level wrote s_ifg_flow[out ^ 1]; refine into the other. */
+    const int src = out ^ 1;
+    P = s_ifg_p_refine;
+    p_glUseProgram(P);
+    p_glUniform1i(p_glGetUniformLocation(P, "cur"), 0);
+    p_glUniform1i(p_glGetUniformLocation(P, "prv"), 1);
+    p_glUniform1i(p_glGetUniformLocation(P, "flow"), 2);
+    p_glUniform2f(p_glGetUniformLocation(P, "lsize"), (float)s_ifg_lw[0], (float)s_ifg_lh[0]);
+    p_glUniform2f(p_glGetUniformLocation(P, "gsize"), (float)s_ifg_gw, (float)s_ifg_gh);
+    p_glUniform1i(p_glGetUniformLocation(P, "blk"), IFG_BLK);
+    ifg_bind(0, s_ifg_lum[cur][0]);
+    ifg_bind(1, s_ifg_lum[prv][0]);
+    ifg_bind(2, s_ifg_flow[src]);
+    ifg_pass(s_ifg_flow_fbo[src ^ 1], s_ifg_gw, s_ifg_gh);
+    if (src ^ 1) {   /* keep the result in s_ifg_flow[0] for the warp */
+        p_glBindFramebuffer_raw(PSXGL_READ_FRAMEBUFFER, s_ifg_flow_fbo[1]);
+        p_glBindFramebuffer_raw(PSXGL_DRAW_FRAMEBUFFER, s_ifg_flow_fbo[0]);
+        p_glBlitFramebuffer(0, 0, s_ifg_gw, s_ifg_gh, 0, 0, s_ifg_gw, s_ifg_gh, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    }
+}
+
+/* The motion field and the shot-cut test for frames cur (newer) and prv. */
+static void ifg_estimate(int cur, int prv) {
+    ifg_motion(cur, prv);
+    p_glUseProgram(s_ifg_p_cut);
+    p_glUniform1i(p_glGetUniformLocation(s_ifg_p_cut, "flow"), 0);
+    p_glUniform2i(p_glGetUniformLocation(s_ifg_p_cut, "gsize"), s_ifg_gw, s_ifg_gh);
+    ifg_bind(0, s_ifg_flow[0]);
+    ifg_pass(s_ifg_cut_fbo, 1, 1);
+}
+/* The picture at phase t (0 = prv, 1 = cur) into the bound draw framebuffer. */
+static void ifg_warp(int prv, int cur, float t, int ww, int wh) {
+    GLuint P = s_ifg_p_warp;
+    p_glUseProgram(P);
+    p_glUniform1i(p_glGetUniformLocation(P, "A"), 0);
+    p_glUniform1i(p_glGetUniformLocation(P, "B"), 1);
+    p_glUniform1i(p_glGetUniformLocation(P, "flow"), 2);
+    p_glUniform1i(p_glGetUniformLocation(P, "cut"), 3);
+    p_glUniform1f(p_glGetUniformLocation(P, "t"), t);
+    p_glUniform2f(p_glGetUniformLocation(P, "lsize"), (float)s_ifg_lw[0], (float)s_ifg_lh[0]);
+    p_glUniform2f(p_glGetUniformLocation(P, "gsize"), (float)s_ifg_gw, (float)s_ifg_gh);
+    ifg_bind(0, s_ifg_img[prv]);
+    ifg_bind(1, s_ifg_img[cur]);
+    ifg_bind(2, s_ifg_flow[0]);
+    ifg_bind(3, s_ifg_cut);
+    glViewport(0, 0, ww, wh);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+}
+static void ifg_draw_state(void) {
+    glDisable(GL_BLEND); glDisable(GL_SCISSOR_TEST); glDisable(GL_DEPTH_TEST);
+    glDisable(GL_STENCIL_TEST); glDisable(GL_CULL_FACE);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    p_glBindVertexArray(s_ifg_vao);
+}
