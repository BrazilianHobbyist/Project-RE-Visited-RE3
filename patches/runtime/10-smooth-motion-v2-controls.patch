+        for (uint32_t j = 0; bad && j < newer->n; j++) {
+            const FgPrim *pr = &newer->v[j];
+            const FgVert *tv = &verts[3 * j];
+            if (tv[0].mode != FG_PLACE_OBJECT && tv[1].mode != FG_PLACE_OBJECT &&
+                tv[2].mode != FG_PLACE_OBJECT) continue;
+            int torn[3] = { 0, 0, 0 };
+            for (int e = 0; e < 3; e++) {
+                const int i0 = e, i1 = (e + 1) % 3;
+                if (tv[i0].mode != FG_PLACE_OBJECT && tv[i1].mode != FG_PLACE_OBJECT) continue;
+                if (!pr->vid[i0] || !pr->vid[i1]) continue;
+                /* Older corner: its pair for an object vertex, the newer
+                 * position otherwise (a world corner barely moves). */
+                const float *a0 = tv[i0].mode == FG_PLACE_OBJECT ? tv[i0].a : pr->p[i0];
+                const float *a1 = tv[i1].mode == FG_PLACE_OBJECT ? tv[i1].a : pr->p[i1];
+                const float la = dist3(a0, a1), lb = dist3(pr->p[i0], pr->p[i1]);
+                const float slack = 0.02f * fabsf(pr->p[i0][2]) + 4.0f;
+                if (fabsf(la - lb) > 0.5f * lb + slack) {
+                    torn[i0] |= tv[i0].mode == FG_PLACE_OBJECT;
+                    torn[i1] |= tv[i1].mode == FG_PLACE_OBJECT;
+                }
+            }
+            for (int k = 0; k < 3; k++)
