+        }
+        if (nbad) {
+            qsort(bad, nbad, sizeof *bad, src_cmp);
+            for (uint32_t j = 0; j < newer->n; j++)
+                for (int k = 0; k < 3; k++) {
+                    FgVert *fv = &verts[3 * j + k];
+                    if (fv->mode != FG_PLACE_OBJECT) continue;
+                    Src key; key.id = newer->v[j].vid[k]; memcpy(key.p, newer->v[j].p[k], sizeof key.p);
+                    if (bsearch(&key, bad, nbad, sizeof *bad, src_cmp)) { fv->mode = FG_PLACE_CAMERA; fit->torn++; }
+                }
+        }
+        free(bad);
+    }
     /* An unpaired vertex of a moving object (a camera-attached sky dome
      * whose vertex was culled last frame) moves with the object, not with
      * the world. */
@@ -617,6 +662,51 @@ void fg_cam_place(const FgPrimList *newer, FgCamFit *fit, const FgVert *verts,
         }
         free(tab); free(slot);
     }
+    /* Tears: a triangle whose edge the placement stretched far past its
+     * length in the real frame got a wrong motion on some corner (a pair with
+     * another instance of its mesh, a stale source). Every vertex at such a
+     * triangle's screen positions stays where the real frame drew it, so the
+     * triangle and its neighbours keep the real frame's shape. Two passes:
+     * a corner pinned by the first can stretch a neighbour. */
+    {
