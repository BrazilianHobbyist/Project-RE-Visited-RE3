+/* Present once ([video] present_once): a game frame shown on several VBlanks
+ * (a 30 Hz game's second one) is presented once, so the window shows only
+ * new images at the game's own steady rate and frame generation outside the
+ * game (the driver's, Lossless Scaling) interpolates between real frames. A
+ * frame is new when the display origin moved (a double-buffered flip); a
+ * display that has not flipped for 4 VBlanks (menus drawn in place, a
+ * single buffer) presents every VBlank again. */
+static int      s_present_once = 0;
+static int      s_po_have = 0, s_po_dx = 0, s_po_dy = 0, s_po_still = 0;
+static uint64_t s_po_skipped = 0;
+void gl_renderer_set_present_once(int on) { s_present_once = on ? 1 : 0; s_po_have = 0; }
+static int s_po_vb = 0;   /* VBlanks since the last flip */
+/* 1 when this present shows a new game frame (the display origin moved). */
+static int po_flip(const uint8_t *p) {
+    RthOvHdr hd;
+    memcpy(&hd, p, sizeof hd);
+    const int dx = hd.args[0], dy = hd.args[1];
+    const int flip = !s_po_have || dx != s_po_dx || dy != s_po_dy;
+    s_po_have = 1; s_po_dx = dx; s_po_dy = dy;
+    s_po_vb++;
