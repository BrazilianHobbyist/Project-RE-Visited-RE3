diff --git a/recompiler/tests/reachable_discovery_test.cpp b/recompiler/tests/reachable_discovery_test.cpp
index 3dfe2aa7..61a9dad8 100644
--- a/recompiler/tests/reachable_discovery_test.cpp
+++ b/recompiler/tests/reachable_discovery_test.cpp
@@ -187,10 +187,62 @@ void check_scheduled_switch() {
     }
 }
 
+// sltiu; beq; X; lui; addiu; sll: one unrelated instruction fills the bounds
+// branch's delay slot and the table constant follows it (RE3 enemy modules).
+ApeSwitchFixture make_hoisted_delay_switch() {
+    auto f = make_ape_switch();
+    const size_t text = 2048;
+    put32(f.image, text + 0x500, 0);
+    put32(f.image, text + 0x504, 0x2C620003u); // sltiu v0,v1,3
+    put32(f.image, text + 0x508, 0x1040001Du); // beq v0,zero,+0x580
+    put32(f.image, text + 0x50C, 0x00C0A021u); // addu s4,a2,zero (delay)
+    put32(f.image, text + 0x510, 0x3C028001u); // lui v0,0x8001
+    put32(f.image, text + 0x514, 0x24420A00u); // addiu v0,v0,0xa00
+    put32(f.image, text + 0x518, 0x00031880u); // sll v1,v1,2
+    put32(f.image, text + 0x51C, 0x00621821u); // addu v1,v1,v0
+    put32(f.image, text + 0x520, 0x8C620000u); // lw v0,0(v1)
+    return f;
+}
+
+void check_hoisted_delay_switch() {
+    const size_t text = 2048;
+    auto f = make_hoisted_delay_switch();
+    auto exe = parse(f.image);
+    PSXRecomp::ExactJumpTable table;
+    CHECK(PSXRecomp::resolve_exact_bounded_jump_table(
+              exe, f.entry, kLoad + 0x600u, f.jr_pc, 2u, table) &&
+          table.table_base == f.table && table.table_count == 3u,
+          "hoisted-delay table constant resolves exactly");
+    std::set<uint32_t> targets;
+    for (auto target : table.targets) targets.insert(target.second);
+    CHECK(targets == std::set<uint32_t>(f.cases.begin(), f.cases.end()),
+          "hoisted-delay table has exactly the expected case targets");
+    PSXRecomp::FunctionAnalyzer analyzer(exe);
+    auto result = analyzer.analyze_exact_entries({f.entry});
+    for (auto target : f.cases)
+        CHECK(result.exact_reachable_pcs.count(target),
+              "hoisted-delay switch cases are reached from the function root");
+    const std::vector<std::pair<size_t, uint32_t>> mutations = {
+        {0x50C, 0x00C01821u}, // delay slot writes the index (v1)
+        {0x50C, 0x00C01021u}, // delay slot writes the table register (v0)
+        {0x50C, 0x10000004u}, // delay slot is a branch
+        {0x50C, 0x0C000000u}, // delay slot is a call
+        {0x504, 0x2C630003u}, // bound writes the index
+        {0x508, 0x5040001Du}, // BEQL
+    };
+    for (const auto& change : mutations) {
+        auto broken = f;
+        put32(broken.image, text + change.first, change.second);
+        CHECK(!resolves_ape_switch(broken, broken.entry),
+              "unsafe hoisted-delay mutation fails closed");
+    }
+}
+
 } // namespace
 
 int main() {
     check_scheduled_switch();
+    check_hoisted_delay_switch();
     auto image = make_exe_buffer(0x2000);
     const size_t text = 2048;
 
