+#if defined(PSX_RE3_DISC_MEMO)
+/* RE3: offline disc digest memo. offline_disc_digest() never caches on
+ * Windows because host_file_identity() refuses NTFS timestamps (immediate
+ * same-size rewrites with a restored mtime can collide). For a player's own
+ * disc image that risk is accepted: the memo is keyed by path, size and
+ * mtime, and a miss or any change simply rehashes. Netplay never uses it. */
+static bool re3_offline_disc_digest(const std::filesystem::path& disc_path,
+                                    std::string& out, std::string* error) {
+    out.clear();
+    if (disc_path.empty()) return true;
+    std::filesystem::path memo = media_cache_root().parent_path() / "disc_sha256_memo.txt";
+    std::string key;
+    {
+        const DiscPathResolution resolved = resolve_disc_path(disc_path);
+        std::error_code ec;
+        const std::filesystem::path abs = std::filesystem::absolute(resolved.data, ec);
+        uintmax_t size = 0;
+        std::filesystem::file_time_type mtime{};
+        if (!ec) size = std::filesystem::file_size(abs, ec);
+        if (!ec) mtime = std::filesystem::last_write_time(abs, ec);
+        if (!ec) {
+            std::ostringstream k;
+            k << size << ' ' << (long long)mtime.time_since_epoch().count() << ' ' << abs.string();
+            key = k.str();
+        }
+    }
+    std::vector<std::string> kept;
+    if (!key.empty()) {
+        std::ifstream in(memo);
+        std::string line;
+        while (std::getline(in, line)) {
+            const size_t tab = line.rfind('\t');
+            if (tab == std::string::npos) continue;
+            if (line.compare(0, tab, key) == 0 && line.size() - tab - 1 == 64) {
+                out = line.substr(tab + 1);
+                return true;
+            }
+            kept.push_back(line);
+        }
+    }
+    if (!measured_disc_digest(disc_path, out, error)) return false;
+    if (!key.empty() && out.size() == 64) {
+        std::error_code ec;
+        std::filesystem::create_directories(memo.parent_path(), ec);
+        std::ofstream o(memo, std::ios::trunc);
+        for (const std::string& l : kept) o << l << '\n';
+        o << key << '\t' << out << '\n';
+    }
+    return true;
+}
+#endif
