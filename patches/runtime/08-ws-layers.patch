+        y0 = sign_extend((gp0_cmd_buf[1] >> 16) & 0x7FFu, 11) + draw_offset_y;
+        x1 = x0 + w; y1 = y0 + h;
+    } else {
+        const int n = (op & 0x08u) ? 4 : 3, tex = (op & 0x04u) != 0, gour = (op & 0x10u) != 0;
+        int i = 1;
+        for (int k = 0; k < n; k++) {
+            if (k && gour) i++;
+            const int x = sign_extend(gp0_cmd_buf[i] & 0x7FFu, 11) + draw_offset_x;
+            const int y = sign_extend((gp0_cmd_buf[i] >> 16) & 0x7FFu, 11) + draw_offset_y;
+            if (x < x0) x0 = x;
+            if (x > x1) x1 = x;
+            if (y < y0) y0 = y;
+            if (y > y1) y1 = y;
+            i += tex ? 2 : 1;
+        }
+    }
+    const int ax0 = (int)draw_area_left, ay0 = (int)draw_area_top;
+    const int ax1 = (int)draw_area_right + 1, ay1 = (int)draw_area_bottom + 1;
+    if (x0 < ax0) x0 = ax0;
+    if (y0 < ay0) y0 = ay0;
+    if (x1 > ax1) x1 = ax1;
+    if (y1 > ay1) y1 = ay1;
+    const int w = x1 - x0, h = y1 - y0, aw = ax1 - ax0, ah = ay1 - ay0;
+    if (w <= 0 || h <= 0 || aw <= 0 || ah <= 0) return;
+    const int full_w = w * 10 >= aw * 9, full_h = h * 10 >= ah * 9;
+    if (semi && full_w && full_h) ly_resnap = 1;
+    else if ((full_w && h >= 8) || w * h * 2 >= aw * ah) ly_complex = 1;
+}
