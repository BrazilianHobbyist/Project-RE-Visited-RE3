+/* 16:9 Zoomed pan focus (gpu.c g_ws_layers_focus): Jill's feet and head
+ * projected with the game's own view (0x80098990: 3x3 int16 rotation in 4.12,
+ * int32 translation) and the GTE projection (H = ctrl 26, OFY = ctrl 25 in
+ * 16.16). The box of all opaque models also takes the typewriter, item box
+ * and enemies, and in the top-down save room it centred the floor and cut
+ * Jill off at the top (maintainer report, 2026-10-28). */
+extern "C" int (*g_ws_layers_focus)(int area_h, int *y0, int *y1);
+static int re3_ws_focus(int area_h, int *y0, int *y1) {
+    extern CPUState *debug_cpu_ptr;
+    if (!g_psx_ram || !debug_cpu_ptr || !fntrace_is_game_started()) return 0;
+    const uint8_t *pl = g_psx_ram + 0x000CCBC4;
+    if (pl[0x04] != 1) return 0;                        /* Jill not in play */
+    const int16_t *R = (const int16_t *)(g_psx_ram + 0x00098990);
+    const int32_t *T = (const int32_t *)(g_psx_ram + 0x00098990 + 0x14);
+    const double H = (double)(debug_cpu_ptr->gte_ctrl[26] & 0xFFFFu);
+    const double ofy = (double)(int32_t)debug_cpu_ptr->gte_ctrl[25] / 65536.0;
+    if (H <= 0.0) return 0;
+    const double px = *(const int32_t *)(pl + 0x34), py = *(const int32_t *)(pl + 0x38),
+                 pz = *(const int32_t *)(pl + 0x3C);
+    double sy[2];
+    const double ys[2] = { py, py - 2800.0 };            /* feet, top of head (Y grows down; 2800 measured live, 2026-10-28) */
+    for (int k = 0; k < 2; k++) {
+        const double cy = (R[3] * px + R[4] * ys[k] + R[5] * pz) / 4096.0 + T[1];
+        const double cz = (R[6] * px + R[7] * ys[k] + R[8] * pz) / 4096.0 + T[2];
+        if (cz < 64.0) return 0;
+        sy[k] = ofy + H * cy / cz;
+    }
+    int a = (int)std::floor(std::min(sy[0], sy[1])), b = (int)std::ceil(std::max(sy[0], sy[1]));
+    if (b < 0 || a > area_h || b - a < 4) return 0;      /* off screen or implausible */
+    *y0 = a; *y1 = b;
+    return 1;
+}
