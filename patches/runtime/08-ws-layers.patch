+/* ---- Layered pan & scan (RE3, [video] ws_layers) ---------------------------
+ * gpu.c copies the draw area when the scene ordering table ends
+ * (gl_renderer_ws_layer_snapshot), so each back buffer can carry a copy of its
+ * scene without the UI. The present then composes a 16:9 image at the internal
+ * scale: the copy zoomed to fill the width and panned vertically to keep the
+ * models in view, and over it, inside the centred 4:3 rect, every pixel where
+ * the final image differs from the copy (the UI) at 1:1. A buffer last drawn
+ * as a full 2D screen has no copy and presents 4:3 pillarboxed. Only the plain
+ * VRAM present path composes (no render thread, high-resolution window or
+ * temporal blending); the others pillarbox. */
+typedef struct {
+    int    used, valid, x, y, w, h, scale;
+    int    fy0, fy1;
+    uint32_t hash;
+    GLuint tex, fbo;
+    int    tw, th;
+} LySlot;
+static LySlot   s_ly[2];
+static int      s_ly_on = -1;
+static GLuint   s_ly_comp_tex = 0, s_ly_comp_fbo = 0;
+static int      s_ly_comp_w = 0, s_ly_comp_h = 0;
+static GLuint   s_ly_prog = 0;
+static GLint    s_ly_uMode = -1, s_ly_uSnap = -1, s_ly_uFinal = -1, s_ly_uSrcRect = -1,
+                s_ly_uFinalOrg = -1, s_ly_uUiOrg = -1;
+static float    s_ly_pan = -1.0f;
+static uint32_t s_ly_pan_hash = 0;
+static uint64_t s_ly_snaps = 0, s_ly_invalidations = 0, s_ly_composed = 0, s_ly_pillar = 0;
+/* Why a present did not compose (ws_layers stats): no copy for the band,
+ * copy invalid, size or scale mismatch, rect not wider than 4:3. */
+static uint64_t s_ly_why[5];
+static int s_ly_last_disp[4], s_ly_last_slot[4];
+
+void gl_renderer_set_ws_layers(int on) { s_ly_on = on ? 1 : 0; }
+int gl_renderer_ws_layers_enabled(void) {
+    if (s_ly_on < 0) {
+        const char *e = getenv("PSX_WS_LAYERS");
+        s_ly_on = (e && e[0] == '1') ? 1 : 0;
+    }
+    return s_ly_on && !s_rth_on && !s_hiw && s_ctx && s_raster_ok;
+}
+
+static LySlot *ly_find(int x, int y) {
+    for (int i = 0; i < 2; i++)
+        if (s_ly[i].used && s_ly[i].x == x && s_ly[i].y == y) return &s_ly[i];
+    return NULL;
+}
+
+void gl_renderer_ws_layer_invalidate(int x, int y) {
+    LySlot *s = ly_find(x, y);
+    if (s && s->valid) { s->valid = 0; s_ly_invalidations++; }
+}
+
+void gl_renderer_ws_layer_snapshot(int x, int y, int w, int h,
+                                   int focus_y0, int focus_y1, uint32_t bg_hash) {
+    if (!gl_renderer_ws_layers_enabled()) return;
+    if (x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > VRAM_W || y + h > VRAM_H) return;
+    LySlot *s = ly_find(x, y);
+    if (!s) {   /* a new buffer band: take the slot not written last */
+        static int next = 0;
+        s = &s_ly[next];
+        next ^= 1;
+        s->used = 1; s->x = x; s->y = y; s->valid = 0;
+    }
+    flush_flat_batch();
+    flush_tex_batch();
+    flush_cpu_upload();
+    const int R = s_hr_scale;
+    if (!s->tex || s->tw != w * R || s->th != h * R) {
+        if (!s->tex) { glGenTextures(1, &s->tex); p_glGenFramebuffers(1, &s->fbo); }
+        p_glActiveTexture(PSXGL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, s->tex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w * R, h * R, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        p_glBindFramebuffer(PSXGL_FRAMEBUFFER, s->fbo);
+        p_glFramebufferTexture2D(PSXGL_FRAMEBUFFER, PSXGL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, s->tex, 0);
+        p_glBindFramebuffer(PSXGL_FRAMEBUFFER, 0);
+        s->tw = w * R; s->th = h * R;
+    }
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, s_hr_fbo);
+    p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, s->fbo);
+    glDisable(GL_SCISSOR_TEST);
+    p_glBlitFramebuffer(x * R, y * R, (x + w) * R, (y + h) * R, 0, 0, w * R, h * R,
+                        GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, 0);
+    p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, 0);
+    s->valid = 1; s->w = w; s->h = h; s->scale = R;
+    s->fy0 = focus_y0; s->fy1 = focus_y1; s->hash = bg_hash;
+    s_ly_snaps++;
+}
+
+static const char *LY_FS =
+    "#version 330\n"
+    "out vec4 o;\n"
+    "uniform int u_mode;\n"              /* 0 = zoomed scene, 1 = UI at 1:1 */
+    "uniform sampler2D u_snap;\n"
+    "uniform sampler2D u_final;\n"
+    "uniform vec4 u_src;\n"              /* scene: x0, y0, x scale, y scale (snap px per comp px) */
+    "uniform ivec2 u_final_org;\n"       /* display origin in the hr surface */
+    "uniform ivec2 u_ui_org;\n"          /* UI rect origin in the composite */
+    "void main(){\n"
+    "  if (u_mode == 0) {\n"
+    "    vec2 p = u_src.xy + gl_FragCoord.xy * u_src.zw;\n"
+    "    o = vec4(texture(u_snap, p / vec2(textureSize(u_snap, 0))).rgb, 1.0);\n"
+    "  } else {\n"
+    "    ivec2 l = ivec2(gl_FragCoord.xy) - u_ui_org;\n"
+    "    vec4 f = texelFetch(u_final, u_final_org + l, 0);\n"
+    "    vec4 s = texelFetch(u_snap, l, 0);\n"
+    "    if (all(lessThan(abs(f.rgb - s.rgb), vec3(0.5 / 255.0)))) discard;\n"
+    "    o = vec4(f.rgb, 1.0);\n"
+    "  }\n"
+    "}\n";
+
+static const char *LY_VS =
