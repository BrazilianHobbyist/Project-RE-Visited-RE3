+/* ---- Layered pan & scan (RE3, [video] ws_layers) -------------------------
+ * The game sorts each frame into a scene ordering table (ranks >= 16:
+ * pre-rendered background sprites, models, shadows) and then a separate UI
+ * list (ranks 0-15: text, prompts, darkening). Full 2D screens (inventory,
+ * map, files, menus) only have UI lists. When the scene list ends, the draw
+ * area holds the scene alone: the renderer copies it, and the present zooms
+ * that copy to fill 16:9 and lays the UI over it at 1:1 (the pixels where the
+ * final image differs from the copy). A frame without a scene list leaves no
+ * copy for its buffer and presents 4:3 pillarboxed. */
+extern void gl_renderer_ws_layer_snapshot(int x, int y, int w, int h,
+                                          int focus_y0, int focus_y1, uint32_t bg_hash);
+extern void gl_renderer_ws_layer_invalidate(int x, int y);
+extern int  gl_renderer_ws_layers_enabled(void);
+static int      ly_list_prims = 0, ly_list_scene = 0, ly_after_scene = 0, ly_resnap = 0, ly_complex = 0;
+static uint32_t ly_scene_frame = 0xFFFFFFFFu, ly_bg_hash = 0;
+static int      ly_y0 = 0x7FFF, ly_y1 = -0x7FFF;
+/* Optional title hook: the lines (relative to the draw area) the pan should
+ * keep in view, e.g. the player projected with the game's camera. Returns 0
+ * to fall back to the box of all opaque scene polygons. */
+int (*g_ws_layers_focus)(int area_h, int *y0, int *y1) = NULL;
+static void ly_snapshot(void) {
+    const int w = (int)draw_area_right - (int)draw_area_left + 1;
+    const int h = (int)draw_area_bottom - (int)draw_area_top + 1;
+    if (w <= 0 || h <= 0) return;
+    int f0 = ly_y0 <= ly_y1 ? ly_y0 : -32768, f1 = ly_y1;   /* -32768: no focus */
+    int p0, p1;
+    if (g_ws_layers_focus && g_ws_layers_focus(h, &p0, &p1)) { f0 = p0; f1 = p1; }
+    gl_renderer_ws_layer_snapshot((int)draw_area_left, (int)draw_area_top, w, h, f0, f1, ly_bg_hash);
+}
+static void ly_list_end(void) {
+    if (gr_backend() != GR_BACKEND_OPENGL || !gl_renderer_ws_layers_enabled()) return;
+    if (ly_resnap) { ly_resnap = 0; ly_snapshot(); }
+    if (ly_list_scene) {            /* the scene list just ended: copy it */
+        ly_snapshot();
+        ly_after_scene = 1;
+        ly_scene_frame = (uint32_t)s_frame_count;
+    } else if (ly_complex) {
+        /* Cinema bars, a screen-copy effect or another large UI layer (LIVE
+         * SELECTION, death): the layered model cannot place it; this frame
+         * presents 4:3. */
+        gl_renderer_ws_layer_invalidate((int)draw_area_left, (int)draw_area_top);
+        ly_after_scene = 0;
+    } else if (ly_list_prims && (uint32_t)s_frame_count != ly_scene_frame) {
+        /* A UI-only list in a frame without a scene: a 2D screen. */
+        gl_renderer_ws_layer_invalidate((int)draw_area_left, (int)draw_area_top);
+        ly_after_scene = 0;
+    }
+    ly_list_prims = ly_list_scene = ly_complex = 0;
+}
+static void ly_note_command(uint8_t op) {
+    if (gr_backend() != GR_BACKEND_OPENGL || !gl_renderer_ws_layers_enabled()) return;
+    if (op < 0x20 || op > 0x7F || gp0_ot_rank == 0xFFFFu) return;
+    if (ly_resnap) { ly_resnap = 0; ly_snapshot(); }   /* after a full-screen darkening */
+    ly_list_prims++;
+    const int semi = (op & 0x02u) != 0;
+    if (gp0_ot_rank >= 16u) {
+        if (!ly_list_scene) {
+            ly_list_scene = 1;
+            ly_y0 = 0x7FFF; ly_y1 = -0x7FFF; ly_bg_hash = 2166136261u;
+        }
+        if (op >= 0x60) {           /* background sprites: the camera's signature */
+            ly_bg_hash = (ly_bg_hash ^ (gp0_cmd_buf[2] & 0xFFFFFFu)) * 16777619u;
+        } else if (op < 0x40 && !semi) {   /* opaque polygons: models (shadows are semi) */
+            const int n = (op & 0x08u) ? 4 : 3, tex = (op & 0x04u) != 0, gour = (op & 0x10u) != 0;
+            int i = 1;
+            for (int k = 0; k < n; k++) {
+                if (k && gour) i++;
