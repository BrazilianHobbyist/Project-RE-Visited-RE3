+        }
+        return;
+    }
+    /* UI after the scene. Measure the primitive against the draw area:
+     *  - semi-transparent over (nearly) the whole area (pause darkening, a
+     *    white flash): re-copy after it, so the effect zooms with the scene
+     *    and only what is drawn later (text) stays 1:1;
+     *  - full width and at least 8 lines tall (cinema bars), or over half the
+     *    area (a screen-copy effect): this frame cannot be layered. */
+    if (!ly_after_scene || op >= 0x40 && op < 0x60) return;
