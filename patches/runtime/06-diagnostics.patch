+/* frame_history_dump start=<f0> end=<f1> [out=path]: write the frame-history
+ * records in [f0,f1] to a CSV (one row per frame still in the ring): pad
+ * buttons, the title's game_data and the four snapshot regions, all as hex.
+ * Large ranges must not ride TCP, hence the file (like ws_census). */
+static void handle_frame_history_dump(int id, const char *json)
+{
+    if (!s_frame_history) { send_err(id, "ring buffer not allocated"); return; }
+    int f0 = json_get_int(json, "start", -1);
+    int f1 = json_get_int(json, "end", -1);
+    if (f0 < 0 || f1 < f0) { send_err(id, "missing or bad start/end"); return; }
+    char path[512];
+    if (!json_get_str(json, "out", path, sizeof(path)))
+        snprintf(path, sizeof(path), "psx_frame_history.csv");
+    FILE *fp = fopen(path, "w");
+    if (!fp) { send_err(id, "cannot open file"); return; }
+    fprintf(fp, "frame,pad_buttons,game_data");
+    for (int i = 0; i < RAM_SNAPSHOT_REGIONS; i++) fprintf(fp, ",snap%d_addr,snap%d", i, i);
+    fputc('\n', fp);
+    static const char H[] = "0123456789abcdef";
+    uint64_t oldest = (s_history_count > FRAME_HISTORY_CAP)
+                    ? s_history_count - FRAME_HISTORY_CAP : 0;
+    int rows = 0;
+    for (uint64_t f = (uint64_t)f0; f <= (uint64_t)f1 && f < s_history_count; f++) {
+        if (f < oldest) continue;
+        const PSXFrameRecord *r = &s_frame_history[(uint32_t)(f % FRAME_HISTORY_CAP)];
+        if (r->frame_number != (uint32_t)f) continue;
+        fprintf(fp, "%u,0x%04X,", r->frame_number, r->pad_buttons);
+        for (size_t j = 0; j < sizeof(r->game_data); j++) {
+            fputc(H[r->game_data[j] >> 4], fp);
+            fputc(H[r->game_data[j] & 15], fp);
+        }
+        for (int i = 0; i < RAM_SNAPSHOT_REGIONS; i++) {
+            fprintf(fp, ",0x%08X,", r->snapshot_addr[i]);
+            for (int j = 0; j < RAM_SNAPSHOT_SIZE; j++) {
+                fputc(H[r->snapshot_data[i][j] >> 4], fp);
+                fputc(H[r->snapshot_data[i][j] & 15], fp);
+            }
+        }
+        fputc('\n', fp);
+        rows++;
+    }
+    fclose(fp);
+    send_fmt("{\"id\":%d,\"ok\":true,\"rows\":%d,\"oldest\":%llu,\"newest\":%llu}",
+             id, rows, (unsigned long long)oldest,
+             (unsigned long long)(s_history_count ? s_history_count - 1 : 0));
+}
